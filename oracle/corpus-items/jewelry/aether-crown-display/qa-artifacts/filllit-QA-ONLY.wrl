ROUTE RotateTouch.touchTime TO CrownClock.set_startTime
ROUTE StopTouch.touchTime TO CrownClock.set_stopTime
ROUTE CrownClock.fraction_changed TO CrownSpin.set_fraction
ROUTE CrownSpin.value_changed TO CrownTurn.set_rotation
ROUTE LumeTouch.touchTime TO LumeClock.set_startTime
ROUTE LumeTouch.touchTime TO DimClock.set_stopTime
ROUTE DimTouch.touchTime TO DimClock.set_startTime
ROUTE DimTouch.touchTime TO LumeClock.set_stopTime
ROUTE LumeClock.fraction_changed TO CyanUp.set_fraction
ROUTE CyanUp.value_changed TO MCyan.set_emissiveColor
ROUTE DimClock.fraction_changed TO CyanDn.set_fraction
ROUTE CyanDn.value_changed TO MCyan.set_emissiveColor
ROUTE LumeClock.fraction_changed TO SapphireUp.set_fraction
ROUTE SapphireUp.value_changed TO MSapphire.set_emissiveColor
ROUTE DimClock.fraction_changed TO SapphireDn.set_fraction
ROUTE SapphireDn.value_changed TO MSapphire.set_emissiveColor
ROUTE LumeClock.fraction_changed TO VioletUp.set_fraction
ROUTE VioletUp.value_changed TO MViolet.set_emissiveColor
ROUTE DimClock.fraction_changed TO VioletDn.set_fraction
ROUTE VioletDn.value_changed TO MViolet.set_emissiveColor
