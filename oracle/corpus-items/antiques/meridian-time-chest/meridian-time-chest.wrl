DEF OpenAClock TimeSensor { cycleInterval 0.8 loop FALSE }
DEF ShutAClock TimeSensor { cycleInterval 0.8 loop FALSE }
DEF OpenAPos PositionInterpolator { key [ 0 0.5 1 ] keyValue [ 0 0 0, 0 0 0.1364, 0 0 0.22 ] }
DEF ShutAPos PositionInterpolator { key [ 0 0.5 1 ] keyValue [ 0 0 0.22, 0 0 0.0836, 0 0 0 ] }
DEF OpenBClock TimeSensor { cycleInterval 0.8 loop FALSE }
DEF ShutBClock TimeSensor { cycleInterval 0.8 loop FALSE }
DEF OpenBPos PositionInterpolator { key [ 0 0.5 1 ] keyValue [ 0 0 0, 0 0 0.2232, 0 0 0.36 ] }
DEF ShutBPos PositionInterpolator { key [ 0 0.5 1 ] keyValue [ 0 0 0.36, 0 0 0.1368, 0 0 0 ] }
DEF OpenCClock TimeSensor { cycleInterval 0.8 loop FALSE }
DEF ShutCClock TimeSensor { cycleInterval 0.8 loop FALSE }
DEF OpenCPos PositionInterpolator { key [ 0 0.5 1 ] keyValue [ 0 0 0, 0 0 0.2046, 0 0 0.33 ] }
DEF ShutCPos PositionInterpolator { key [ 0 0.5 1 ] keyValue [ 0 0 0.33, 0 0 0.1254, 0 0 0 ] }
DEF RaiseClock TimeSensor { cycleInterval 1 loop FALSE }
DEF LowerClock TimeSensor { cycleInterval 1 loop FALSE }
DEF RaiseOri OrientationInterpolator { key [ 0 0.5 1 ] keyValue [ 1 0 0 1.5708, 1 0 0 0.6597, 1 0 0 0 ] }
DEF LowerOri OrientationInterpolator { key [ 0 0.5 1 ] keyValue [ 1 0 0 0, 1 0 0 0.9111, 1 0 0 1.5708 ] }

ROUTE OpenATouch.touchTime TO OpenAClock.set_startTime
ROUTE OpenAClock.fraction_changed TO OpenAPos.set_fraction
ROUTE OpenAPos.value_changed TO DrawerA.set_translation
ROUTE ShutATouch.touchTime TO ShutAClock.set_startTime
ROUTE ShutAClock.fraction_changed TO ShutAPos.set_fraction
ROUTE ShutAPos.value_changed TO DrawerA.set_translation
ROUTE OpenBTouch.touchTime TO OpenBClock.set_startTime
ROUTE OpenBClock.fraction_changed TO OpenBPos.set_fraction
ROUTE OpenBPos.value_changed TO DrawerB.set_translation
ROUTE ShutBTouch.touchTime TO ShutBClock.set_startTime
ROUTE ShutBClock.fraction_changed TO ShutBPos.set_fraction
ROUTE ShutBPos.value_changed TO DrawerB.set_translation
ROUTE OpenCTouch.touchTime TO OpenCClock.set_startTime
ROUTE OpenCClock.fraction_changed TO OpenCPos.set_fraction
ROUTE OpenCPos.value_changed TO DrawerC.set_translation
ROUTE ShutCTouch.touchTime TO ShutCClock.set_startTime
ROUTE ShutCClock.fraction_changed TO ShutCPos.set_fraction
ROUTE ShutCPos.value_changed TO DrawerC.set_translation
ROUTE OpenATouch.touchTime TO ShutAClock.set_stopTime
ROUTE ShutATouch.touchTime TO OpenAClock.set_stopTime
ROUTE OpenBTouch.touchTime TO ShutBClock.set_stopTime
ROUTE ShutBTouch.touchTime TO OpenBClock.set_stopTime
ROUTE OpenCTouch.touchTime TO ShutCClock.set_stopTime
ROUTE ShutCTouch.touchTime TO OpenCClock.set_stopTime
ROUTE RaiseTouch.touchTime TO LowerClock.set_stopTime
ROUTE LowerTouch.touchTime TO RaiseClock.set_stopTime
ROUTE RaiseTouch.touchTime TO RaiseClock.set_startTime
ROUTE RaiseClock.fraction_changed TO RaiseOri.set_fraction
ROUTE RaiseOri.value_changed TO ArcPivot.set_rotation
ROUTE LowerTouch.touchTime TO LowerClock.set_startTime
ROUTE LowerClock.fraction_changed TO LowerOri.set_fraction
ROUTE LowerOri.value_changed TO ArcPivot.set_rotation
