WorldInfo {
  title "Starlight Zoetrope"
  info [
    "Made By: BassMekanik"
    "Uploaded: August, 2026"
    "Store: Antique Shop"
    "Limited To: 40"
    "Mall Price: 85 CC"
    "A floor standing optical story machine. Touch RUN to turn the sixteen"
    "slot shutter over the illustrated city panorama, HALT to stop it."
    "All artwork is original. No trademark or third party content."
  ]
}

