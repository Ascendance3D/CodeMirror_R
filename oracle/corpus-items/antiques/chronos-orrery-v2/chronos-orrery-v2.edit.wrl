#VRML V2.0 utf8
WorldInfo {
  title "Chronos Orrey V2"
  info [
    "Made By: BassMekanik"
    "Uploaded: August, 2026"
    "Store: Antique Shop"
    "Limited To: 40"
    "Mall Price: 140 CC"
  ]
}
DEF ChronosReady Group {
  children [
    # Design Materials
    DEF APP_WALNUT Appearance {
      material Material {
        diffuseColor 0.12 0.045 0.02
        specularColor 0.25 0.12 0.05
        shininess 0.45
      }
    }
    DEF APP_BRASS Appearance {
      material Material {
        diffuseColor 0.62 0.40 0.12
        specularColor 0.72 0.52 0.22
        shininess 0.68
      }
    }
    DEF APP_BRONZE Appearance {
      material Material {
        diffuseColor 0.28 0.14 0.05
        specularColor 0.38 0.20 0.08
        shininess 0.52
      }
    }
    DEF APP_GOLD Appearance {
      material Material {
        diffuseColor 0.82 0.52 0.12
        specularColor 0.85 0.65 0.28
        shininess 0.78
      }
    }
    DEF APP_SUN_GLOW Appearance {
      material Material {
        diffuseColor 0.95 0.65 0.15
        emissiveColor 0.60 0.35 0.05
        specularColor 0.90 0.80 0.40
        shininess 0.85
      }
    }
    DEF APP_IVORY Appearance {
      material Material {
        diffuseColor 0.82 0.76 0.60
        specularColor 0.40 0.36 0.28
        shininess 0.35
      }
    }
    DEF APP_MERCURY Appearance {
      material Material {
        diffuseColor 0.45 0.45 0.48
        specularColor 0.55 0.55 0.60
        shininess 0.60
      }
    }
    DEF APP_VENUS Appearance {
      material Material {
        diffuseColor 0.78 0.62 0.38
        specularColor 0.65 0.50 0.25
        shininess 0.50
      }
    }
    DEF APP_EARTH Appearance {
      material Material {
        diffuseColor 0.06 0.22 0.48
        specularColor 0.20 0.40 0.65
        shininess 0.58
      }
    }
    DEF APP_MARS Appearance {
      material Material {
        diffuseColor 0.55 0.15 0.05
        specularColor 0.48 0.18 0.08
        shininess 0.45
      }
    }
    DEF APP_JUPITER Appearance {
      material Material {
        diffuseColor 0.68 0.42 0.20
        specularColor 0.50 0.30 0.12
        shininess 0.40
      }
    }
    DEF APP_SATURN Appearance {
      material Material {
        diffuseColor 0.62 0.52 0.30
        specularColor 0.55 0.45 0.25
        shininess 0.55
      }
    }
    DEF APP_SATURN_RING Appearance {
      material Material {
        diffuseColor 0.58 0.48 0.28
        transparency 0.20
        specularColor 0.50 0.40 0.20
        shininess 0.45
      }
    }
    # --------------------------------------------------
    # Base Plinth & Carved Bronze Feet (Lowest Y = -1.75)
    # --------------------------------------------------
    # Feet at 4 corners
    Transform { translation -0.95 -1.69 0.35000000000000003 children [ Shape { appearance USE APP_BRONZE geometry Cylinder { radius 0.16 height 0.12 } } ] }
    Transform { translation 0.95 -1.69 0.35000000000000003 children [ Shape { appearance USE APP_BRONZE geometry Cylinder { radius 0.16 height 0.12 } } ] }
    Transform { translation -0.95 -1.69 -0.95 children [ Shape { appearance USE APP_BRONZE geometry Cylinder { radius 0.16 height 0.12 } } ] }
    Transform { translation 0.95 -1.69 -0.95 children [ Shape { appearance USE APP_BRONZE geometry Cylinder { radius 0.16 height 0.12 } } ] }

    # Tier 1 Base Plinth (Walnut)
    Transform { translation 0 -1.55 -0.3 children [
      Shape { appearance USE APP_WALNUT geometry Box { size 2.40 0.16 1.60 } }
    ] }
    # Tier 2 Mid Plinth (Walnut with Brass Trim)
    Transform { translation 0 -1.41 -0.3 children [
      Shape { appearance USE APP_WALNUT geometry Box { size 2.10 0.12 1.38 } }
      Transform { translation 0 0.07 0 children [
        Shape { appearance USE APP_BRASS geometry Box { size 2.18 0.03 1.44 } }
      ] }
    ] }
    # Tier 3 Top Base Step
    Transform { translation 0 -1.28 -0.3 children [
      Shape { appearance USE APP_WALNUT geometry Box { size 1.76 0.14 1.18 } }
      Transform { translation 0 0.08 0 children [
        Shape { appearance USE APP_BRONZE geometry Cylinder { radius 0.72 height 0.03 } }
      ] }
    ] }
    # --------------------------------------------------
    # Fluted Pedestal Column & Victorian Brass Struts
    # --------------------------------------------------
    Transform { translation 0 -0.80 -0.3 children [
      # Main Walnut Pedestal Cone
      Shape { appearance USE APP_WALNUT geometry Cone { bottomRadius 0.68 topRadius 0.42 height 0.82 bottom FALSE } }
      # Brass Rings at Base & Top of Pedestal Cone
      Transform { translation 0 -0.39 0 children [ Shape { appearance USE APP_BRASS geometry Cylinder { radius 0.69 height 0.05 } } ] }
      Transform { translation 0 0.39 0 children [ Shape { appearance USE APP_BRASS geometry Cylinder { radius 0.43 height 0.05 } } ] }
      
      # Vertical Brass Flutes
      Transform { translation -0.46 0 0 children [ Shape { appearance USE APP_BRASS geometry Box { size 0.045 0.76 0.06 } } ] }
      Transform { translation 0.46 0 0 children [ Shape { appearance USE APP_BRASS geometry Box { size 0.045 0.76 0.06 } } ] }
      Transform { translation 0 0 0.46 children [ Shape { appearance USE APP_BRASS geometry Box { size 0.06 0.76 0.045 } } ] }
      Transform { translation 0 0 -0.46 children [ Shape { appearance USE APP_BRASS geometry Box { size 0.06 0.76 0.045 } } ] }
    ] }

    # S-Curved Brass Corner Support Struts
    Transform { translation -0.72 -0.80 0.04999999999999999 rotation 0 0 1 -0.32 children [
      Shape { appearance USE APP_BRONZE geometry Box { size 0.06 0.78 0.06 } }
    ] }
    Transform { translation 0.72 -0.80 0.04999999999999999 rotation 0 0 1 0.32 children [
      Shape { appearance USE APP_BRONZE geometry Box { size 0.06 0.78 0.06 } }
    ] }
    Transform { translation -0.72 -0.80 -0.6499999999999999 rotation 0 0 1 -0.32 children [
      Shape { appearance USE APP_BRONZE geometry Box { size 0.06 0.78 0.06 } }
    ] }
    Transform { translation 0.72 -0.80 -0.6499999999999999 rotation 0 0 1 0.32 children [
      Shape { appearance USE APP_BRONZE geometry Box { size 0.06 0.78 0.06 } }
    ] }
    # --------------------------------------------------
    # Gearbox Housing & Interactive Winding Control
    # --------------------------------------------------
    Transform { translation 0 -0.28 -0.3 children [
      # Main Upper Gear Casing (Walnut & Brass)
      Shape { appearance USE APP_WALNUT geometry Box { size 0.98 0.18 0.82 } }
      Transform { translation 0 0.10 0 children [ Shape { appearance USE APP_BRASS geometry Box { size 1.02 0.03 0.86 } } ] }
    ] }

    # Interactive Winding Control Dial Group
    DEF ChronosControl Group {
      children [
        DEF ChronosControlTouch TouchSensor { description "Wind the Chronos Orrey V2" }
        Transform { translation 0 -0.28 0.12 children [
          # Brass Bezel Ring
          Transform { rotation 1 0 0 1.571 children [ Shape { appearance USE APP_BRASS geometry Cylinder { radius 0.28 height 0.06 } } ] }
          # Ivory Dial Face
          Transform { translation 0 0 0.035 rotation 1 0 0 1.571 children [ Shape { appearance USE APP_IVORY geometry Cylinder { radius 0.23 height 0.062 } } ] }
          # Center Gear Key Hub
          Transform { translation 0 0 0.07 rotation 1 0 0 1.571 children [ Shape { appearance USE APP_BRONZE geometry Cylinder { radius 0.07 height 0.05 } } ] }
          
          # Winding Crank Handle & Knob
          DEF WINDING_CRANK Transform { translation 0 0 0.09 children [
            Transform { translation 0.08 -0.05 0 rotation 0 0 1 -0.45 children [ Shape { appearance USE APP_BRASS geometry Box { size 0.035 0.18 0.03 } } ] }
            Transform { translation 0.14 -0.11 0.02 children [ Shape { appearance USE APP_IVORY geometry Sphere { radius 0.042 } } ] }
          ] }
          
          # Side Key Pegs
          Transform { translation -0.32 0 0 rotation 0 0 1 1.571 children [ Shape { appearance USE APP_BRASS geometry Cylinder { radius 0.03 height 0.24 } } ] }
          Transform { translation 0.32 0 0 rotation 0 0 1 1.571 children [ Shape { appearance USE APP_BRASS geometry Cylinder { radius 0.03 height 0.24 } } ] }
        ] }
      ]
    }
    # --------------------------------------------------
    # Central Drive Spindle & Interlocking Gear Train
    # --------------------------------------------------
    Transform { translation 0 0.70 -0.3 children [
      # Central Brass Drive Shaft
      Shape { appearance USE APP_BRASS geometry Cylinder { radius 0.10 height 1.80 } }
      
      # Interlocking Gear Disks (Rotated by script)
      DEF GEAR_TRAIN Transform { translation 0 -0.80 0 children [
        # Center Spur Gear
        Shape { appearance USE APP_BRONZE geometry Cylinder { radius 0.32 height 0.05 } }
        # Satellite Gear 1
        Transform { translation 0.28 0.03 0.12 children [ Shape { appearance USE APP_BRASS geometry Cylinder { radius 0.18 height 0.04 } } ] }
        # Satellite Gear 2
        Transform { translation -0.26 0.03 -0.10 children [ Shape { appearance USE APP_BRASS geometry Cylinder { radius 0.20 height 0.04 } } ] }
      ] }
      
      # Brass Collar Rings along Spindle
      Transform { translation 0 -0.55 0 children [ Shape { appearance USE APP_BRONZE geometry Cylinder { radius 0.22 height 0.08 } } ] }
      Transform { translation 0 -0.15 0 children [ Shape { appearance USE APP_BRONZE geometry Cylinder { radius 0.20 height 0.08 } } ] }
      Transform { translation 0 0.25 0 children [ Shape { appearance USE APP_BRONZE geometry Cylinder { radius 0.18 height 0.08 } } ] }
      Transform { translation 0 0.65 0 children [ Shape { appearance USE APP_BRASS geometry Cylinder { radius 0.15 height 0.08 } } ] }
    ] }
    # --------------------------------------------------
    # Armillary Rings & Celestial Orrery Assembly
    # Armillary Center Y = 0.85, Z = -0.3
    # --------------------------------------------------
    Transform { translation 0 0.85 -0.3 children [
      
      # Stationary Outer Brass Meridian Frame
      Transform { rotation 1 0 0 1.571 children [
        Shape { appearance USE APP_BRASS geometry Extrusion {
          crossSection [ -0.04 -0.04, 0.04 -0.04, 0.04 0.04, -0.04 0.04, -0.04 -0.04 ]
          spine [
            1.25 0 0, 1.083 0 0.625, 0.625 0 1.083, 0 0 1.25,
            -0.625 0 1.083, -1.083 0 0.625, -1.25 0 0,
            -1.083 0 -0.625, -0.625 0 -1.083, 0 0 -1.25,
            0.625 0 -1.083, 1.083 0 -0.625, 1.25 0 0
          ]
          creaseAngle 0.8
        } }
      ] }

      # Precessing Tilted Ecliptic Ring (Rotated by script)
      DEF ECLIPTIC_RING Transform { rotation 1 0 0.3 0.41 children [
        Shape { appearance USE APP_BRONZE geometry Extrusion {
          crossSection [ -0.03 -0.03, 0.03 -0.03, 0.03 0.03, -0.03 0.03, -0.03 -0.03 ]
          spine [
            1.18 0 0, 1.022 0 0.590, 0.590 0 1.022, 0 0 1.18,
            -0.590 0 1.022, -1.022 0 0.590, -1.18 0 0,
            -1.022 0 -0.590, -0.590 0 -1.022, 0 0 -1.18,
            0.590 0 -1.022, 1.022 0 -0.590, 1.18 0 0
          ]
          creaseAngle 0.8
        } }
      ] }

      # Glowing Sun (Central Celestial Body)
      DEF SUN_ASSEMBLY Transform { children [
        Shape { appearance USE APP_GOLD geometry Sphere { radius 0.25 } }
        Shape { appearance USE APP_SUN_GLOW geometry Sphere { radius 0.29 } }
      ] }

      # ------------------------------------------------
      # Planetary Arms & Celestial Orbits
      # ------------------------------------------------
      
      # 1. Mercury System (R = 0.38)
      DEF MERCURY_ARM Transform { children [
        Transform { translation 0.19 0 0 rotation 0 0 1 1.571 children [
          Shape { appearance USE APP_BRASS geometry Cylinder { radius 0.02 height 0.38 } }
        ] }
        Transform { translation 0.38 0 0 children [
          Shape { appearance USE APP_MERCURY geometry Sphere { radius 0.065 } }
        ] }
      ] }

      # 2. Venus System (R = 0.54)
      DEF VENUS_ARM Transform { children [
        Transform { translation 0.27 0.06 0 rotation 0 0 1 1.571 children [
          Shape { appearance USE APP_BRASS geometry Cylinder { radius 0.02 height 0.54 } }
        ] }
        Transform { translation 0.54 0.06 0 children [
          Shape { appearance USE APP_VENUS geometry Sphere { radius 0.095 } }
        ] }
      ] }

      # 3. Earth & Moon System (R = 0.72)
      DEF EARTH_ARM Transform { children [
        Transform { translation 0.36 -0.04 0 rotation 0 0 1 1.571 children [
          Shape { appearance USE APP_BRASS geometry Cylinder { radius 0.024 height 0.72 } }
        ] }
        Transform { translation 0.72 -0.04 0 children [
          # Earth Sphere
          Shape { appearance USE APP_EARTH geometry Sphere { radius 0.12 } }
          # Orbiting Moon
          DEF MOON_ARM Transform { children [
            Transform { translation 0.19 0.03 0 rotation 0 0 1 1.571 children [
              Shape { appearance USE APP_BRONZE geometry Cylinder { radius 0.01 height 0.19 } }
            ] }
            Transform { translation 0.19 0.03 0 children [
              Shape { appearance USE APP_IVORY geometry Sphere { radius 0.042 } }
            ] }
          ] }
        ] }
      ] }

      # 4. Mars System (R = 0.88)
      DEF MARS_ARM Transform { children [
        Transform { translation 0.44 0.08 0 rotation 0 0 1 1.571 children [
          Shape { appearance USE APP_BRONZE geometry Cylinder { radius 0.02 height 0.88 } }
        ] }
        Transform { translation 0.88 0.08 0 children [
          Shape { appearance USE APP_MARS geometry Sphere { radius 0.085 } }
        ] }
      ] }

      # 5. Jupiter System (R = 1.04)
      DEF JUPITER_ARM Transform { children [
        Transform { translation 0.52 -0.08 0 rotation 0 0 1 1.571 children [
          Shape { appearance USE APP_BRASS geometry Cylinder { radius 0.026 height 1.04 } }
        ] }
        Transform { translation 1.04 -0.08 0 children [
          Shape { appearance USE APP_JUPITER geometry Sphere { radius 0.17 } }
        ] }
      ] }

      # 6. Saturn System with Ring (R = 1.20)
      DEF SATURN_ARM Transform { children [
        Transform { translation 0.60 0.02 0 rotation 0 0 1 1.571 children [
          Shape { appearance USE APP_BRONZE geometry Cylinder { radius 0.028 height 1.20 } }
        ] }
        Transform { translation 1.20 0.02 0 children [
          # Saturn Planet Sphere
          Shape { appearance USE APP_SATURN geometry Sphere { radius 0.14 } }
          # Saturn Ring System
          Transform { rotation 1 0 0.4 0.55 children [
            Shape { appearance USE APP_SATURN_RING geometry Cylinder { radius 0.30 height 0.008 } }
            Shape { appearance USE APP_BRASS geometry Cylinder { radius 0.31 height 0.004 } }
          ] }
        ] }
      ] }

    ] }
  ]
}

# --------------------------------------------------
# Animation Control Logic & Routing
# --------------------------------------------------
DEF OrreryClock TimeSensor { cycleInterval 86400 loop TRUE startTime 4102444800 stopTime 0 }

DEF OrreryToggle Script {
  eventIn SFTime touch
  eventIn SFTime tick
  eventOut SFTime startAt
  eventOut SFTime stopAt
  eventOut SFRotation sunRotation
  eventOut SFRotation mercuryRotation
  eventOut SFRotation venusRotation
  eventOut SFRotation earthRotation
  eventOut SFRotation moonRotation
  eventOut SFRotation marsRotation
  eventOut SFRotation jupiterRotation
  eventOut SFRotation saturnRotation
  eventOut SFRotation eclipticRotation
  eventOut SFRotation gearRotation
  eventOut SFRotation crankRotation
  field SFBool running FALSE
  field SFTime last 0
  field SFFloat sunPhase 0
  field SFFloat mercuryPhase 0
  field SFFloat venusPhase 0
  field SFFloat earthPhase 0
  field SFFloat moonPhase 0
  field SFFloat marsPhase 0
  field SFFloat jupiterPhase 0
  field SFFloat saturnPhase 0
  field SFFloat eclipticPhase 0
  field SFFloat gearPhase 0
  field SFFloat crankPhase 0
  url [ "javascript:
    function touch(t) {
      if (running) {
        running = false;
        stopAt = t;
      } else {
        running = true;
        last = t;
        startAt = t;
      }
    }
    function tick(t) {
      if (running) {
        var d = t - last;
        if (d > 0) {
          sunPhase += d * 0.08;
          mercuryPhase += d * 0.45;
          venusPhase += d * 0.28;
          earthPhase += d * 0.18;
          moonPhase += d * 0.95;
          marsPhase += d * 0.12;
          jupiterPhase += d * 0.06;
          saturnPhase += d * 0.035;
          eclipticPhase -= d * 0.03;
          gearPhase += d * 0.35;
          crankPhase += d * 0.70;
          
          sunRotation = new SFRotation(0, 1, 0, sunPhase);
          mercuryRotation = new SFRotation(0, 1, 0, mercuryPhase);
          venusRotation = new SFRotation(0, 1, 0, venusPhase);
          earthRotation = new SFRotation(0, 1, 0, earthPhase);
          moonRotation = new SFRotation(0, 1, 0, moonPhase);
          marsRotation = new SFRotation(0, 1, 0, marsPhase);
          jupiterRotation = new SFRotation(0, 1, 0, jupiterPhase);
          saturnRotation = new SFRotation(0, 1, 0, saturnPhase);
          eclipticRotation = new SFRotation(0, 1, 0, eclipticPhase);
          gearRotation = new SFRotation(0, 1, 0, gearPhase);
          crankRotation = new SFRotation(0, 0, 1, crankPhase);
          
          last = t;
        }
      }
    }
  " ]
}

ROUTE ChronosControlTouch.touchTime TO OrreryToggle.touch
ROUTE OrreryToggle.startAt TO OrreryClock.set_startTime
ROUTE OrreryToggle.stopAt TO OrreryClock.set_stopTime
ROUTE OrreryClock.time TO OrreryToggle.tick

ROUTE OrreryToggle.sunRotation TO SUN_ASSEMBLY.set_rotation
ROUTE OrreryToggle.mercuryRotation TO MERCURY_ARM.set_rotation
ROUTE OrreryToggle.venusRotation TO VENUS_ARM.set_rotation
ROUTE OrreryToggle.earthRotation TO EARTH_ARM.set_rotation
ROUTE OrreryToggle.moonRotation TO MOON_ARM.set_rotation
ROUTE OrreryToggle.marsRotation TO MARS_ARM.set_rotation
ROUTE OrreryToggle.jupiterRotation TO JUPITER_ARM.set_rotation
ROUTE OrreryToggle.saturnRotation TO SATURN_ARM.set_rotation
ROUTE OrreryToggle.eclipticRotation TO ECLIPTIC_RING.set_rotation
ROUTE OrreryToggle.gearRotation TO GEAR_TRAIN.set_rotation
ROUTE OrreryToggle.crankRotation TO WINDING_CRANK.set_rotation
