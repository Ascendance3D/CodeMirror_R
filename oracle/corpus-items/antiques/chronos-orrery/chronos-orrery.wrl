#VRML V2.0 utf8
WorldInfo {
  title "Chronos Orrery"
  info [
    "Made By: BassMekanik"
    "Uploaded: August, 2026"
    "Store: Antique Shop"
    "Limited To: 40"
    "Mall Price: 140 CC"
  ]
}

DEF ChronosReady Group {
  children [
    Transform { translation 0 -1.625 -0.15 children [
      Shape { appearance DEF APP_WALNUT Appearance { material DEF M_WALNUT Material { diffuseColor 0.115 0.045 0.022 specularColor 0.22 0.11 0.05 shininess 0.42 } } geometry Box { size 2.50 0.25 1.65 } }
    ] }
    Transform { translation 0 -1.425 -0.15 children [
      Shape { appearance USE APP_WALNUT geometry Box { size 2.20 0.15 1.42 } }
      Transform { translation 0 0.09 0 children [ Shape { appearance DEF APP_BRASS Appearance { material DEF M_BRASS Material { diffuseColor 0.56 0.33 0.09 specularColor 0.62 0.43 0.16 shininess 0.62 } } geometry Box { size 2.28 0.035 1.48 } } ] }
    ] }
    Transform { translation -0.92 -1.69 0.42 children [ Shape { appearance DEF APP_BRONZE Appearance { material DEF M_BRONZE Material { diffuseColor 0.23 0.105 0.035 specularColor 0.32 0.17 0.06 shininess 0.48 } } geometry Cylinder { radius 0.16 height 0.12 } } ] }
    Transform { translation 0.92 -1.69 0.42 children [ Shape { appearance USE APP_BRONZE geometry Cylinder { radius 0.16 height 0.12 } } ] }
    Transform { translation -0.92 -1.69 -0.72 children [ Shape { appearance USE APP_BRONZE geometry Cylinder { radius 0.16 height 0.12 } } ] }
    Transform { translation 0.92 -1.69 -0.72 children [ Shape { appearance USE APP_BRONZE geometry Cylinder { radius 0.16 height 0.12 } } ] }

    Transform { translation 0 -0.87 -0.15 children [
      Shape { appearance USE APP_WALNUT geometry Cone { bottomRadius 0.72 height 0.92 bottom FALSE } }
      Transform { translation 0 -0.43 0 children [ Shape { appearance USE APP_BRASS geometry Cylinder { radius 0.735 height 0.055 } } ] }
      Transform { translation 0 0.40 0 children [ Shape { appearance USE APP_BRASS geometry Cylinder { radius 0.455 height 0.055 } } ] }
      Transform { translation -0.48 0 0.21 children [ Shape { appearance USE APP_BRASS geometry Box { size 0.055 0.70 0.08 } } ] }
      Transform { translation 0.48 0 0.21 children [ Shape { appearance USE APP_BRASS geometry Box { size 0.055 0.70 0.08 } } ] }
    ] }
    Transform { translation 0 -0.34 -0.15 children [
      Shape { appearance USE APP_WALNUT geometry Box { size 1.04 0.18 0.84 } }
      Transform { translation 0 0.11 0 children [ Shape { appearance USE APP_BRASS geometry Cylinder { radius 0.48 height 0.05 } } ] }
      Transform { translation 0 -0.01 0.45 children [ Shape { appearance DEF APP_DARK Appearance { material DEF M_DARK Material { diffuseColor 0.025 0.035 0.042 specularColor 0.12 0.15 0.18 shininess 0.35 } } geometry Box { size 0.62 0.16 0.035 } } ] }
    ] }

    Transform { translation 0 0.78 -0.40 children [
      Transform { translation 0 -0.54 0 children [ Shape { appearance USE APP_BRONZE geometry Cylinder { radius 0.24 height 0.22 } } ] }
      Transform { translation 0 0.40 0 children [ Shape { appearance USE APP_BRASS geometry Cylinder { radius 0.12 height 1.80 } } ] }
      Transform { translation 0 0.08 0 children [ Shape { appearance USE APP_BRONZE geometry Cylinder { radius 0.23 height 0.13 } } ] }
      Transform { translation 0 0.94 0 children [ Shape { appearance USE APP_BRONZE geometry Cylinder { radius 0.20 height 0.11 } } ] }
      Transform { translation 0 1.26 0 children [ Shape { appearance USE APP_BRASS geometry Cylinder { radius 0.14 height 0.28 } } ] }

      DEF MAIN_ASSEMBLY Transform { children [
        Transform { rotation 1 0 0 1.571 children [ Shape { appearance USE APP_BRASS geometry DEF RING_GEOM Extrusion {
          crossSection [ -0.038 -0.038, 0.038 -0.038, 0.038 0.038, -0.038 0.038, -0.038 -0.038 ]
          spine [ 0.95 0 0, 0.823 0 0.475, 0.475 0 0.823, 0 0 0.95, -0.475 0 0.823, -0.823 0 0.475, -0.95 0 0, -0.823 0 -0.475, -0.475 0 -0.823, 0 0 -0.95, 0.475 0 -0.823, 0.823 0 -0.475, 0.95 0 0 ]
          creaseAngle 0.7
        } } ] }
        Transform { rotation 0 0 1 0.61 children [ Transform { rotation 1 0 0 1.571 children [ Shape { appearance USE APP_BRONZE geometry USE RING_GEOM } ] } ] }
      ] }
      DEF INNER_RING Transform { rotation 0 1 0 0 children [
        Transform { rotation 1 0 0 0.46 children [ Shape { appearance USE APP_BRASS geometry USE RING_GEOM } ] }
        Transform { translation 0 0 0.23 children [ Shape { appearance USE APP_BRONZE geometry Cylinder { radius 0.27 height 0.17 } } ] }
      ] }
      Shape { appearance DEF APP_GOLD Appearance { material DEF M_GOLD Material { diffuseColor 0.78 0.46 0.10 specularColor 0.75 0.55 0.20 shininess 0.7 } } geometry Sphere { radius 0.21 } }
      Transform { translation 0 0 0 children [ Shape { appearance DEF APP_IVORY Appearance { material DEF M_IVORY Material { diffuseColor 0.78 0.70 0.52 specularColor 0.35 0.32 0.25 shininess 0.3 } } geometry Sphere { radius 0.08 } } ] }
      DEF ORBIT_ARM Transform { children [
        Transform { translation 0.39 0 0 rotation 0 0 1 1.571 children [ Shape { appearance USE APP_BRASS geometry Cylinder { radius 0.025 height 0.78 } } ] }
        Transform { translation 0.84 0 0 children [ Shape { appearance DEF APP_COBALT Appearance { material DEF M_COBALT Material { diffuseColor 0.055 0.16 0.42 specularColor 0.16 0.30 0.58 shininess 0.55 } } geometry Sphere { radius 0.13 } } ] }
        Transform { rotation 0 1 0 2.10 children [
          Transform { translation 0.30 0 0 rotation 0 0 1 1.571 children [ Shape { appearance USE APP_BRASS geometry Cylinder { radius 0.02 height 0.60 } } ] }
          Transform { translation 0.65 0 0 children [ Shape { appearance DEF APP_BURGUNDY Appearance { material DEF M_BURGUNDY Material { diffuseColor 0.30 0.035 0.06 specularColor 0.42 0.08 0.11 shininess 0.45 } } geometry Sphere { radius 0.105 } } ] }
        ] }
        Transform { rotation 0 1 0 4.18 children [
          Transform { translation 0.33 0 0 rotation 0 0 1 1.571 children [ Shape { appearance USE APP_BRASS geometry Cylinder { radius 0.02 height 0.66 } } ] }
          Transform { translation 0.70 0 0 children [ Shape { appearance DEF APP_TEAL Appearance { material DEF M_TEAL Material { diffuseColor 0.035 0.29 0.25 specularColor 0.08 0.38 0.32 shininess 0.48 } } geometry Sphere { radius 0.12 } } ] }
        ] }
        Transform { rotation 0 1 0 5.15 children [
          Transform { translation 0.24 0 0 rotation 0 0 1 1.571 children [ Shape { appearance USE APP_BRONZE geometry Cylinder { radius 0.018 height 0.48 } } ] }
          Transform { translation 0.52 0 0 children [ Shape { appearance DEF APP_ORANGE Appearance { material DEF M_ORANGE Material { diffuseColor 0.60 0.18 0.035 specularColor 0.55 0.20 0.06 shininess 0.42 } } geometry Sphere { radius 0.085 } } ] }
        ] }
      ] }
    ] }

    DEF ChronosControl Group { children [
      DEF ChronosControlTouch TouchSensor { description "Wind the Chronos Orrery" }
      Transform { translation 0 -0.27 0.33 children [
        Transform { rotation 1 0 0 1.571 children [ Shape { appearance USE APP_BRASS geometry Cylinder { radius 0.265 height 0.075 } } ] }
        Transform { translation 0 0 0.045 rotation 1 0 0 1.571 children [ Shape { appearance USE APP_IVORY geometry Cylinder { radius 0.205 height 0.082 } } ] }
        Transform { translation 0.07 0 0.095 children [ Shape { appearance USE APP_BRONZE geometry Box { size 0.025 0.17 0.035 } } ] }
        Transform { translation -0.09 0.08 0.095 children [ Shape { appearance USE APP_BRASS geometry Sphere { radius 0.024 } } ] }
        Transform { translation 0.30 -0.04 0.10 rotation 0 0 1 1.571 children [ Shape { appearance USE APP_BRONZE geometry Cylinder { radius 0.035 height 0.34 } } ] }
        Transform { translation 0.48 -0.04 0.10 children [ Shape { appearance USE APP_BRASS geometry Sphere { radius 0.075 } } ] }
      ] }
    ] }
  ]
}

DEF OrreryClock TimeSensor { cycleInterval 86400 loop TRUE startTime 4102444800 stopTime 0 }
DEF OrreryToggle Script {
  eventIn SFTime touch
  eventIn SFTime tick
  eventOut SFTime startAt
  eventOut SFTime stopAt
  eventOut SFRotation mainRotation
  eventOut SFRotation innerRotation
  eventOut SFRotation armRotation
  field SFBool running FALSE
  field SFTime last 0
  field SFFloat mainPhase 0
  field SFFloat innerPhase 0
  field SFFloat armPhase 0
  url [ "javascript: function touch(t) { if (running) { running = false; stopAt = t; } else { running = true; last = t; startAt = t; } } function tick(t) { if (running) { var d = t - last; if (d > 0) { mainPhase += d * 0.105; innerPhase -= d * 0.155; armPhase += d * 0.205; mainRotation = new SFRotation(0,1,0,mainPhase); innerRotation = new SFRotation(0,0,1,innerPhase); armRotation = new SFRotation(0,1,0,armPhase); last = t; } } }" ]
}
ROUTE ChronosControlTouch.touchTime TO OrreryToggle.touch
ROUTE OrreryToggle.startAt TO OrreryClock.set_startTime
ROUTE OrreryToggle.stopAt TO OrreryClock.set_stopTime
ROUTE OrreryClock.time TO OrreryToggle.tick
ROUTE OrreryToggle.mainRotation TO MAIN_ASSEMBLY.set_rotation
ROUTE OrreryToggle.innerRotation TO INNER_RING.set_rotation
ROUTE OrreryToggle.armRotation TO ORBIT_ARM.set_rotation
