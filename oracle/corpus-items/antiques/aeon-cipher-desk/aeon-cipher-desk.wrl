    DEF RingAOpen OrientationInterpolator {
      key [ 0, 0, 0.1925, 0.396, 0.55, 1 ]
      keyValue [ 0 0 1 0, 0 0 1 0, 0 0 1 0.3491, 0 0 1 0.7505, 0 0 1 0.8727, 0 0 1 0.8727 ]
    }
    DEF RingAShut OrientationInterpolator {
      key [ 0, 0, 0.1925, 0.396, 0.55, 1 ]
      keyValue [ 0 0 1 0.8727, 0 0 1 0.8727, 0 0 1 0.7505, 0 0 1 0.3491, 0 0 1 0, 0 0 1 0 ]
    }
    DEF RingBOpen OrientationInterpolator {
      key [ 0, 0.05, 0.2495, 0.4604, 0.62, 1 ]
      keyValue [ 0 0 1 0, 0 0 1 0, 0 0 1 -0.4747, 0 0 1 -1.0207, 0 0 1 -1.1868, 0 0 1 -1.1868 ]
    }
    DEF RingBShut OrientationInterpolator {
      key [ 0, 0.05, 0.2495, 0.4604, 0.62, 1 ]
      keyValue [ 0 0 1 -1.1868, 0 0 1 -1.1868, 0 0 1 -1.0207, 0 0 1 -0.4747, 0 0 1 0, 0 0 1 0 ]
    }
    DEF RingCOpen OrientationInterpolator {
      key [ 0, 0.1, 0.31, 0.532, 0.7, 1 ]
      keyValue [ 0 0 1 0, 0 0 1 0, 0 0 1 0.6144, 0 0 1 1.3209, 0 0 1 1.5359, 0 0 1 1.5359 ]
    }
    DEF RingCShut OrientationInterpolator {
      key [ 0, 0.1, 0.31, 0.532, 0.7, 1 ]
      keyValue [ 0 0 1 1.5359, 0 0 1 1.5359, 0 0 1 1.3209, 0 0 1 0.6144, 0 0 1 0, 0 0 1 0 ]
    }
    DEF RolltopOpen OrientationInterpolator {
      key [ 0, 0.18, 0.4145, 0.6624, 0.85, 1 ]
      keyValue [ 1 0 0 0, 1 0 0 0, 1 0 0 1.103, 1 0 0 2.3716, 1 0 0 2.7576, 1 0 0 2.7576 ]
    }
    DEF RolltopShut OrientationInterpolator {
      key [ 0, 0.18, 0.4145, 0.6624, 0.85, 1 ]
      keyValue [ 1 0 0 2.7576, 1 0 0 2.7576, 1 0 0 2.3716, 1 0 0 1.103, 1 0 0 0, 1 0 0 0 ]
    }
    DEF FlapOpen OrientationInterpolator {
      key [ 0, 0.45, 0.6425, 0.846, 1, 1 ]
      keyValue [ 1 0 0 0, 1 0 0 0, 1 0 0 0.6283, 1 0 0 1.3509, 1 0 0 1.5708, 1 0 0 1.5708 ]
    }
    DEF FlapShut OrientationInterpolator {
      key [ 0, 0.45, 0.6425, 0.846, 1, 1 ]
      keyValue [ 1 0 0 1.5708, 1 0 0 1.5708, 1 0 0 1.3509, 1 0 0 0.6283, 1 0 0 0, 1 0 0 0 ]
    }
    DEF DeployClock TimeSensor {
      cycleInterval 1.6
      loop FALSE
      startTime 4102444800
      stopTime 0
    }
    DEF ResetClock TimeSensor {
      cycleInterval 1.6
      loop FALSE
      startTime 4102444800
      stopTime 0
    }
  ]
}
# Two clocks, and each one stops the other, so DEPLOY and RESET can
# never drive the same Transform at the same time.  Both clocks start
# at 2100-01-01 with loop FALSE, so nothing moves until a key is
# touched.  (startTime 1 would be 1970 -- i.e. the PAST -- and would
# run the animation from load.)
ROUTE SunTouch.touchTime  TO DeployClock.set_startTime
ROUTE SunTouch.touchTime  TO ResetClock.set_stopTime
ROUTE MoonTouch.touchTime TO ResetClock.set_startTime
ROUTE MoonTouch.touchTime TO DeployClock.set_stopTime

ROUTE DeployClock.fraction_changed TO RingAOpen.set_fraction
ROUTE RingAOpen.value_changed TO RingA.set_rotation
ROUTE ResetClock.fraction_changed TO RingAShut.set_fraction
ROUTE RingAShut.value_changed TO RingA.set_rotation

ROUTE DeployClock.fraction_changed TO RingBOpen.set_fraction
ROUTE RingBOpen.value_changed TO RingB.set_rotation
ROUTE ResetClock.fraction_changed TO RingBShut.set_fraction
ROUTE RingBShut.value_changed TO RingB.set_rotation

ROUTE DeployClock.fraction_changed TO RingCOpen.set_fraction
ROUTE RingCOpen.value_changed TO RingC.set_rotation
ROUTE ResetClock.fraction_changed TO RingCShut.set_fraction
ROUTE RingCShut.value_changed TO RingC.set_rotation

ROUTE DeployClock.fraction_changed TO RolltopOpen.set_fraction
ROUTE RolltopOpen.value_changed TO Rolltop.set_rotation
ROUTE ResetClock.fraction_changed TO RolltopShut.set_fraction
ROUTE RolltopShut.value_changed TO Rolltop.set_rotation

ROUTE DeployClock.fraction_changed TO FlapOpen.set_fraction
ROUTE FlapOpen.value_changed TO Flap.set_rotation
ROUTE ResetClock.fraction_changed TO FlapShut.set_fraction
ROUTE FlapShut.value_changed TO Flap.set_rotation
