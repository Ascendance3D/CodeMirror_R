WorldInfo {
  title "Aeon Cipher Desk"
  info [
    "Made By: BassMekanik"
    "Uploaded: August, 2026"
    "Store: Antique Shop"
    "Limited To: 35"
    "Mall Price: 75 CC"
    "A compact antique writing desk built around a nested cipher wheel."
    "Touch the sun key to deploy and the moon key to reset."
    "All artwork is original. No trademark or third party content."
  ]
}

