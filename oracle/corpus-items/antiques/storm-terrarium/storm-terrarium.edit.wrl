ROUTE STOP_TOUCH.touchTime TO STORM_CLOCK.set_stopTime
ROUTE STOP_TOUCH.touchTime TO QUIET_CLOCK.set_startTime
ROUTE STORM_CLOCK.fraction_changed TO FLASH_A.set_fraction
