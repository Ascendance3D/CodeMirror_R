ROUTE STORM_TOUCH.touchTime TO STORM_CLOCK.set_startTime
ROUTE STOP_TOUCH.touchTime TO STORM_CLOCK.set_stopTime
ROUTE STOP_TOUCH.touchTime TO QUIET_CLOCK.set_startTime
ROUTE STORM_CLOCK.fraction_changed TO FLASH_A.set_fraction
ROUTE STORM_CLOCK.fraction_changed TO FLASH_B.set_fraction
ROUTE STORM_CLOCK.fraction_changed TO FLASH_C.set_fraction
ROUTE QUIET_CLOCK.fraction_changed TO QUIET_INTERP.set_fraction
ROUTE FLASH_A.value_changed TO LIGHTNING_MAT_A.set_transparency
ROUTE FLASH_B.value_changed TO LIGHTNING_MAT_B.set_transparency
ROUTE FLASH_C.value_changed TO LIGHTNING_MAT_C.set_transparency
ROUTE QUIET_INTERP.value_changed TO LIGHTNING_MAT_A.set_transparency
ROUTE QUIET_INTERP.value_changed TO LIGHTNING_MAT_B.set_transparency
ROUTE QUIET_INTERP.value_changed TO LIGHTNING_MAT_C.set_transparency
