DEF OpenClock TimeSensor { cycleInterval 1.25 loop FALSE startTime 0 stopTime 1 }
DEF ShutClock TimeSensor { cycleInterval 1.25 loop FALSE startTime 0 stopTime 1 }
DEF OpenA OrientationInterpolator { key [ 0 0.16 0.33 0.5 0.67 0.84 1 ] keyValue [ 0 1 0 0, 0 1 0 0.0958, 0 1 0 0.3558, 0 1 0 0.6981, 0 1 0 1.0405, 0 1 0 1.3005, 0 1 0 1.3963 ] }
DEF ShutA OrientationInterpolator { key [ 0 0.16 0.33 0.5 0.67 0.84 1 ] keyValue [ 0 1 0 1.3963, 0 1 0 1.3005, 0 1 0 1.0405, 0 1 0 0.6981, 0 1 0 0.3558, 0 1 0 0.0958, 0 1 0 0 ] }
DEF OpenB OrientationInterpolator { key [ 0 0.16 0.33 0.5 0.67 0.84 1 ] keyValue [ 0 1 0 0, 0 1 0 -0.0958, 0 1 0 -0.3558, 0 1 0 -0.6981, 0 1 0 -1.0405, 0 1 0 -1.3005, 0 1 0 -1.3963 ] }
DEF ShutB OrientationInterpolator { key [ 0 0.16 0.33 0.5 0.67 0.84 1 ] keyValue [ 0 1 0 -1.3963, 0 1 0 -1.3005, 0 1 0 -1.0405, 0 1 0 -0.6981, 0 1 0 -0.3558, 0 1 0 -0.0958, 0 1 0 0 ] }

DEF Latch Script {
  eventIn  SFTime set_touch
  eventIn  SFBool set_busy
  eventOut SFTime openTime
  eventOut SFTime shutTime
  field    SFBool isOpen FALSE
  field    SFBool busy FALSE
  mustEvaluate TRUE
  url [ "javascript:
function set_busy(v) { busy = v; }
function set_touch(t) {
  if (busy) return;
  if (isOpen) { isOpen = false; shutTime = t; }
  else { isOpen = true; openTime = t; }
}" ]
}

ROUTE GlobeTouch.touchTime TO Latch.set_touch
ROUTE Latch.openTime TO OpenClock.set_startTime
ROUTE Latch.shutTime TO ShutClock.set_startTime
ROUTE OpenClock.isActive TO Latch.set_busy
ROUTE ShutClock.isActive TO Latch.set_busy
ROUTE OpenClock.fraction_changed TO OpenA.set_fraction
ROUTE OpenClock.fraction_changed TO OpenB.set_fraction
ROUTE ShutClock.fraction_changed TO ShutA.set_fraction
ROUTE ShutClock.fraction_changed TO ShutB.set_fraction
ROUTE OpenA.value_changed TO DoorA.set_rotation
ROUTE OpenB.value_changed TO DoorB.set_rotation
ROUTE ShutA.value_changed TO DoorA.set_rotation
ROUTE ShutB.value_changed TO DoorB.set_rotation

