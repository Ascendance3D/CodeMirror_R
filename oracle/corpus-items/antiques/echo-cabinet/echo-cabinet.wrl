    DEF Pulse2 ColorInterpolator {
      key [ 0, 0.3, 0.365, 0.4, 0.555, 1 ]
      keyValue [ 0.049 0.02 0.017, 0.049 0.02 0.017, 0.882 0.36 0.306, 0.882 0.36 0.306, 0.049 0.02 0.017, 0.049 0.02 0.017 ]
    }
    DEF Pulse3 ColorInterpolator {
      key [ 0, 0.165, 0.23, 0.265, 0.42, 1 ]
      keyValue [ 0.049 0.02 0.017, 0.049 0.02 0.017, 0.931 0.38 0.323, 0.931 0.38 0.323, 0.049 0.02 0.017, 0.049 0.02 0.017 ]
    }
    DEF Pulse4 ColorInterpolator {
      key [ 0, 0.03, 0.095, 0.13, 0.285, 1 ]
      keyValue [ 0.049 0.02 0.017, 0.049 0.02 0.017, 0.98 0.4 0.34, 0.98 0.4 0.34, 0.049 0.02 0.017, 0.049 0.02 0.017 ]
    }
    DEF ResPulse ColorInterpolator {
      key [ 0, 0.045, 0.2, 0.955, 1 ]
      keyValue [ 1 0.62 0.28, 1 0.62 0.28, 0.05 0.031 0.014, 0.05 0.031 0.014, 1 0.62 0.28 ]
    }
    DEF ResMove PositionInterpolator {
      key [ 0, 0.05, 0.16, 0.42, 1 ]
      keyValue [ 0 0 0, 0 0 0.014, 0 0 0.0042, 0 0 0, 0 0 0 ]
    }
    DEF DarkArch ColorInterpolator {
      key [ 0, 1 ]
      keyValue [ 0.049 0.02 0.017, 0.049 0.02 0.017 ]
    }
    DEF DarkRes ColorInterpolator {
      key [ 0, 1 ]
      keyValue [ 0.05 0.031 0.014, 0.05 0.031 0.014 ]
    }
    DEF DarkMove PositionInterpolator {
      key [ 0, 1 ]
      keyValue [ 0 0 0, 0 0 0 ]
    }
    DEF DoorOpen TimeSensor {
      cycleInterval 2
      loop FALSE
      startTime 4102444800
      stopTime 0
    }
    DEF DoorShut TimeSensor {
      cycleInterval 2
      loop FALSE
      startTime 4102444800
      stopTime 0
    }
    DEF EchoClock TimeSensor {
      cycleInterval 3.4
      loop TRUE
      startTime 4102444800
      stopTime 0
    }
    DEF DarkClock TimeSensor {
      cycleInterval 0.25
      loop FALSE
      startTime 4102444800
      stopTime 0
    }
  ]
}
# OPEN and CLOSE own the doors and cancel each other, so the two door
# clocks can never drive the same Transform at once.  Neither touches
# the echo clock, and ECHO never touches a door.
ROUTE OpenTouch.touchTime  TO DoorOpen.set_startTime
ROUTE OpenTouch.touchTime  TO DoorShut.set_stopTime
ROUTE CloseTouch.touchTime TO DoorShut.set_startTime
ROUTE CloseTouch.touchTime TO DoorOpen.set_stopTime

# One echo clock driving one set of interpolators, so a repeat touch
# cannot stack cycles, overlap them or change the speed. Measured in
# X_ITE: a repeat reseeds this clock, so the pulse simply restarts at
# the resonator -- it does not run twice and it does not run faster.
ROUTE EchoTouch.touchTime  TO EchoClock.set_startTime

# STOP halts everything that can be running, then snaps the glow home.
ROUTE StopTouch.touchTime  TO DoorOpen.set_stopTime
ROUTE StopTouch.touchTime  TO DoorShut.set_stopTime
ROUTE StopTouch.touchTime  TO EchoClock.set_stopTime
ROUTE StopTouch.touchTime  TO DarkClock.set_startTime

ROUTE DoorOpen.fraction_changed TO SwingL.set_fraction
ROUTE SwingL.value_changed TO DoorL.set_rotation
ROUTE DoorShut.fraction_changed TO ShutL.set_fraction
ROUTE ShutL.value_changed TO DoorL.set_rotation
ROUTE DoorOpen.fraction_changed TO SwingR.set_fraction
ROUTE SwingR.value_changed TO DoorR.set_rotation
ROUTE DoorShut.fraction_changed TO ShutR.set_fraction
ROUTE ShutR.value_changed TO DoorR.set_rotation

ROUTE EchoClock.fraction_changed TO Pulse0.set_fraction
ROUTE Pulse0.value_changed TO ArchMat0.set_emissiveColor
ROUTE EchoClock.fraction_changed TO Pulse1.set_fraction
ROUTE Pulse1.value_changed TO ArchMat1.set_emissiveColor
ROUTE EchoClock.fraction_changed TO Pulse2.set_fraction
ROUTE Pulse2.value_changed TO ArchMat2.set_emissiveColor
ROUTE EchoClock.fraction_changed TO Pulse3.set_fraction
ROUTE Pulse3.value_changed TO ArchMat3.set_emissiveColor
ROUTE EchoClock.fraction_changed TO Pulse4.set_fraction
ROUTE Pulse4.value_changed TO ArchMat4.set_emissiveColor
ROUTE EchoClock.fraction_changed TO ResPulse.set_fraction
ROUTE ResPulse.value_changed TO ResMat.set_emissiveColor
ROUTE EchoClock.fraction_changed TO ResMove.set_fraction
ROUTE ResMove.value_changed TO Resonator.set_translation

ROUTE DarkClock.fraction_changed TO DarkArch.set_fraction
ROUTE DarkArch.value_changed TO ArchMat0.set_emissiveColor
ROUTE DarkArch.value_changed TO ArchMat1.set_emissiveColor
ROUTE DarkArch.value_changed TO ArchMat2.set_emissiveColor
ROUTE DarkArch.value_changed TO ArchMat3.set_emissiveColor
ROUTE DarkArch.value_changed TO ArchMat4.set_emissiveColor
ROUTE DarkClock.fraction_changed TO DarkRes.set_fraction
ROUTE DarkRes.value_changed TO ResMat.set_emissiveColor
ROUTE DarkClock.fraction_changed TO DarkMove.set_fraction
ROUTE DarkMove.value_changed TO Resonator.set_translation
