# =========================================================================
# SEARCH SYSTEM -- three clocks, four keys, no Script node
# =========================================================================
# X_ITE compiles a Script's ECMAScript with `new Function()` and WRL Forge ships
# `script-src` without `'unsafe-eval'`, so a Script would never initialise and
# every ROUTE through it would be silently dead.  Everything here is
# TimeSensors, interpolators and ROUTEs.
# ---- wide sweep ----------------------------------------------------------------
# BeatWide is this mode's clock.  startTime is the 2100-01-01 sentinel, so the
# array is genuinely idle at load; startTime 1 would be 1970-01-01 and would run
# from the moment the world opens.
DEF BeatWide TimeSensor { cycleInterval 3 loop TRUE startTime 4102444800 }
# IdleWide carries NO startTime, so it is 1970 -- already past -- and `loop
# TRUE` makes it ACTIVE THE MOMENT THE WORLD LOADS.  RunWide carries the
# sentinel and is not.  Between them they enable exactly one of this key's two
# TouchSensors, which is what makes the key a toggle instead of a restart.
DEF IdleWide TimeSensor { cycleInterval 1000000000 loop TRUE }
DEF RunWide  TimeSensor { cycleInterval 1000000000 loop TRUE startTime 4102444800 }
ROUTE IdleWide.isActive TO WideOnTouch.set_enabled
ROUTE RunWide.isActive  TO WideOffTouch.set_enabled
# The stop is BEAT-ALIGNED.  LatchWide arms on the press; StopWide is enabled
# only while that latch is up and is restarted by every BeatWide.cycleTime, so
# the first beat AFTER the press stops the clock at fraction 0 -- which is the
# park pose of all three heads.  Stopping the clock straight from the touch
# would freeze the heads at an arbitrary angle, and a TimeSensor cannot resume
# mid-cycle, so the next start would snap them back.
DEF LatchWide TimeSensor { cycleInterval 1 loop TRUE startTime 4102444800 }
DEF StopWide  TimeSensor { cycleInterval 0.01 loop TRUE enabled FALSE startTime 4102444800 }
ROUTE LatchWide.isActive TO StopWide.set_enabled
ROUTE BeatWide.cycleTime TO StopWide.set_startTime
ROUTE StopWide.cycleTime TO BeatWide.set_stopTime
ROUTE StopWide.cycleTime TO LatchWide.set_stopTime
ROUTE StopWide.cycleTime TO StopWide.set_stopTime
# StartWide is `loop TRUE` with a real cycleInterval, not a `loop FALSE`
# one-shot: a one-shot depends on the eventOut a TimeSensor emits the instant it
# becomes active, and Cybertown's production X_ITE 4.7.0 does not emit that.
DEF StartWide TimeSensor { cycleInterval 0.01 loop TRUE startTime 4102444800 }
ROUTE StartWide.cycleTime TO BeatWide.set_startTime
ROUTE StartWide.cycleTime TO StartWide.set_stopTime
# ---- convergence ----------------------------------------------------------------
# BeatConv is this mode's clock.  startTime is the 2100-01-01 sentinel, so the
# array is genuinely idle at load; startTime 1 would be 1970-01-01 and would run
# from the moment the world opens.
DEF BeatConv TimeSensor { cycleInterval 2.8 loop TRUE startTime 4102444800 }
# IdleConv carries NO startTime, so it is 1970 -- already past -- and `loop
# TRUE` makes it ACTIVE THE MOMENT THE WORLD LOADS.  RunConv carries the
# sentinel and is not.  Between them they enable exactly one of this key's two
# TouchSensors, which is what makes the key a toggle instead of a restart.
DEF IdleConv TimeSensor { cycleInterval 1000000000 loop TRUE }
DEF RunConv  TimeSensor { cycleInterval 1000000000 loop TRUE startTime 4102444800 }
ROUTE IdleConv.isActive TO ConvOnTouch.set_enabled
ROUTE RunConv.isActive  TO ConvOffTouch.set_enabled
# The stop is BEAT-ALIGNED.  LatchConv arms on the press; StopConv is enabled
# only while that latch is up and is restarted by every BeatConv.cycleTime, so
# the first beat AFTER the press stops the clock at fraction 0 -- which is the
# park pose of all three heads.  Stopping the clock straight from the touch
# would freeze the heads at an arbitrary angle, and a TimeSensor cannot resume
# mid-cycle, so the next start would snap them back.
DEF LatchConv TimeSensor { cycleInterval 1 loop TRUE startTime 4102444800 }
DEF StopConv  TimeSensor { cycleInterval 0.01 loop TRUE enabled FALSE startTime 4102444800 }
ROUTE LatchConv.isActive TO StopConv.set_enabled
ROUTE BeatConv.cycleTime TO StopConv.set_startTime
ROUTE StopConv.cycleTime TO BeatConv.set_stopTime
ROUTE StopConv.cycleTime TO LatchConv.set_stopTime
ROUTE StopConv.cycleTime TO StopConv.set_stopTime
# StartConv is `loop TRUE` with a real cycleInterval, not a `loop FALSE`
# one-shot: a one-shot depends on the eventOut a TimeSensor emits the instant it
# becomes active, and Cybertown's production X_ITE 4.7.0 does not emit that.
DEF StartConv TimeSensor { cycleInterval 0.01 loop TRUE startTime 4102444800 }
ROUTE StartConv.cycleTime TO BeatConv.set_startTime
ROUTE StartConv.cycleTime TO StartConv.set_stopTime
# ---- cross scan ----------------------------------------------------------------
# BeatCross is this mode's clock.  startTime is the 2100-01-01 sentinel, so the
# array is genuinely idle at load; startTime 1 would be 1970-01-01 and would run
# from the moment the world opens.
DEF BeatCross TimeSensor { cycleInterval 2.2 loop TRUE startTime 4102444800 }
# IdleCross carries NO startTime, so it is 1970 -- already past -- and `loop
# TRUE` makes it ACTIVE THE MOMENT THE WORLD LOADS.  RunCross carries the
# sentinel and is not.  Between them they enable exactly one of this key's two
# TouchSensors, which is what makes the key a toggle instead of a restart.
DEF IdleCross TimeSensor { cycleInterval 1000000000 loop TRUE }
DEF RunCross  TimeSensor { cycleInterval 1000000000 loop TRUE startTime 4102444800 }
ROUTE IdleCross.isActive TO CrossOnTouch.set_enabled
ROUTE RunCross.isActive  TO CrossOffTouch.set_enabled
# The stop is BEAT-ALIGNED.  LatchCross arms on the press; StopCross is enabled
# only while that latch is up and is restarted by every BeatCross.cycleTime, so
# the first beat AFTER the press stops the clock at fraction 0 -- which is the
# park pose of all three heads.  Stopping the clock straight from the touch
# would freeze the heads at an arbitrary angle, and a TimeSensor cannot resume
# mid-cycle, so the next start would snap them back.
DEF LatchCross TimeSensor { cycleInterval 1 loop TRUE startTime 4102444800 }
DEF StopCross  TimeSensor { cycleInterval 0.01 loop TRUE enabled FALSE startTime 4102444800 }
ROUTE LatchCross.isActive TO StopCross.set_enabled
ROUTE BeatCross.cycleTime TO StopCross.set_startTime
ROUTE StopCross.cycleTime TO BeatCross.set_stopTime
ROUTE StopCross.cycleTime TO LatchCross.set_stopTime
ROUTE StopCross.cycleTime TO StopCross.set_stopTime
# StartCross is `loop TRUE` with a real cycleInterval, not a `loop FALSE`
# one-shot: a one-shot depends on the eventOut a TimeSensor emits the instant it
# becomes active, and Cybertown's production X_ITE 4.7.0 does not emit that.
DEF StartCross TimeSensor { cycleInterval 0.01 loop TRUE startTime 4102444800 }
ROUTE StartCross.cycleTime TO BeatCross.set_startTime
ROUTE StartCross.cycleTime TO StartCross.set_stopTime

# ------------------------------------------------------------ key wiring
ROUTE WideOnTouch.touchTime TO IdleWide.set_stopTime
ROUTE WideOnTouch.touchTime TO RunWide.set_startTime
ROUTE WideOnTouch.touchTime TO LatchWide.set_stopTime
ROUTE WideOnTouch.touchTime TO StartWide.set_startTime
ROUTE WideOffTouch.touchTime TO RunWide.set_stopTime
ROUTE WideOffTouch.touchTime TO IdleWide.set_startTime
ROUTE WideOffTouch.touchTime TO LatchWide.set_startTime
ROUTE WideOffTouch.touchTime TO StopWide.set_stopTime
ROUTE OffTouch.touchTime TO RunWide.set_stopTime
ROUTE OffTouch.touchTime TO IdleWide.set_startTime
ROUTE OffTouch.touchTime TO LatchWide.set_startTime
ROUTE OffTouch.touchTime TO StopWide.set_stopTime
ROUTE ConvOnTouch.touchTime TO RunWide.set_stopTime
ROUTE ConvOnTouch.touchTime TO IdleWide.set_startTime
ROUTE ConvOnTouch.touchTime TO LatchWide.set_startTime
ROUTE ConvOnTouch.touchTime TO StopWide.set_stopTime
ROUTE CrossOnTouch.touchTime TO RunWide.set_stopTime
ROUTE CrossOnTouch.touchTime TO IdleWide.set_startTime
ROUTE CrossOnTouch.touchTime TO LatchWide.set_startTime
ROUTE CrossOnTouch.touchTime TO StopWide.set_stopTime
ROUTE ConvOnTouch.touchTime TO IdleConv.set_stopTime
ROUTE ConvOnTouch.touchTime TO RunConv.set_startTime
ROUTE ConvOnTouch.touchTime TO LatchConv.set_stopTime
ROUTE ConvOnTouch.touchTime TO StartConv.set_startTime
ROUTE ConvOffTouch.touchTime TO RunConv.set_stopTime
ROUTE ConvOffTouch.touchTime TO IdleConv.set_startTime
ROUTE ConvOffTouch.touchTime TO LatchConv.set_startTime
ROUTE ConvOffTouch.touchTime TO StopConv.set_stopTime
ROUTE OffTouch.touchTime TO RunConv.set_stopTime
ROUTE OffTouch.touchTime TO IdleConv.set_startTime
ROUTE OffTouch.touchTime TO LatchConv.set_startTime
ROUTE OffTouch.touchTime TO StopConv.set_stopTime
ROUTE WideOnTouch.touchTime TO RunConv.set_stopTime
ROUTE WideOnTouch.touchTime TO IdleConv.set_startTime
ROUTE WideOnTouch.touchTime TO LatchConv.set_startTime
ROUTE WideOnTouch.touchTime TO StopConv.set_stopTime
ROUTE CrossOnTouch.touchTime TO RunConv.set_stopTime
ROUTE CrossOnTouch.touchTime TO IdleConv.set_startTime
ROUTE CrossOnTouch.touchTime TO LatchConv.set_startTime
ROUTE CrossOnTouch.touchTime TO StopConv.set_stopTime
ROUTE CrossOnTouch.touchTime TO IdleCross.set_stopTime
ROUTE CrossOnTouch.touchTime TO RunCross.set_startTime
ROUTE CrossOnTouch.touchTime TO LatchCross.set_stopTime
ROUTE CrossOnTouch.touchTime TO StartCross.set_startTime
ROUTE CrossOffTouch.touchTime TO RunCross.set_stopTime
ROUTE CrossOffTouch.touchTime TO IdleCross.set_startTime
ROUTE CrossOffTouch.touchTime TO LatchCross.set_startTime
ROUTE CrossOffTouch.touchTime TO StopCross.set_stopTime
ROUTE OffTouch.touchTime TO RunCross.set_stopTime
ROUTE OffTouch.touchTime TO IdleCross.set_startTime
ROUTE OffTouch.touchTime TO LatchCross.set_startTime
ROUTE OffTouch.touchTime TO StopCross.set_stopTime
ROUTE WideOnTouch.touchTime TO RunCross.set_stopTime
ROUTE WideOnTouch.touchTime TO IdleCross.set_startTime
ROUTE WideOnTouch.touchTime TO LatchCross.set_startTime
ROUTE WideOnTouch.touchTime TO StopCross.set_stopTime
ROUTE ConvOnTouch.touchTime TO RunCross.set_stopTime
ROUTE ConvOnTouch.touchTime TO IdleCross.set_startTime
ROUTE ConvOnTouch.touchTime TO LatchCross.set_startTime
ROUTE ConvOnTouch.touchTime TO StopCross.set_stopTime

# ------------------------------------------------------------ head motion
DEF TurnWideC0 OrientationInterpolator {
  key [ 0.0000, 0.1250, 0.2500, 0.3750, 0.5000, 0.6250, 0.7500, 0.8750, 1.0000 ]
  keyValue [ 0 1 0 0.00000, 0 1 0 0.47997, 0 1 0 0.95993, 0 1 0 0.47997, 0 1 0 0.00000, 0 1 0 -0.47997, 0 1 0 -0.95993, 0 1 0 -0.47997, 0 1 0 0.00000 ] }
DEF TurnWideC1 OrientationInterpolator {
  key [ 0.0000, 0.1250, 0.2500, 0.3750, 0.5000, 0.6250, 0.7500, 0.8750, 1.0000 ]
  keyValue [ 0 1 0 0.00000, 0 1 0 0.47997, 0 1 0 0.95993, 0 1 0 0.47997, 0 1 0 0.00000, 0 1 0 -0.47997, 0 1 0 -0.95993, 0 1 0 -0.47997, 0 1 0 0.00000 ] }
