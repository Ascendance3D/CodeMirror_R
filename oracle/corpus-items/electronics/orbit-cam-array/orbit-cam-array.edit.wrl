  keyValue [ 0 1 0 -0.00000, 0 1 0 -0.61087, 0 1 0 -0.00000, 0 1 0 0.61087, 0 1 0 -0.00000, 0 1 0 -0.61087, 0 1 0 -0.00000, 0 1 0 0.61087, 0 1 0 -0.00000 ] }
DEF TurnCrossC2 OrientationInterpolator {
