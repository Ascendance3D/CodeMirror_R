ROUTE BeatWide.fraction_changed TO TurnWideC0.set_fraction
ROUTE TurnWideC0.value_changed TO Mode1C0.set_rotation
ROUTE BeatWide.fraction_changed TO TurnWideC1.set_fraction
ROUTE TurnWideC1.value_changed TO Mode1C1.set_rotation
ROUTE BeatWide.fraction_changed TO TurnWideC2.set_fraction
ROUTE TurnWideC2.value_changed TO Mode1C2.set_rotation
ROUTE BeatConv.fraction_changed TO TurnConvC0.set_fraction
ROUTE TurnConvC0.value_changed TO Mode2C0.set_rotation
ROUTE BeatConv.fraction_changed TO TurnConvC1.set_fraction
ROUTE TurnConvC1.value_changed TO Mode2C1.set_rotation
ROUTE BeatConv.fraction_changed TO TurnConvC2.set_fraction
ROUTE TurnConvC2.value_changed TO Mode2C2.set_rotation
ROUTE BeatCross.fraction_changed TO TurnCrossC0.set_fraction
ROUTE TurnCrossC0.value_changed TO Mode3C0.set_rotation
ROUTE BeatCross.fraction_changed TO TurnCrossC1.set_fraction
ROUTE TurnCrossC1.value_changed TO Mode3C1.set_rotation
ROUTE BeatCross.fraction_changed TO TurnCrossC2.set_fraction
ROUTE TurnCrossC2.value_changed TO Mode3C2.set_rotation
ROUTE BeatWide.fraction_changed TO RingWide.set_fraction
ROUTE RingWide.value_changed TO MRing.set_emissiveColor
ROUTE BeatWide.fraction_changed TO LedWide.set_fraction
ROUTE LedWide.value_changed TO MLed.set_emissiveColor
ROUTE BeatConv.fraction_changed TO RingConv.set_fraction
ROUTE RingConv.value_changed TO MRing.set_emissiveColor
ROUTE BeatConv.fraction_changed TO LedConv.set_fraction
ROUTE LedConv.value_changed TO MLed.set_emissiveColor
ROUTE BeatCross.fraction_changed TO RingCross.set_fraction
ROUTE RingCross.value_changed TO MRing.set_emissiveColor
ROUTE BeatCross.fraction_changed TO LedCross.set_fraction
ROUTE LedCross.value_changed TO MLed.set_emissiveColor

