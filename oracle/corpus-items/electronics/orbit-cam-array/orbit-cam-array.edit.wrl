  keyValue [ 1 0.35 0 0.00000, 1 0.35 0 0.36652, 1 0.35 0 0.73304, 1 0.35 0 0.73304, 1 0.35 0 0.36652, 1 0.35 0 0.00000, 1 0.35 0 0.00000 ] }
DEF TurnConvC2 OrientationInterpolator {
  key [ 0.0000, 0.1000, 0.2000, 0.5500, 0.7500, 0.9000, 1.0000 ]
  keyValue [ 1 0.35 0 0.00000, 1 0.35 0 0.36652, 1 0.35 0 0.73304, 1 0.35 0 0.73304, 1 0.35 0 0.36652, 1 0.35 0 0.00000, 1 0.35 0 0.00000 ] }
DEF TurnCrossC0 OrientationInterpolator {
  key [ 0.0000, 0.1250, 0.2500, 0.3750, 0.5000, 0.6250, 0.7500, 0.8750, 1.0000 ]
  keyValue [ 0 1 0 0.00000, 0 1 0 0.61087, 0 1 0 0.00000, 0 1 0 -0.61087, 0 1 0 0.00000, 0 1 0 0.61087, 0 1 0 0.00000, 0 1 0 -0.61087, 0 1 0 0.00000 ] }
DEF TurnCrossC1 OrientationInterpolator {
