#VRML V2.0 utf8
# Orbit Cam Array -- an original three-head surveillance camera array for the
# Cybertown Revival Mall.  Generated by build-orbit-cam-array.py;
# edit that, not this.
#
# Touch SCAN 1, SCAN 2 or SCAN 3 to run one of three search patterns, and the
# same key again to stop it.  Touch OFF to park every head.  All four keys sit
# side by side on the raked deck on top of the hub, facing the visitor: the
# three arms are placed at 180, 60 and 300 degrees so the front quadrant is
# empty and no arm can stand between a visitor and a control.

WorldInfo {
  title "Orbit Cam Array"
  info [
    "Made By: BassMekanik"
    "Uploaded: September, 2026"
    "Category: Electronics"
    "Limited To: 35"
    "Mall Price: 75 CC"
    "Touch SCAN 1, 2 or 3 for a search pattern. Touch OFF to park the heads."
  ]
}


