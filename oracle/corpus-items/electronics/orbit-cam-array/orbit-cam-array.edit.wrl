  keyValue [ 1 0.35 0 0.00000, 1 0.35 0 0.36652, 1 0.35 0 0.73304, 1 0.35 0 0.73304, 1 0.35 0 0.36652, 1 0.35 0 0.00000, 1 0.35 0 0.00000 ] }
