#VRML V2.0 utf8
# Signal Storm Globe -- an original retro-future atmospheric-signal receiver
# for the Cybertown Revival Mall.  Generated by build-signal-storm-globe.py;
# edit that, not this.
#
# Touch START to run the signal system, STOP to halt it.  Both keys sit side by
# side on the raked control deck at the front, so one viewpoint reaches both.

WorldInfo {
  title "Signal Storm Globe"
  info [
    "Made By: BassMekanik"
    "Uploaded: September, 2026"
    "Category: Electronics"
    "Limited To: 30"
    "Mall Price: 75 CC"
    "Touch START to run the signal rings. Touch STOP to halt them."
  ]
}


