#VRML V2.0 utf8
# Plasma Disc Player -- an original vertical plasma-disc media player for the
# Cybertown Revival Mall.  Generated by build-plasma-disc-player.py;
# edit that, not this.
#
# Touch OPEN to part the two doors and again to close them; PLAY to run the
# platter, STOP to halt it.  All three keys sit side by side on the raked deck
# on top of the cabinet, so one viewpoint reaches every one of them, and no
# door pose is ever between a visitor and a control.
#
# The doors and the playback are separate machines.  OPEN never starts the
# platter and PLAY never moves a door.

WorldInfo {
  title "Plasma Disc Player"
  info [
    "Made By: BassMekanik"
    "Uploaded: September, 2026"
    "Category: Electronics"
    "Limited To: 35"
    "Mall Price: 75 CC"
    "Touch OPEN to part the doors. Touch PLAY to run the disc, STOP to halt it."
  ]
}


