# =========================================================================
# PLAYBACK -- one clock, no Script node
# =========================================================================
# Beat is the platter's clock.  startTime is the 2100-01-01 sentinel, so the
# player is genuinely idle at load; startTime 1 would be 1970-01-01 and would
# run from the moment the world opens.
DEF Beat TimeSensor { cycleInterval 1.8 loop TRUE startTime 4102444800 }

# STOP is beat-aligned.  StopLatch arms on the press; StopRelay is enabled only
# while that latch is up and is restarted by every Beat.cycleTime, so the first
# beat AFTER the press stops the clock at fraction 0.  One beat is one FULL
# revolution of the platter -- the supplied artwork has no rotational symmetry
# to stop on, measured at 215 counts of spread at 2-fold and 236 at 6-fold --
# so a whole turn is the only pose indistinguishable from home.  Stopping the
# clock straight from the touch would freeze the platter at an arbitrary angle
# and the next PLAY would snap it back to zero.
#
# Both relays are `loop TRUE` with a real 0.01 s cycleInterval, not `loop FALSE`
# one-shots.  A one-shot depends on the eventOut a TimeSensor emits the INSTANT
# it becomes active; Cybertown's production X_ITE 4.7.0 does not emit that, so
# the relay would start and its cycleTime ROUTE would never fire.  `loop TRUE`
# waits for a real cycle boundary instead, an event 4.7.0 does emit, and each
# relay stops itself from its own cycleTime so it still fires once per press.
# Both carry the sentinel startTime as well: `loop TRUE` past a 1970 startTime
# is eligible forever, and without the sentinel the player would spin from load
# with nobody having touched it.
DEF StopLatch TimeSensor { cycleInterval 1 loop TRUE startTime 4102444800 }
DEF StopRelay TimeSensor { cycleInterval 0.01 loop TRUE enabled FALSE startTime 4102444800 }
ROUTE StopLatch.isActive TO StopRelay.set_enabled
ROUTE Beat.cycleTime     TO StopRelay.set_startTime
ROUTE StopRelay.cycleTime TO Beat.set_stopTime
ROUTE StopRelay.cycleTime TO StopLatch.set_stopTime
ROUTE StopRelay.cycleTime TO StopRelay.set_stopTime
# StopRelay.startTime is refreshed on EVERY Beat.cycleTime regardless of
# `enabled`, so by the time StopLatch arms it mid-beat that startTime is
# already up to one whole beat stale, and `loop TRUE` has no eligibility window
# to discard it.  Routing the STOP press's own touchTime into set_stopTime cuts
# the stale value off; the next real Beat.cycleTime then supplies a startTime
# later than that stopTime, which VRML97 re-arms as a fresh cycle.
ROUTE StopTouch.touchTime TO StopRelay.set_stopTime

# START goes through a relay so the restart lands in a strictly later event
# cascade than the stop-latch teardown above it.  Routed direct, the clock can
# emit cycleTime into a latch that has not been torn down yet and stop itself
# on the very frame the visitor pressed PLAY.
DEF StartRelay TimeSensor { cycleInterval 0.01 loop TRUE startTime 4102444800 }
ROUTE PlayTouch.touchTime TO StopLatch.set_stopTime
ROUTE PlayTouch.touchTime TO StartRelay.set_startTime
ROUTE StartRelay.cycleTime TO Beat.set_startTime
ROUTE StartRelay.cycleTime TO StartRelay.set_stopTime
ROUTE StopTouch.touchTime  TO StopLatch.set_startTime

# ------------------------------------------------------------ platter turn
DEF TurnDisc OrientationInterpolator {
  key [ 0.000, 0.125, 0.250, 0.375, 0.500, 0.625, 0.750, 0.875, 1.000 ]
  keyValue [ 0 0 1 0.00000, 0 0 1 0.78540, 0 0 1 1.57080, 0 0 1 2.35619, 0 0 1 3.14159, 0 0 1 3.92699, 0 0 1 4.71239, 0 0 1 5.49779, 0 0 1 6.28319 ] }
ROUTE Beat.fraction_changed TO TurnDisc.set_fraction
ROUTE TurnDisc.value_changed TO SpinDisc.set_rotation

# ------------------------------------------------------------ platter glow
# The dwell at both ends of the beat is what parks the glow on its authored
# idle colour when the clock stops, instead of freezing it part way up a ramp.
DEF RimPulse ColorInterpolator {
  key [ 0, 0.06, 0.5, 0.94, 1 ]
  keyValue [ 0.045 0.120 0.140, 0.045 0.120 0.140, 0.240 0.780 0.900, 0.045 0.120 0.140, 0.045 0.120 0.140 ] }
ROUTE Beat.fraction_changed TO RimPulse.set_fraction
ROUTE RimPulse.value_changed TO MGlow.set_emissiveColor

DEF ArtPulse ColorInterpolator {
  key [ 0, 0.06, 0.5, 0.94, 1 ]
  keyValue [ 0.020 0.024 0.032, 0.020 0.024 0.032, 0.115 0.150 0.205, 0.020 0.024 0.032, 0.020 0.024 0.032 ] }
ROUTE Beat.fraction_changed TO ArtPulse.set_fraction
ROUTE ArtPulse.value_changed TO MDiscArt.set_emissiveColor

# --------------------------------------------------------------- state lamps
# Both clocks are loop FALSE, so each holds its final colour, and neither has
# run at load -- the Materials keep the stopped pose they were authored with.
DEF LampUp TimeSensor { cycleInterval 0.28 loop FALSE }
DEF LampDn TimeSensor { cycleInterval 0.28 loop FALSE }
ROUTE PlayTouch.touchTime TO LampUp.set_startTime
ROUTE StopTouch.touchTime TO LampDn.set_startTime

DEF PlayGlow ColorInterpolator { key [ 0, 1 ]
  keyValue [ 0.030 0.160 0.060, 0.150 0.950 0.350 ] }
DEF PlayFade ColorInterpolator { key [ 0, 1 ]
  keyValue [ 0.150 0.950 0.350, 0.030 0.160 0.060 ] }
DEF StopFade ColorInterpolator { key [ 0, 1 ]
  keyValue [ 0.900 0.160 0.120, 0.200 0.036 0.027 ] }
DEF StopGlow ColorInterpolator { key [ 0, 1 ]
  keyValue [ 0.200 0.036 0.027, 0.900 0.160 0.120 ] }
ROUTE LampUp.fraction_changed TO PlayGlow.set_fraction
ROUTE LampUp.fraction_changed TO StopFade.set_fraction
ROUTE LampDn.fraction_changed TO PlayFade.set_fraction
ROUTE LampDn.fraction_changed TO StopGlow.set_fraction
ROUTE PlayGlow.value_changed TO MPlayLamp.set_emissiveColor
ROUTE PlayFade.value_changed TO MPlayLamp.set_emissiveColor
ROUTE StopGlow.value_changed TO MStopLamp.set_emissiveColor
ROUTE StopFade.value_changed TO MStopLamp.set_emissiveColor

# =========================================================================
# DOORS -- a separate machine that shares nothing with the playback above
# =========================================================================
# One touch address has to reach two behaviours, and VRML97 has no boolean
# node to hold "which one".  Two mutually exclusive TimeSensor latches do it:
# each latch, while active, ENABLES the gate that can leave the state it
# represents.
#
# StClosed carries no startTime, so it is 1970 -- already past -- and `loop
# TRUE` makes it ACTIVE THE MOMENT THE WORLD LOADS.  That is the whole trick:
# the object boots in a known state without a Script and without an initial
# event that X_ITE 4.7.0 might not emit.  StOpen carries the sentinel and is
# not active.  Each gate's `enabled` is also AUTHORED to match that load state,
# so the object is correct even if the initial isActive is never delivered;
# only the TRANSITIONS need it, and a transition always fires.
# The two motion clocks and the four interpolators are declared BEFORE the
# latches that start them.  A VRML97 ROUTE may only name nodes that are already
# DEF'd: written the other way round, `ROUTE OpenGate.cycleTime TO
# DoorOut.set_startTime` names a node the parser has not seen, and the whole
# file is rejected.  Castle reports it as "Route destination node name
# not found"; X_ITE just shows "Failed loading world" and `ctqa load` still
# exits 0, which is how this shipped as a blank scene for one build.
#
# Both clocks are `loop FALSE` with the DEFAULT startTime, which is 1970: a
# one-shot whose eligibility window closed decades before load, so neither has
# run when the world opens, and each holds its final pose once it has run.
# That is the one place a `loop FALSE` past startTime is exactly right.
DEF DoorOut TimeSensor { cycleInterval 1.1 loop FALSE }
DEF DoorIn  TimeSensor { cycleInterval 1.1 loop FALSE }
DEF DoorOpenL OrientationInterpolator {
  key [ 0.000, 0.167, 0.333, 0.500, 0.667, 0.833, 1.000 ]
  keyValue [ 0 1 0 0.00000, 0 1 0 -0.10989, 0 1 0 -0.38462, 0 1 0 -0.74176, 0 1 0 -1.09891, 0 1 0 -1.37364, 0 1 0 -1.48353 ] }
DEF DoorShutL OrientationInterpolator {
  key [ 0.000, 0.167, 0.333, 0.500, 0.667, 0.833, 1.000 ]
  keyValue [ 0 1 0 -1.48353, 0 1 0 -1.37364, 0 1 0 -1.09891, 0 1 0 -0.74176, 0 1 0 -0.38462, 0 1 0 -0.10989, 0 1 0 0.00000 ] }
DEF DoorOpenR OrientationInterpolator {
  key [ 0.000, 0.167, 0.333, 0.500, 0.667, 0.833, 1.000 ]
  keyValue [ 0 1 0 3.14159, 0 1 0 3.25148, 0 1 0 3.52621, 0 1 0 3.88336, 0 1 0 4.24050, 0 1 0 4.51523, 0 1 0 4.62512 ] }
DEF DoorShutR OrientationInterpolator {
  key [ 0.000, 0.167, 0.333, 0.500, 0.667, 0.833, 1.000 ]
  keyValue [ 0 1 0 4.62512, 0 1 0 4.51523, 0 1 0 4.24050, 0 1 0 3.88336, 0 1 0 3.52621, 0 1 0 3.25148, 0 1 0 3.14159 ] }

# TWO SENSORS ON ONE KEY, AND EXACTLY ONE OF THEM IS EVER ENABLED.
#
# One touch address has to reach two behaviours, and VRML97 has no boolean node
# to hold "which one".  The obvious construction -- one sensor, two relay
# TimeSensors, `enabled` picking the live one -- DOES NOT WORK, and the reason
# is worth recording because it costs a day to find:
#
#   A static ROUTE cannot be aimed.  `EjectTouch.touchTime` reaches BOTH
#   relays, so the disabled one silently stores startTime = T.  The moment the
#   state flips and it becomes enabled, it holds a startTime in its own past
#   and, being `loop TRUE`, fires immediately.  The usual defence -- route the
#   winner's cycleTime into the loser's set_stopTime -- fails here because
#   X_ITE emits that cycleTime at the SAME instant T, and VRML97 says a
#   stopTime not greater than startTime is IGNORED.  So the "defence" left
#   stopTime == startTime, the loser activated too, and one press started the
#   opening clock and the closing clock together.  The doors did not move, and
#   every gate in this build passed.
#
#   (`enabled` itself is fine.  tooling/x_ite-preview/probe/enabled-probe.wrl
#   is a two-sensor fixture that proves X_ITE honours `enabled FALSE` on a
#   TimeSensor: the enabled half moves, the disabled half does not.  The fault
#   was the stopTime, not the flag.)
#
# Gating the TOUCH SENSORS instead removes the whole failure mode: a disabled
# TouchSensor emits NOTHING, so no stale startTime is ever written anywhere and
# there is no relay to defend.  Two sensors sit in the OPEN cap's Group and the
# two state latches enable exactly one of them.
#
# StClosed carries no startTime, so it is 1970 -- already past -- and `loop
# TRUE` makes it ACTIVE THE MOMENT THE WORLD LOADS.  StOpen carries the 2100
# sentinel and is not.  Both `enabled` fields are AUTHORED to match that, so
# the object is correct even on a browser that never delivers the initial
# isActive; only the TRANSITIONS need an event, and a transition always fires.
DEF StClosed TimeSensor { cycleInterval 1000000000 loop TRUE }
DEF StOpen   TimeSensor { cycleInterval 1000000000 loop TRUE startTime 4102444800 }
ROUTE StClosed.isActive TO EjectOpenTouch.set_enabled
ROUTE StOpen.isActive   TO EjectShutTouch.set_enabled

# Opening: run the opening clock, leave the closed state, enter the open one.
ROUTE EjectOpenTouch.touchTime TO DoorOut.set_startTime
ROUTE EjectOpenTouch.touchTime TO StClosed.set_stopTime
ROUTE EjectOpenTouch.touchTime TO StOpen.set_startTime
# Closing: the mirror image.  Each latch's new startTime is strictly later than
# the stopTime it was given on the previous press, which is what lets the pair
# alternate indefinitely instead of latching up after one cycle.
ROUTE EjectShutTouch.touchTime TO DoorIn.set_startTime
ROUTE EjectShutTouch.touchTime TO StOpen.set_stopTime
ROUTE EjectShutTouch.touchTime TO StClosed.set_startTime

ROUTE DoorOut.fraction_changed TO DoorOpenL.set_fraction
ROUTE DoorOut.fraction_changed TO DoorOpenR.set_fraction
ROUTE DoorIn.fraction_changed  TO DoorShutL.set_fraction
ROUTE DoorIn.fraction_changed  TO DoorShutR.set_fraction
ROUTE DoorOpenL.value_changed TO DoorL.set_rotation
ROUTE DoorShutL.value_changed TO DoorL.set_rotation
ROUTE DoorOpenR.value_changed TO DoorR.set_rotation
ROUTE DoorShutR.value_changed TO DoorR.set_rotation

