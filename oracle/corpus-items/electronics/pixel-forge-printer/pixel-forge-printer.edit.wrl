ROUTE Grow11.value_changed TO Layer11.set_translation
ROUTE Print.fraction_changed TO Grow12.set_fraction
ROUTE Grow12.value_changed TO Layer12.set_translation
ROUTE Print.fraction_changed TO Grow13.set_fraction
ROUTE Grow13.value_changed TO Layer13.set_translation
ROUTE Print.fraction_changed TO Grow14.set_fraction
ROUTE Grow14.value_changed TO Layer14.set_translation
ROUTE Print.fraction_changed TO Grow15.set_fraction
ROUTE Grow15.value_changed TO Layer15.set_translation
ROUTE Print.fraction_changed TO Grow16.set_fraction
ROUTE Grow16.value_changed TO Layer16.set_translation

# RESET stops whatever is running first, then homes every axis.
ROUTE RESET.touchTime TO Print.stopTime
ROUTE RESET.touchTime TO Open.stopTime
ROUTE RESET.touchTime TO Reset.startTime
ROUTE Reset.fraction_changed TO Zero1.set_fraction
ROUTE Reset.fraction_changed TO Zero2.set_fraction
ROUTE Reset.fraction_changed TO Zero3.set_fraction
ROUTE Zero1.value_changed TO Head.set_translation
ROUTE Zero2.value_changed TO Gantry.set_translation
ROUTE Zero3.value_changed TO Bed.set_translation
ROUTE Reset.fraction_changed TO ZeroL.set_fraction
ROUTE ZeroL.value_changed TO Layer1.set_translation
ROUTE ZeroL.value_changed TO Layer2.set_translation
ROUTE ZeroL.value_changed TO Layer3.set_translation
ROUTE ZeroL.value_changed TO Layer4.set_translation
ROUTE ZeroL.value_changed TO Layer5.set_translation
ROUTE ZeroL.value_changed TO Layer6.set_translation
ROUTE ZeroL.value_changed TO Layer7.set_translation
ROUTE ZeroL.value_changed TO Layer8.set_translation
ROUTE ZeroL.value_changed TO Layer9.set_translation
ROUTE ZeroL.value_changed TO Layer10.set_translation
ROUTE ZeroL.value_changed TO Layer11.set_translation
ROUTE ZeroL.value_changed TO Layer12.set_translation
ROUTE ZeroL.value_changed TO Layer13.set_translation
ROUTE ZeroL.value_changed TO Layer14.set_translation
ROUTE ZeroL.value_changed TO Layer15.set_translation
ROUTE ZeroL.value_changed TO Layer16.set_translation

ROUTE Reset.fraction_changed TO ZeroD.set_fraction
ROUTE ZeroD.value_changed TO Door.set_rotation
