ROUTE DOOR.touchTime  TO Open.startTime
ROUTE Open.fraction_changed TO Swing.set_fraction
ROUTE Swing.value_changed   TO Door.set_rotation

ROUTE START.touchTime TO Print.startTime
ROUTE Print.fraction_changed TO Sweep.set_fraction
ROUTE Print.fraction_changed TO Travel.set_fraction
ROUTE Print.fraction_changed TO Lower.set_fraction
ROUTE Sweep.value_changed  TO Head.set_translation
ROUTE Travel.value_changed TO Gantry.set_translation
ROUTE Lower.value_changed  TO Bed.set_translation
ROUTE Print.fraction_changed TO Grow1.set_fraction
ROUTE Grow1.value_changed TO Layer1.set_translation
ROUTE Print.fraction_changed TO Grow2.set_fraction
ROUTE Grow2.value_changed TO Layer2.set_translation
ROUTE Print.fraction_changed TO Grow3.set_fraction
ROUTE Grow3.value_changed TO Layer3.set_translation
ROUTE Print.fraction_changed TO Grow4.set_fraction
ROUTE Grow4.value_changed TO Layer4.set_translation
ROUTE Print.fraction_changed TO Grow5.set_fraction
ROUTE Grow5.value_changed TO Layer5.set_translation
ROUTE Print.fraction_changed TO Grow6.set_fraction
ROUTE Grow6.value_changed TO Layer6.set_translation
ROUTE Print.fraction_changed TO Grow7.set_fraction
ROUTE Grow7.value_changed TO Layer7.set_translation
ROUTE Print.fraction_changed TO Grow8.set_fraction
ROUTE Grow8.value_changed TO Layer8.set_translation
ROUTE Print.fraction_changed TO Grow9.set_fraction
ROUTE Grow9.value_changed TO Layer9.set_translation
