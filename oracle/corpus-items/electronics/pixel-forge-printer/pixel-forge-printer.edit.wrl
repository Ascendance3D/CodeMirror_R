#VRML V2.0 utf8
# Pixel Forge Printer -- an enclosed desktop 3-D printer that
# prints a miniature Mini Wedged Racer, one print section at a time.
#
# Generated by build-pixel-forge-printer.py -- edit that, not this.
# All shipping geometry is original: the reference import supplied
# dimensions and motion axes only.
#
# DOOR opens the smoked front door (right-hand hinge, swings out
# to your right).  START runs the 13 s print.  RESET returns the
# printer to its exact start state.  All three sit on the angled
# panel at the front left, clear of the open door.

WorldInfo {
  title "Pixel Forge Printer"
  info [
    "Made By: BassMekanik"
    "Uploaded: September, 2026"
    "Category: Electronics"
    "Limited To: 1/40"
    "Mall Price: 65 CC"
    "Touch DOOR to open the chamber. Touch START to print. Touch RESET to clear the bed."
  ]
}

