                      diffuseColor 0.050 0.120 0.070 emissiveColor 0.064 0.400 0.142
                      specularColor 0.14 0.22 0.16 shininess 0.30 ambientIntensity 0.04 } } geometry IndexedFaceSet {
                solid TRUE
                coord Coordinate { point [ 0.03 0.15 0.276 0.03 0.166 0.276 0.03 0.166 0.278 0.03 0.15 0.278 -0.03 0.15 0.276 -0.03 0.15 0.278 -0.03 0.166 0.278 -0.03 0.166 0.276 ] }
                coordIndex [ 0 1 2 3 -1 4 5 6 7 -1 7 6 2 1 -1 4 0 3 5 -1 5 3 2 6 -1 4 7 1 0 -1 ]
              } }
            ]
          }
        ] }
