    } }
    # raised heading index on the rear plate
    Shape { appearance USE ATrim geometry IndexedFaceSet {
      solid TRUE
      coord Coordinate { point [ 0.046 0.215 -0.505 0.046 0.219 -0.505 0.046 0.219 -0.425 0.046 0.215 -0.425 -0.046 0.215 -0.505 -0.046 0.215 -0.425 -0.046 0.219 -0.425 -0.046 0.219 -0.505 ] }
      coordIndex [ 0 1 2 3 -1 4 5 6 7 -1 7 6 2 1 -1 4 0 3 5 -1 5 3 2 6 -1 4 7 1 0 -1 ]
    } }
    # raked control fascia; both keys face the visitor from one face
    Shape { appearance USE AHousing geometry IndexedFaceSet {
