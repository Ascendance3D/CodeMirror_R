                        solid TRUE
                        coord Coordinate { point [ 0 0.332 0.416 0.043 0.332 0.404 0.05 0.332 0.417 0 0.332 0.43 0.074 0.332 0.373 0.087 0.332 0.38 0.086 0.332 0.33 0.1 0.332 0.33 0.074 0.332 0.287 0.087 0.332 0.28 0.043 0.332 0.256 0.05 0.332 0.243 0 0.332 0.244 0 0.332 0.23 -0.043 0.332 0.256 -0.05 0.332 0.243 -0.074 0.332 0.287 -0.087 0.332 0.28 -0.086 0.332 0.33 -0.1 0.332 0.33 -0.074 0.332 0.373 -0.087 0.332 0.38 -0.043 0.332 0.404 -0.05 0.332 0.417 0.05 0.376 0.417 0 0.376 0.43 0.087 0.376 0.38 0.1 0.376 0.33 0.087 0.376 0.28 0.05 0.376 0.243 0 0.376 0.23 -0.05 0.376 0.243 -0.087 0.376 0.28 -0.1 0.376 0.33 -0.087 0.376 0.38 -0.05 0.376 0.417 0.043 0.376 0.404 0 0.376 0.416 0.074 0.376 0.373 0.086 0.376 0.33 0.074 0.376 0.287 0.043 0.376 0.256 0 0.376 0.244 -0.043 0.376 0.256 -0.074 0.376 0.287 -0.086 0.376 0.33 -0.074 0.376 0.373 -0.043 0.376 0.404 ] }
                        coordIndex [ 0 1 2 3 -1 1 4 5 2 -1 4 6 7 5 -1 6 8 9 7 -1 8 10 11 9 -1 10 12 13 11 -1 12 14 15 13 -1 14 16 17 15 -1 16 18 19 17 -1 18 20 21 19 -1 20 22 23 21 -1 22 0 3 23 -1 3 2 24 25 -1 2 5 26 24 -1 5 7 27 26 -1 7 9 28 27 -1 9 11 29 28 -1 11 13 30 29 -1 13 15 31 30 -1 15 17 32 31 -1 17 19 33 32 -1 19 21 34 33 -1 21 23 35 34 -1 23 3 25 35 -1 25 24 36 37 -1 24 26 38 36 -1 26 27 39 38 -1 27 28 40 39 -1 28 29 41 40 -1 29 30 42 41 -1 30 31 43 42 -1 31 32 44 43 -1 32 33 45 44 -1 33 34 46 45 -1 34 35 47 46 -1 35 25 37 47 -1 37 36 1 0 -1 36 38 4 1 -1 38 39 6 4 -1 39 40 8 6 -1 40 41 10 8 -1 41 42 12 10 -1 42 43 14 12 -1 43 44 16 14 -1 44 45 18 16 -1 45 46 20 18 -1 46 47 22 20 -1 47 37 0 22 -1 ]
                      } }
                      # field-rotor core, recessed 30 mm inside the bore
                      Shape { appearance USE ARotor geometry IndexedFaceSet {
                        solid TRUE
                        coord Coordinate { point [ 0 0.338 0.33 0.025 0.338 0.373 0 0.338 0.38 0.043 0.338 0.355 0.05 0.338 0.33 0.043 0.338 0.305 0.025 0.338 0.287 0 0.338 0.28 -0.025 0.338 0.287 -0.043 0.338 0.305 -0.05 0.338 0.33 -0.043 0.338 0.355 -0.025 0.338 0.373 0.025 0.352 0.373 0 0.352 0.38 0.043 0.352 0.355 0.05 0.352 0.33 0.043 0.352 0.305 0.025 0.352 0.287 0 0.352 0.28 -0.025 0.352 0.287 -0.043 0.352 0.305 -0.05 0.352 0.33 -0.043 0.352 0.355 -0.025 0.352 0.373 0 0.352 0.33 ] }
                        coordIndex [ 0 1 2 -1 0 3 1 -1 0 4 3 -1 0 5 4 -1 0 6 5 -1 0 7 6 -1 0 8 7 -1 0 9 8 -1 0 10 9 -1 0 11 10 -1 0 12 11 -1 0 2 12 -1 2 1 13 14 -1 1 3 15 13 -1 3 4 16 15 -1 4 5 17 16 -1 5 6 18 17 -1 6 7 19 18 -1 7 8 20 19 -1 8 9 21 20 -1 9 10 22 21 -1 10 11 23 22 -1 11 12 24 23 -1 12 2 14 24 -1 14 13 25 -1 13 15 25 -1 15 16 25 -1 16 17 25 -1 17 18 25 -1 18 19 25 -1 19 20 25 -1 20 21 25 -1 21 22 25 -1 22 23 25 -1 23 24 25 -1 24 14 25 -1 ]
                      } }
                      # the live rotor -- hub and blades, turned in place by RotorSpin
                      DEF RotorSpin Transform { translation 0 0 0.33 rotation 0 1 0 0
                        children [
                          # spinning rotor: hub and three blades, tips inside the ring
                          Shape { appearance USE ARotor geometry IndexedFaceSet {
                            solid TRUE
                            coord Coordinate { point [ 0 0.374 0 0.012 0.374 0.021 0 0.374 0.024 0.021 0.374 0.012 0.024 0.374 0 0.021 0.374 -0.012 0.012 0.374 -0.021 0 0.374 -0.024 -0.012 0.374 -0.021 -0.021 0.374 -0.012 -0.024 0.374 0 -0.021 0.374 0.012 -0.012 0.374 0.021 0.012 0.392 0.021 0 0.392 0.024 0.021 0.392 0.012 0.024 0.392 0 0.021 0.392 -0.012 0.012 0.392 -0.021 0 0.392 -0.024 -0.012 0.392 -0.021 -0.021 0.392 -0.012 -0.024 0.392 0 -0.021 0.392 0.012 -0.012 0.392 0.021 0 0.392 0 0.088 0.384 -0.013 0.088 0.392 -0.013 0.088 0.392 0.013 0.088 0.384 0.013 0.018 0.384 -0.013 0.018 0.384 0.013 0.018 0.392 0.013 0.018 0.392 -0.013 -0.055 0.384 -0.07 -0.055 0.392 -0.07 -0.033 0.392 -0.083 -0.033 0.384 -0.083 -0.02 0.384 -0.009 0.002 0.384 -0.022 0.002 0.392 -0.022 -0.02 0.392 -0.009 -0.033 0.384 0.083 -0.033 0.392 0.083 -0.055 0.392 0.07 -0.055 0.384 0.07 0.002 0.384 0.022 -0.02 0.384 0.009 -0.02 0.392 0.009 0.002 0.392 0.022 ] }
                            coordIndex [ 0 1 2 -1 0 3 1 -1 0 4 3 -1 0 5 4 -1 0 6 5 -1 0 7 6 -1 0 8 7 -1 0 9 8 -1 0 10 9 -1 0 11 10 -1 0 12 11 -1 0 2 12 -1 2 1 13 14 -1 1 3 15 13 -1 3 4 16 15 -1 4 5 17 16 -1 5 6 18 17 -1 6 7 19 18 -1 7 8 20 19 -1 8 9 21 20 -1 9 10 22 21 -1 10 11 23 22 -1 11 12 24 23 -1 12 2 14 24 -1 14 13 25 -1 13 15 25 -1 15 16 25 -1 16 17 25 -1 17 18 25 -1 18 19 25 -1 19 20 25 -1 20 21 25 -1 21 22 25 -1 22 23 25 -1 23 24 25 -1 24 14 25 -1 26 27 28 29 -1 30 31 32 33 -1 33 32 28 27 -1 30 26 29 31 -1 31 29 28 32 -1 30 33 27 26 -1 34 35 36 37 -1 38 39 40 41 -1 41 40 36 35 -1 38 34 37 39 -1 39 37 36 40 -1 38 41 35 34 -1 42 43 44 45 -1 46 47 48 49 -1 49 48 44 43 -1 46 42 45 47 -1 47 45 44 48 -1 46 49 43 42 -1 ]
                          } }
                        ]
                      }
                    ] }
                  ]
                }
                Transform { rotation 0 1 0 1.047
                  children [
                    USE DroneArm
                  ]
                }
                Transform { rotation 0 1 0 5.236
                  children [
                    USE DroneArm
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}


# =========================================================================
# STATE -- two TouchSensors, and exactly one of them is ever enabled
# =========================================================================
# DockedK carries NO startTime, so it is 1970 -- already past -- and `loop
# TRUE` makes it ACTIVE THE MOMENT THE WORLD LOADS.  That is the whole trick:
# the object boots in a known state with no executable code and with no
# reliance on an initial event.  FlyingK carries the 2100 sentinel and is not
# active.
#
# (This file deliberately never names the forbidden nodes it is avoiding.  The
# Mall uploader and WRLForge's validator both SUBSTRING-match, so a banned node
# named in a prose comment fails validation exactly as if it had been used.
# The reasoning lives in build-pocket-drone-port.py, which is not uploaded.)
#
# A disabled TouchSensor emits NOTHING, which is why the state is held here
# rather than by gating relay clocks: a static ROUTE cannot be aimed, so a
# touchTime would reach both relays and the disabled one would silently store a
# startTime it fires on the moment it is enabled.
#
# Between the two of them, LAUNCH is live only while the drone is docked and
# DOCK is live only while it is flying.  During either 4.5 s sequence NEITHER
# is enabled, which is what structurally prevents a second launch overlapping
# the first, a DOCK press throwing the drone upward mid-ascent, or a LAUNCH
# press resetting a descent half way down.
DEF DockedK TimeSensor { cycleInterval 1000000000 loop TRUE }
DEF FlyingK TimeSensor { cycleInterval 1000000000 loop TRUE startTime 4102444800 }
ROUTE DockedK.isActive TO LaunchTouch.set_enabled
ROUTE FlyingK.isActive TO DockTouch.set_enabled

# =========================================================================
# CLOCKS
# =========================================================================
# Each sequence needs TWO nodes.  A `loop FALSE` clock ends at fraction 1.0 and
# HOLDS the pose, which is what keeps the drone in the air after the launch --
# but it emits no usable end event, because Cybertown's production X_ITE 4.7.0
# does not emit the eventOut a TimeSensor is supposed to produce the instant it
# becomes active.  A `loop TRUE` clock routed to its own stopTime runs exactly
# one cycle and DOES emit an end event at the cycle boundary, but at its wrap
# it emits fraction 0 and would snap every interpolator back to key 0.
#
# So: one of each.  The Clock drives the motion, the Guard supplies the event.
#
# Both `loop FALSE` clocks carry the DEFAULT startTime, which is 1970: a
# one-shot whose eligibility window closed decades before load, so neither has
# run when the world opens.  That is the one place a past startTime is exactly
# right.
DEF LaunchClock TimeSensor { cycleInterval 4.5 loop FALSE }
DEF LaunchGuard TimeSensor { cycleInterval 4.5 loop TRUE startTime 4102444800 }
ROUTE LaunchGuard.cycleTime TO LaunchGuard.set_stopTime

DEF DockClock TimeSensor { cycleInterval 4.5 loop FALSE }
DEF DockGuard TimeSensor { cycleInterval 4.5 loop TRUE startTime 4102444800 }
ROUTE DockGuard.cycleTime TO DockGuard.set_stopTime

# The hover beat.  120 degrees per cycle on a 3-fold body, so a full revolution
# takes 13.5 s and every cycle boundary is the home pose.
DEF HoverClock TimeSensor { cycleInterval 4.5 loop TRUE startTime 4102444800 }

# The rotor spin.  A short, fast, free-running loop -- it does NOT have to park
# on a symmetry the way the hover does, because a stopped rotor may rest at any
# angle.  It carries the future sentinel startTime, so it is OFF at load; LAUNCH
# spins it up for the WHOLE airborne period (ascent, hover and descent) and it
# freezes when the dock sequence fully completes.  Driving it by startTime/
# stopTime -- the same idiom the guards use -- rather than an isActive relay
# avoids any dependence on the order of two booleans at the launch/hover seam.
DEF RotorClock TimeSensor { cycleInterval 0.7 loop TRUE startTime 4102444800 }
ROUTE LaunchTouch.touchTime TO RotorClock.set_startTime
ROUTE DockGuard.cycleTime   TO RotorClock.set_stopTime

# =========================================================================
# THE BEAT-ALIGNED STOP
# =========================================================================
# DOCK does not stop the hover.  It arms DockLatch; the latch enables
# HoverStop; the hover's next cycleTime starts HoverStop; HoverStop stops the
# hover and starts the descent.  The hover therefore always freezes at
# fraction 0, which on a 3-fold body is exactly the pose it started from.
# Stopping the clock straight from the touch would freeze the drone at an
# arbitrary angle -- measured elsewhere in this repo at 138 degrees of snap on
# the next start.
DEF DockLatch TimeSensor { cycleInterval 1 loop TRUE startTime 4102444800 }
DEF HoverStop TimeSensor { cycleInterval 0.01 loop TRUE enabled FALSE startTime 4102444800 }
ROUTE DockLatch.isActive    TO HoverStop.set_enabled
ROUTE HoverClock.cycleTime  TO HoverStop.set_startTime
ROUTE HoverStop.cycleTime   TO HoverClock.set_stopTime
ROUTE HoverStop.cycleTime   TO DockLatch.set_stopTime
ROUTE HoverStop.cycleTime   TO HoverStop.set_stopTime
ROUTE HoverStop.cycleTime   TO DockClock.set_startTime
ROUTE HoverStop.cycleTime   TO DockGuard.set_startTime

# =========================================================================
# THE TOUCH WIRING
# =========================================================================
# LAUNCH: run the sequence, and take LAUNCH itself out of service immediately.
# DOCK is still out of service, so the 4.5 s ascent cannot be interrupted into
# an invalid state.
ROUTE LaunchTouch.touchTime TO LaunchClock.set_startTime
ROUTE LaunchTouch.touchTime TO LaunchGuard.set_startTime
ROUTE LaunchTouch.touchTime TO DockedK.set_stopTime
# Clearing the stop latch on every launch is easy to leave out and matters: an
# armed latch would still be armed the next time the hover started, and its
# very first beat would stop it again.
ROUTE LaunchTouch.touchTime TO DockLatch.set_stopTime
ROUTE LaunchTouch.touchTime TO HoverStop.set_stopTime

# The ascent finishes: DOCK comes into service and the hover begins.
ROUTE LaunchGuard.cycleTime TO FlyingK.set_startTime
ROUTE LaunchGuard.cycleTime TO HoverClock.set_startTime

# DOCK: take DOCK out of service and arm the beat-aligned stop.
ROUTE DockTouch.touchTime TO FlyingK.set_stopTime
ROUTE DockTouch.touchTime TO DockLatch.set_startTime
# REQUIRED.  HoverStop.startTime is refreshed on EVERY HoverClock.cycleTime
# regardless of `enabled`, so by the time DockLatch arms it mid-beat that
# startTime is already up to a whole beat stale, and `loop TRUE` has no
# eligibility window to discard it.  Without this route HoverStop fires on the
# stale value the instant it is armed and parks the drone at a random mid-beat
# angle -- 0.77 rad, 44 degrees, measured on a sibling item.
ROUTE DockTouch.touchTime TO HoverStop.set_stopTime

# The descent finishes: LAUNCH comes back into service.  Nothing else does --
# the drone is home, every layer is back at identity, and the next launch
# starts from exactly the pose the first one did.
ROUTE DockGuard.cycleTime TO DockedK.set_startTime

# =========================================================================
# MOTION
# =========================================================================
DEF LaunchPath PositionInterpolator {
  key [ 0.0000, 0.1110, 0.2000, 0.3500, 0.5500, 0.7200, 0.8600, 0.9600, 1.0000 ]
  keyValue [ 0 0 0, 0 0 0, 0 0.045 0, 0 0.24 0, 0 0.56 0, 0 0.78 0, 0 0.878 0, 0 0.9 0, 0 0.9 0 ] }
DEF LaunchTurn OrientationInterpolator {
