#VRML V2.0 utf8
# Pocket Drone Port -- an original compact service-drone docking station for
# the Cybertown Revival Mall.  Generated by build-pocket-drone-port.py;
# edit that, not this.
#
# Touch LAUNCH to fly the drone; touch DOCK to land it.  Both keys sit side by
# side on one raked fascia at the front of the port, so a visitor reaches
# either from the same place -- and the three docking clamps are at azimuth
# 180, 60 and 300 degrees, which leaves the +Z quadrant the controls face with
# nothing in it.
#
# The drone is THREE-FOLD SYMMETRIC and the hover turns exactly 120 degrees
# per 4.5 s cycle.  A VRML97 TimeSensor cannot resume mid-cycle, so a rotation
# stopped at an arbitrary fraction parks at an arbitrary angle and the next
# start snaps back to zero.  Turning through exactly one of the body's own
# symmetries per cycle makes every beat boundary indistinguishable from home,
# so the loop is seamless, the park is exact, and repeated launch/dock cycles
# accumulate no drift at all.
#
# Nothing runs at load.

WorldInfo {
  title "Pocket Drone Port II"
  info [
    "Made By: BassMekanik"
    "Uploaded: September, 2026"
    "Category: Electronics"
    "Limited To: UNLIMITED"
    "Mall Price: 50 CC"
    "Touch LAUNCH to fly the drone. Touch DOCK to land it."
  ]
}

# ========================================================= object
Transform { translation 0 -1.75 0
  children [
    # octagonal chassis, 1.30 m across and 1.10 m deep
    # dark blue-grey chassis
    Shape { appearance DEF ABase Appearance { material DEF MBase Material {
            diffuseColor 0.080 0.100 0.130 specularColor 0.17 0.19 0.22
            shininess 0.24 ambientIntensity 0.22 } } geometry IndexedFaceSet {
