      creaseAngle 0.5
      coord Coordinate { point [ -0.2 0.209 0.32 0.2 0.209 0.32 0.2 0.209 0.5 -0.2 0.209 0.5 -0.2 0.272 0.32 -0.2 0.232 0.5 0.2 0.232 0.5 0.2 0.272 0.32 ] }
