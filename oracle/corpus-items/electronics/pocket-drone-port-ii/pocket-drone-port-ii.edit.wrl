    } }
    # dock status lamp: green docked, amber moving, cyan flying
    Shape { appearance USE ALamp geometry IndexedFaceSet {
      solid TRUE
      coord Coordinate { point [ 0.158 0.231 0.487 0.158 0.235 0.468 0.158 0.247 0.47 0.158 0.242 0.49 -0.158 0.231 0.487 -0.158 0.242 0.49 -0.158 0.247 0.47 -0.158 0.235 0.468 ] }
      coordIndex [ 0 1 2 3 -1 4 5 6 7 -1 7 6 2 1 -1 4 0 3 5 -1 5 3 2 6 -1 4 7 1 0 -1 ]
    } }
    Group { children [
      # LAUNCH -- its own Group, so the sensor covers this cap and nothing else
      DEF LaunchTouch TouchSensor { description "LAUNCH the drone" }
      # LAUNCH key cap
      Shape { appearance USE AHousing geometry IndexedFaceSet {
        solid TRUE
        creaseAngle 0.5
        coord Coordinate { point [ -0.026 0.245 0.443 -0.026 0.259 0.377 -0.026 0.279 0.381 -0.026 0.264 0.448 -0.166 0.245 0.443 -0.166 0.264 0.448 -0.166 0.279 0.381 -0.166 0.259 0.377 ] }
        coordIndex [ 0 1 2 3 -1 4 5 6 7 -1 7 6 2 1 -1 4 0 3 5 -1 5 3 2 6 -1 4 7 1 0 -1 ]
      } }
      # LAUNCH legend
      # printed panel artwork, from the one atlas
      Shape { appearance DEF ATex Appearance {
              material Material { diffuseColor 1 1 1 specularColor 0.15 0.16 0.18
                shininess 0.22 ambientIntensity 0 }
              texture DEF TAtlas ImageTexture { url "pocket-drone-atlas.jpg" } } geometry IndexedFaceSet {
        solid TRUE
        coord Coordinate { point [ -0.157 0.28 0.389 -0.157 0.268 0.441 -0.035 0.268 0.441 -0.035 0.28 0.389 ] }
        coordIndex [ 0 1 2 3 -1 ]
        texCoord TextureCoordinate { point [ 0.02000 0.50156 0.02000 0.41250 0.46437 0.41250 0.46437 0.50156 ] }
        texCoordIndex [ 0 1 2 3 -1 ]
      } }
    ] }
    Group { children [
      # DOCK -- its own Group, so the sensor covers this cap and nothing else
      DEF DockTouch TouchSensor { description "DOCK the drone" enabled FALSE }
      # DOCK key cap
      Shape { appearance USE AHousing geometry IndexedFaceSet {
        solid TRUE
        creaseAngle 0.5
        coord Coordinate { point [ 0.166 0.245 0.443 0.166 0.259 0.377 0.166 0.279 0.381 0.166 0.264 0.448 0.026 0.245 0.443 0.026 0.264 0.448 0.026 0.279 0.381 0.026 0.259 0.377 ] }
        coordIndex [ 0 1 2 3 -1 4 5 6 7 -1 7 6 2 1 -1 4 0 3 5 -1 5 3 2 6 -1 4 7 1 0 -1 ]
      } }
      # DOCK legend
      Shape { appearance USE ATex geometry IndexedFaceSet {
        solid TRUE
        coord Coordinate { point [ 0.035 0.28 0.389 0.035 0.268 0.441 0.157 0.268 0.441 0.157 0.28 0.389 ] }
        coordIndex [ 0 1 2 3 -1 ]
        texCoord TextureCoordinate { point [ 0.02000 0.37656 0.02000 0.28750 0.46437 0.28750 0.46437 0.37656 ] }
        texCoordIndex [ 0 1 2 3 -1 ]
      } }
    ] }
    # every static printed panel: the bay ring, the deck field, the nameplate and two flank louvre panels, in ONE IndexedFaceSet
