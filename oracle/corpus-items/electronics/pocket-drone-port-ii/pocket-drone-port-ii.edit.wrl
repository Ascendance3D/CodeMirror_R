    } }
    # The three clamps are ONE assembly, drawn once and placed by rotation
    # about +Y -- never by a mirror, which would invert winding and render
    # the whole part black in one of the two engines this repo tests in.
    Transform { rotation 0 1 0 3.142
      children [
        DEF DockClamp Group { children [
          DEF ClampHinge Transform { center 0 0.134 0.25 rotation 1 0 0 0
            children [
              # docking clamp, drawn once and placed three times at 120 degrees
              Shape { appearance USE AHousing geometry IndexedFaceSet {
                solid TRUE
                creaseAngle 0.5
                coord Coordinate { point [ 0.048 0.134 0.224 0.048 0.176 0.224 0.048 0.176 0.276 0.048 0.134 0.276 -0.048 0.134 0.224 -0.048 0.134 0.276 -0.048 0.176 0.276 -0.048 0.176 0.224 ] }
