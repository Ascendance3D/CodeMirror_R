ROUTE LaunchClock.fraction_changed TO LaunchPath.set_fraction
ROUTE LaunchPath.value_changed TO Lift.set_translation
ROUTE LaunchClock.fraction_changed TO LaunchTurn.set_fraction
ROUTE LaunchTurn.value_changed TO Turn.set_rotation
ROUTE DockClock.fraction_changed TO DockPath.set_fraction
ROUTE DockPath.value_changed TO Lift.set_translation
ROUTE DockClock.fraction_changed TO DockTurn.set_fraction
ROUTE DockTurn.value_changed TO Turn.set_rotation
ROUTE HoverClock.fraction_changed TO HoverTurn.set_fraction
ROUTE HoverTurn.value_changed TO Spin.set_rotation
ROUTE HoverClock.fraction_changed TO HoverBob.set_fraction
ROUTE HoverBob.value_changed TO Lift.set_translation
ROUTE RotorClock.fraction_changed TO RotorTurn.set_fraction
ROUTE RotorTurn.value_changed TO RotorSpin.set_rotation
ROUTE LaunchClock.fraction_changed TO LaunchClampSwing.set_fraction
ROUTE LaunchClampSwing.value_changed TO ClampHinge.set_rotation
ROUTE DockClock.fraction_changed TO DockClampSwing.set_fraction
ROUTE DockClampSwing.value_changed TO ClampHinge.set_rotation
ROUTE LaunchClock.fraction_changed TO LaunchRotor.set_fraction
ROUTE LaunchRotor.value_changed TO MRotor.set_emissiveColor
ROUTE LaunchClock.fraction_changed TO LaunchBand.set_fraction
ROUTE LaunchBand.value_changed TO MBand.set_emissiveColor
ROUTE LaunchClock.fraction_changed TO LaunchLamp.set_fraction
ROUTE LaunchLamp.value_changed TO MLamp.set_emissiveColor
ROUTE LaunchClock.fraction_changed TO LaunchPad.set_fraction
ROUTE LaunchPad.value_changed TO MPad.set_emissiveColor
ROUTE HoverClock.fraction_changed TO HoverPulse.set_fraction
ROUTE HoverPulse.value_changed TO MRotor.set_emissiveColor
ROUTE DockClock.fraction_changed TO DockRotor.set_fraction
ROUTE DockRotor.value_changed TO MRotor.set_emissiveColor
ROUTE DockClock.fraction_changed TO DockBand.set_fraction
ROUTE DockBand.value_changed TO MBand.set_emissiveColor
ROUTE DockClock.fraction_changed TO DockLamp.set_fraction
ROUTE DockLamp.value_changed TO MLamp.set_emissiveColor
ROUTE DockClock.fraction_changed TO DockPad.set_fraction
ROUTE DockPad.value_changed TO MPad.set_emissiveColor
