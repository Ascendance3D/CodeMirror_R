#VRML V2.0 utf8
# Flux Tape Deck -- an original retro-future data recorder for the Cybertown
# Revival Mall.  Generated by build-flux-tape-deck.py; edit that, not this.
#
# Touch PLAY to run the transport, STOP to halt it.  Both keys sit side by side
# on the front face at chest height, so one viewpoint reaches both.

WorldInfo {
  title "Flux Tape Deck"
  info [
    "Made By: BassMekanik"
    "Uploaded: September, 2026"
    "Category: Electronics"
    "Limited To: UNLIMITED"
    "Mall Price: 65 CC"
    "Touch PLAY to run the reels. Touch STOP to halt them."
  ]
}


