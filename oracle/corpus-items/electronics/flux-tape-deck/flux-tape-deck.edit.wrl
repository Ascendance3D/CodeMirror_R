    # ------------------------------------------------------------------- Play
    # A live control owns a Group holding ONLY its sensor, its key and its lamp,
    # so the pick region is that key and nothing else.  A TouchSensor loose in a
    # large children list makes the whole group clickable.
    Group {
      children [
        DEF PlayTouch TouchSensor { description "PLAY - run the reels" }
        Shape { appearance USE AAlloy geometry IndexedFaceSet {
          solid TRUE
          creaseAngle 0.5
          coord Coordinate { point [ -0.062 0.7 0.2 -0.062 0.822 0.2 -0.062 0.822 0.25 -0.062 0.7 0.25 -0.262 0.7 0.2 -0.262 0.7 0.25 -0.262 0.822 0.25 -0.262 0.822 0.2 ] }
          coordIndex [ 0 1 2 3 -1 4 5 6 7 -1 7 6 2 1 -1 4 0 3 5 -1 5 3 2 6 -1 4 7 1 0 -1 ]
        } }
        Shape { appearance USE ATex geometry IndexedFaceSet {
          solid TRUE
          coord Coordinate { point [ -0.262 0.7 0.252 -0.062 0.7 0.252 -0.062 0.822 0.252 -0.262 0.822 0.252 ] }
          coordIndex [ 0 1 2 3 -1 ]
          texCoord TextureCoordinate { point [ 0.01074 0.18262 0.30176 0.18262 0.30176 0.36426 0.01074 0.36426 ] }
          texCoordIndex [ 0 1 2 3 -1 ]
        } }
        # PLAY lamp, dark until the deck runs
        Shape { appearance DEF ALampPlay Appearance { material DEF MLampPlay Material {
            diffuseColor 0.035 0.075 0.045 emissiveColor 0.030 0.160 0.060
            specularColor 0.14 0.20 0.16 shininess 0.35 ambientIntensity 0.05 } } geometry IndexedFaceSet {
