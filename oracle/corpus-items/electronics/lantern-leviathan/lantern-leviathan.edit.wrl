    }
    DEF POWER_CLOCK TimeSensor { cycleInterval 2.2 loop FALSE startTime 0 stopTime 0 }
    DEF POWER_LOGIC Script {
      eventIn SFTime touch
      eventIn SFFloat fraction
      eventIn SFBool clockActive
      eventOut SFTime startClock
      eventOut SFFloat pose
      field SFBool isOn FALSE
      field SFBool busy FALSE
      field SFBool turningOn FALSE
      url [ "ecmascript:
function touch(v, t) { if (busy) return; busy = true; turningOn = !isOn; startClock = v; }
function fraction(f, t) { pose = turningOn ? f : 1 - f; }
function clockActive(a, t) { if (!a && busy) { isOn = turningOn; busy = false; pose = isOn ? 1 : 0; } }"
      "castlescript:
function touch(v, t)
  when(not(busy), busy := true; turningOn := not(isOn); startClock := v)
function fraction(f, t)
  pose := if(turningOn, f, 1 - f)
function clockActive(a, t)
  when(and(not(a), busy), isOn := turningOn; busy := false; pose := if(isOn, 1.0, 0.0))" ]
    }
    DEF SWING_LOWER OrientationInterpolator {
      key [ 0, 0.13, 0.26, 0.39, 0.52, 0.65, 1 ]
      keyValue [ 0 -0.9768 0.2142 0, 0 -0.9768 0.2142 0.0908, 0 -0.9768 0.2142 0.3072, 0 -0.9768 0.2142 0.5655, 0 -0.9768 0.2142 0.7819, 0 -0.9768 0.2142 0.8727, 0 -0.9768 0.2142 0.8727 ]
    }
    DEF SWING_MIDDLE OrientationInterpolator {
      key [ 0, 0.15, 0.284, 0.418, 0.552, 0.686, 0.82, 1 ]
      keyValue [ 0 -0.9887 0.15 0, 0 -0.9887 0.15 0, 0 -0.9887 0.15 0.1125, 0 -0.9887 0.15 0.3809, 0 -0.9887 0.15 0.7012, 0 -0.9887 0.15 0.9696, 0 -0.9887 0.15 1.0821, 0 -0.9887 0.15 1.0821 ]
    }
    DEF SWING_UPPER OrientationInterpolator {
      key [ 0, 0.3, 0.44, 0.58, 0.72, 0.86, 1 ]
      keyValue [ 0 -0.9657 -0.2598 0, 0 -0.9657 -0.2598 0, 0 -0.9657 -0.2598 0.098, 0 -0.9657 -0.2598 0.3318, 0 -0.9657 -0.2598 0.6107, 0 -0.9657 -0.2598 0.8445, 0 -0.9657 -0.2598 0.9425 ]
    }
    DEF GLOW_MEMB ColorInterpolator {
      key [ 0, 0.25, 0.55, 1 ]
      keyValue [ 0.26 0.19 0.09, 0.413 0.3115 0.1575, 0.515 0.3925 0.2025, 0.6 0.46 0.24 ]
    }
    DEF GLOW_EYES ColorInterpolator {
      key [ 0, 0.25, 0.55, 1 ]
      keyValue [ 0.56 0.34 0.1, 0.758 0.538 0.235, 0.89 0.67 0.325, 1 0.78 0.4 ]
    }
  ]
}

ROUTE POWER_TOUCH.touchTime TO POWER_LOGIC.touch
ROUTE POWER_LOGIC.startClock TO POWER_CLOCK.set_startTime
ROUTE POWER_CLOCK.fraction_changed TO POWER_LOGIC.fraction
ROUTE POWER_CLOCK.isActive TO POWER_LOGIC.clockActive
ROUTE POWER_LOGIC.pose TO SWING_LOWER.set_fraction
ROUTE POWER_LOGIC.pose TO SWING_MIDDLE.set_fraction
ROUTE POWER_LOGIC.pose TO SWING_UPPER.set_fraction
ROUTE POWER_LOGIC.pose TO GLOW_MEMB.set_fraction
ROUTE POWER_LOGIC.pose TO GLOW_EYES.set_fraction
ROUTE SWING_LOWER.value_changed TO BANK_LOWER.set_rotation
ROUTE SWING_LOWER.value_changed TO BANK_LOWER_MIRROR.set_rotation
ROUTE SWING_MIDDLE.value_changed TO BANK_MIDDLE.set_rotation
ROUTE SWING_MIDDLE.value_changed TO BANK_MIDDLE_MIRROR.set_rotation
ROUTE SWING_UPPER.value_changed TO BANK_UPPER.set_rotation
ROUTE SWING_UPPER.value_changed TO BANK_UPPER_MIRROR.set_rotation
ROUTE GLOW_MEMB.value_changed TO MAT_MEMB.set_emissiveColor
ROUTE GLOW_EYES.value_changed TO MAT_EYE.set_emissiveColor
