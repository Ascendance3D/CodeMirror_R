#VRML V2.0 utf8
# Pulse Prism Console -- an original three-prism signal receiver for the
# Cybertown Revival Mall.  Generated by build-pulse-prism-console.py;
# edit that, not this.
#
# Touch START to run the prism array, STOP to halt it.  Both keys sit side by
# side on the raked control deck at the front, so one viewpoint reaches both.

WorldInfo {
  title "Pulse Prism Console"
  info [
    "Made By: BassMekanik"
    "Uploaded: September, 2026"
    "Category: Electronics"
    "Limited To: 30"
    "Mall Price: 100 CC"
    "Touch START to run the three prisms. Touch STOP to halt them."
  ]
}


