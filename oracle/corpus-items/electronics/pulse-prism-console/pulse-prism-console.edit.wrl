# SIGNAL SYSTEM -- one clock, no Script node
# =========================================================================
# Beat is the only clock the visitor sees.  startTime is the 2100-01-01
# sentinel, so the console is genuinely idle at load; startTime 1 would be
# 1970-01-01 and would run from the moment the world opens.
DEF Beat TimeSensor { cycleInterval 1.6 loop TRUE startTime 4102444800 }

# STOP is beat-aligned.  StopLatch arms on the press; StopRelay is enabled only
# while that latch is up and is restarted by every Beat.cycleTime, so the first
# beat AFTER the press stops the clock at fraction 0 -- which is a rotational
# symmetry of all three prisms and the rest pose of every pulse.  Stopping the
# clock straight from the touch would freeze the prisms at an arbitrary angle
# and the next START would snap them back to zero.
#
# CTR X_ITE-4.7.0 COMPATIBILITY (2026-09-03): StartRelay and StopRelay used to
# be `loop FALSE` one-shot relays whose ONLY job was to turn a touchTime/
# cycleTime into a cycleTime pulse one frame later.  That design depended on
# the eventOut a TimeSensor emits the INSTANT it becomes active -- cycleTime
# equal to startTime.  Modern X_ITE (15.1.10) emits that initial event; CTR's
# production X_ITE 4.7.0 does not, so the relay started but its cycleTime
# ROUTE never fired, and Beat never started.  Both relays are now `loop TRUE`
# with a real 0.01 s cycleInterval instead: they wait for their first REAL
# cycle boundary -- an event X_ITE 4.7.0 does emit -- and use that pulse to
# both drive the next node AND stop themselves (set_stopTime from their own
# cycleTime), so each relay still fires exactly once per activation.  See
# AGENTS.md "Cybertown Mall X_ITE 4.7.0 timer compatibility repair".
#
# `loop TRUE` on its own is NOT safe with the default startTime (0, i.e.
# 1970-01-01, always in the past by load time).  A `loop FALSE` one-shot with
# a past startTime never activates, because its eligibility window closes
# long before any real load -- that was silently load-bearing in the old
# design.  `loop TRUE` has no such window: once past startTime it is eligible
# forever, so BOTH relays got a `startTime 4102444800` sentinel too, same as
# Beat and StopLatch.  Missing this made every item auto-play at load with
# zero clicks -- caught by the idle-load QA step, not by inspection.
DEF StopLatch TimeSensor { cycleInterval 1 loop TRUE startTime 4102444800 }
DEF StopRelay TimeSensor { cycleInterval 0.01 loop TRUE enabled FALSE startTime 4102444800 }
ROUTE StopLatch.isActive TO StopRelay.set_enabled
ROUTE Beat.cycleTime     TO StopRelay.set_startTime
ROUTE StopRelay.cycleTime TO Beat.set_stopTime
ROUTE StopRelay.cycleTime TO StopLatch.set_stopTime
ROUTE StopRelay.cycleTime TO StopRelay.set_stopTime
# StopRelay.startTime is refreshed on EVERY Beat.cycleTime regardless of
# `enabled`, so by the time StopLatch arms it mid-beat, that startTime is
# already up to one whole beat stale.  `loop FALSE` used to make that harmless
# -- its 0.001 s eligibility window had almost always already closed by then,
# so it silently waited for a truly FRESH set_startTime.  `loop TRUE` has no
# such window (once past startTime it stays eligible forever), so without
# this route StopRelay fires on the STALE startTime the instant it is armed,
# stopping Beat at a random mid-beat fraction instead of the next real beat --
# measured 0.77 rad (44 deg) of drift on the sibling Flux Tape Deck rig, big
# enough to hop visibly on the following START.  Routing the STOP press's own
# touchTime into set_stopTime invalidates that stale window (stopTime ==
# "now" > stale startTime, so `loop TRUE`'s "eligible forever" reading of the
# stale value is cut off); the NEXT real Beat.cycleTime then gives a
# startTime later than this stopTime, which VRML97 re-arms as a fresh cycle.
ROUTE StopTouch.touchTime TO StopRelay.set_stopTime

# START goes through a relay so the restart lands in a strictly later event
# cascade than the stop-latch teardown above it.  Routed direct, the clock can
# emit cycleTime into a latch that has not been torn down yet and stop itself
# on the very frame the visitor pressed START.
DEF StartRelay TimeSensor { cycleInterval 0.01 loop TRUE startTime 4102444800 }
ROUTE StartTouch.touchTime TO StopLatch.set_stopTime
ROUTE StartTouch.touchTime TO StartRelay.set_startTime
ROUTE StartRelay.cycleTime TO Beat.set_startTime
ROUTE StartRelay.cycleTime TO StartRelay.set_stopTime
ROUTE StopTouch.touchTime  TO StopLatch.set_startTime

# Lamp cross-fade.  Both clocks are loop FALSE, so each holds its final colour,
# and neither has run at load -- the Materials keep the stopped pose they were
# authored with.  Both ramps hold hue constant, because a ColorInterpolator
# interpolates in HSV and a fade toward black desaturates on the way.
DEF LampUp TimeSensor { cycleInterval 0.28 loop FALSE }
DEF LampDn TimeSensor { cycleInterval 0.28 loop FALSE }
ROUTE StartTouch.touchTime TO LampUp.set_startTime
ROUTE StopTouch.touchTime  TO LampDn.set_startTime

DEF StartGlow ColorInterpolator { key [ 0, 1 ]
  keyValue [ 0.030 0.160 0.060, 0.150 0.950 0.350 ] }
DEF StartFade ColorInterpolator { key [ 0, 1 ]
  keyValue [ 0.150 0.950 0.350, 0.030 0.160 0.060 ] }
DEF StopFade ColorInterpolator { key [ 0, 1 ]
  keyValue [ 0.900 0.160 0.120, 0.200 0.036 0.027 ] }
DEF StopGlow ColorInterpolator { key [ 0, 1 ]
  keyValue [ 0.200 0.036 0.027, 0.900 0.160 0.120 ] }
ROUTE LampUp.fraction_changed TO StartGlow.set_fraction
ROUTE LampUp.fraction_changed TO StopFade.set_fraction
ROUTE LampDn.fraction_changed TO StartFade.set_fraction
ROUTE LampDn.fraction_changed TO StopGlow.set_fraction
ROUTE StartGlow.value_changed TO MStartLamp.set_emissiveColor
ROUTE StartFade.value_changed TO MStartLamp.set_emissiveColor
ROUTE StopGlow.value_changed  TO MStopLamp.set_emissiveColor
ROUTE StopFade.value_changed  TO MStopLamp.set_emissiveColor

# ------------------------------------------------------------- prism motion
# Each prism sweeps exactly 360/facets degrees per beat, so one beat is a
# symmetry of that prism.  Different facet counts and one opposite sign give
# three different rates and two different directions out of ONE clock.
DEF TurnP1 OrientationInterpolator {
  key [ 0.00, 0.25, 0.50, 0.75, 1.00 ]
  keyValue [ 0 1 0 0.00000, 0 1 0 0.19635, 0 1 0 0.39270, 0 1 0 0.58905, 0 1 0 0.78540 ] }
DEF TurnP2 OrientationInterpolator {
  key [ 0.00, 0.25, 0.50, 0.75, 1.00 ]
  keyValue [ 0 1 0 -0.00000, 0 1 0 -0.26180, 0 1 0 -0.52360, 0 1 0 -0.78540, 0 1 0 -1.04720 ] }
DEF TurnP3 OrientationInterpolator {
  key [ 0.00, 0.25, 0.50, 0.75, 1.00 ]
  keyValue [ 0 1 0 0.00000, 0 1 0 0.39270, 0 1 0 0.78540, 0 1 0 1.17810, 0 1 0 1.57080 ] }
ROUTE Beat.fraction_changed TO TurnP1.set_fraction
ROUTE TurnP1.value_changed TO SpinP1.set_rotation
ROUTE Beat.fraction_changed TO TurnP2.set_fraction
ROUTE TurnP2.value_changed TO SpinP2.set_rotation
ROUTE Beat.fraction_changed TO TurnP3.set_fraction
ROUTE TurnP3.value_changed TO SpinP3.set_rotation

# ------------------------------------------------------------- signal pulse
DEF Pulse1 ColorInterpolator {
  key [ 0, 0.05, 0.085, 0.160, 0.235, 0.95, 1 ]
  keyValue [ 0.048 0.150 0.176, 0.048 0.150 0.176, 0.110 0.470 0.530, 0.220 0.900 0.980, 0.110 0.470 0.530, 0.048 0.150 0.176, 0.048 0.150 0.176 ] }
ROUTE Beat.fraction_changed TO Pulse1.set_fraction
ROUTE Pulse1.value_changed TO MBar1.set_emissiveColor
DEF Pulse2 ColorInterpolator {
  key [ 0, 0.05, 0.275, 0.350, 0.425, 0.95, 1 ]
  keyValue [ 0.048 0.150 0.176, 0.048 0.150 0.176, 0.110 0.470 0.530, 0.220 0.900 0.980, 0.110 0.470 0.530, 0.048 0.150 0.176, 0.048 0.150 0.176 ] }
ROUTE Beat.fraction_changed TO Pulse2.set_fraction
ROUTE Pulse2.value_changed TO MBar2.set_emissiveColor
DEF Pulse3 ColorInterpolator {
  key [ 0, 0.05, 0.465, 0.540, 0.615, 0.95, 1 ]
  keyValue [ 0.048 0.150 0.176, 0.048 0.150 0.176, 0.110 0.470 0.530, 0.220 0.900 0.980, 0.110 0.470 0.530, 0.048 0.150 0.176, 0.048 0.150 0.176 ] }
ROUTE Beat.fraction_changed TO Pulse3.set_fraction
ROUTE Pulse3.value_changed TO MBar3.set_emissiveColor
DEF Pulse4 ColorInterpolator {
  key [ 0, 0.05, 0.655, 0.730, 0.805, 0.95, 1 ]
  keyValue [ 0.048 0.150 0.176, 0.048 0.150 0.176, 0.110 0.470 0.530, 0.220 0.900 0.980, 0.110 0.470 0.530, 0.048 0.150 0.176, 0.048 0.150 0.176 ] }
ROUTE Beat.fraction_changed TO Pulse4.set_fraction
ROUTE Pulse4.value_changed TO MBar4.set_emissiveColor

# -------------------------------------------------------------- prism glow
DEF GlowA ColorInterpolator {
  key [ 0, 0.06, 0.42, 0.94, 1 ]
  keyValue [ 0.070 0.210 0.240, 0.070 0.210 0.240, 0.170 0.720 0.820, 0.070 0.210 0.240, 0.070 0.210 0.240 ] }
ROUTE Beat.fraction_changed TO GlowA.set_fraction
ROUTE GlowA.value_changed TO MFacetA.set_emissiveColor
DEF GlowB ColorInterpolator {
  key [ 0, 0.06, 0.56, 0.94, 1 ]
  keyValue [ 0.130 0.096 0.230, 0.130 0.096 0.230, 0.330 0.240 0.860, 0.130 0.096 0.230, 0.130 0.096 0.230 ] }
ROUTE Beat.fraction_changed TO GlowB.set_fraction
ROUTE GlowB.value_changed TO MFacetB.set_emissiveColor
DEF GlowC ColorInterpolator {
  key [ 0, 0.06, 0.70, 0.94, 1 ]
  keyValue [ 0.220 0.140 0.050, 0.220 0.140 0.050, 0.820 0.560 0.170, 0.220 0.140 0.050, 0.220 0.140 0.050 ] }
ROUTE Beat.fraction_changed TO GlowC.set_fraction
ROUTE GlowC.value_changed TO MFacetC.set_emissiveColor

# ------------------------------------------------------------- status sweep
# Same dwell trick, so the bar parks at the left end of its window when the
# console is stopped instead of freezing part way across.
DEF ScanSlide PositionInterpolator { key [ 0, 0.06, 0.5, 0.94, 1 ]
  keyValue [ -0.08 0 0, -0.08 0 0, 0.08 0 0, -0.08 0 0, -0.08 0 0 ] }
ROUTE Beat.fraction_changed TO ScanSlide.set_fraction
ROUTE ScanSlide.value_changed TO ScanBar.set_translation

