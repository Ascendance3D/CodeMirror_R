      # Leaf 1, at azimuth 90 degrees.  The six leaves are placed by rotation
      # about +Y only -- never by a mirror, which would invert winding and render the
      # whole leaf black in one of the two engines this repo tests in.  The hinge
      # Transform is what the opening clock drives; the leaf itself never changes.
      Transform { rotation 0 1 0 1.57080
        children [
          Transform { translation 0 0.34 0.196
            children [
              DEF Hinge1 Transform { rotation 1 0 0 0
                children [
                  USE SpeakerLeaf
                ] }
            ] }
        ] }
      # Leaf 2, at azimuth 150 degrees.  The six leaves are placed by rotation
      # about +Y only -- never by a mirror, which would invert winding and render the
      # whole leaf black in one of the two engines this repo tests in.  The hinge
      # Transform is what the opening clock drives; the leaf itself never changes.
      Transform { rotation 0 1 0 2.61799
        children [
