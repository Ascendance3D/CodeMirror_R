# =========================================================================
# POWER -- one touch address, two behaviours, no Script node
# =========================================================================
# X_ITE compiles a Script's ECMAScript with `new Function()` and WRL Forge ships
# `script-src` without `'unsafe-eval'`, so a Script would never initialise and
# every ROUTE through it would be silently dead.
#
# The dome carries TWO TouchSensors and exactly one of them is ever enabled.
# The obvious alternative -- one sensor and two relay TimeSensors picked by
# `enabled` -- DOES NOT WORK: a static ROUTE cannot be aimed, so the disabled
# relay silently stores a startTime and fires the instant it is enabled.  A
# disabled TouchSensor emits nothing at all, so nothing stale is ever written.
#
# StClosed carries NO startTime, so it is 1970 -- already past -- and `loop
# TRUE` makes it ACTIVE THE MOMENT THE WORLD LOADS.  StOpen carries the 2100
# sentinel and is not.  Both `enabled` fields are AUTHORED to match, so the
# object is correct even on a browser that never delivers the initial isActive;
# only the transitions need an event, and a transition always fires.
DEF StClosed TimeSensor { cycleInterval 1000000000 loop TRUE }
DEF StOpen   TimeSensor { cycleInterval 1000000000 loop TRUE startTime 4102444800 }
ROUTE StClosed.isActive TO PowerOnTouch.set_enabled
ROUTE StOpen.isActive   TO PowerOffTouch.set_enabled

# The two travel clocks are `loop FALSE` with the DEFAULT startTime, which is
# 1970: a one-shot whose eligibility window closed decades before load, so
# neither has run when the world opens, and each holds its final pose once it
# has.  That is the one place a `loop FALSE` past startTime is exactly right.
DEF LeafOut TimeSensor { cycleInterval 1.5 loop FALSE }
DEF LeafIn  TimeSensor { cycleInterval 1.5 loop FALSE }

# The glow clock, and a BEAT-ALIGNED stop for it.  PulseLatch arms on the press;
# PulseStop is enabled only while that latch is up and is restarted by every
# Pulse.cycleTime, so the first cycle AFTER the press halts the glow at fraction
# 0 -- which is the authored dark value.  Stopping the clock straight from the
# touch would freeze the emissive part way up a ramp and leave the system
# glowing while it is switched off.
DEF Pulse      TimeSensor { cycleInterval 2.2 loop TRUE startTime 4102444800 }
DEF PulseLatch TimeSensor { cycleInterval 1 loop TRUE startTime 4102444800 }
DEF PulseStop  TimeSensor { cycleInterval 0.01 loop TRUE enabled FALSE startTime 4102444800 }
DEF PulseStart TimeSensor { cycleInterval 0.01 loop TRUE startTime 4102444800 }
ROUTE PulseLatch.isActive TO PulseStop.set_enabled
ROUTE Pulse.cycleTime     TO PulseStop.set_startTime
ROUTE PulseStop.cycleTime TO Pulse.set_stopTime
ROUTE PulseStop.cycleTime TO PulseLatch.set_stopTime
ROUTE PulseStop.cycleTime TO PulseStop.set_stopTime
ROUTE PulseStart.cycleTime TO Pulse.set_startTime
ROUTE PulseStart.cycleTime TO PulseStart.set_stopTime

# ON: open the leaves, light the system, leave the closed state, enter the open
# one.  `PulseLatch.set_stopTime` is the one that is easy to leave out -- the
# latch armed by the previous OFF is still armed, and without clearing it the
# very first cycle of the new run would stop the glow again.
ROUTE PowerOnTouch.touchTime TO LeafOut.set_startTime
ROUTE PowerOnTouch.touchTime TO PulseStart.set_startTime
ROUTE PowerOnTouch.touchTime TO PulseLatch.set_stopTime
ROUTE PowerOnTouch.touchTime TO StClosed.set_stopTime
ROUTE PowerOnTouch.touchTime TO StOpen.set_startTime

# OFF: close the leaves, arm the beat-aligned stop for the glow, and swap the
# latches back.  Each latch's new startTime is strictly later than the stopTime
# it was given on the previous press, which is what lets the pair alternate
# indefinitely instead of latching up after one cycle.
ROUTE PowerOffTouch.touchTime TO LeafIn.set_startTime
ROUTE PowerOffTouch.touchTime TO PulseLatch.set_startTime
ROUTE PowerOffTouch.touchTime TO PulseStop.set_stopTime
ROUTE PowerOffTouch.touchTime TO StOpen.set_stopTime
ROUTE PowerOffTouch.touchTime TO StClosed.set_startTime

# ------------------------------------------------------------- leaf travel
DEF Open0 OrientationInterpolator {
  key [ 0.0000, 0.2500, 0.5000, 0.7500, 1.0000 ]
  keyValue [ 1 0 0 0.00000, 1 0 0 0.08727, 1 0 0 0.27925, 1 0 0 0.47124, 1 0 0 0.55851 ] }
DEF Shut0 OrientationInterpolator {
  key [ 0.0000, 0.2500, 0.5000, 0.7500, 1.0000 ]
  keyValue [ 1 0 0 0.55851, 1 0 0 0.47124, 1 0 0 0.27925, 1 0 0 0.08727, 1 0 0 0.00000 ] }
