  keyValue [ 0.028 0.042 0.050, 0.028 0.042 0.050, 0.224 0.336 0.400, 0.028 0.042 0.050, 0.028 0.042 0.050 ] }

ROUTE LeafOut.fraction_changed TO Open0.set_fraction
ROUTE LeafIn.fraction_changed  TO Shut0.set_fraction
ROUTE Open0.value_changed TO Hinge0.set_rotation
ROUTE Shut0.value_changed TO Hinge0.set_rotation
ROUTE LeafOut.fraction_changed TO Open1.set_fraction
ROUTE LeafIn.fraction_changed  TO Shut1.set_fraction
ROUTE Open1.value_changed TO Hinge1.set_rotation
ROUTE Shut1.value_changed TO Hinge1.set_rotation
ROUTE LeafOut.fraction_changed TO Open2.set_fraction
ROUTE LeafIn.fraction_changed  TO Shut2.set_fraction
ROUTE Open2.value_changed TO Hinge2.set_rotation
ROUTE Shut2.value_changed TO Hinge2.set_rotation
ROUTE LeafOut.fraction_changed TO Open3.set_fraction
ROUTE LeafIn.fraction_changed  TO Shut3.set_fraction
ROUTE Open3.value_changed TO Hinge3.set_rotation
ROUTE Shut3.value_changed TO Hinge3.set_rotation
ROUTE LeafOut.fraction_changed TO Open4.set_fraction
ROUTE LeafIn.fraction_changed  TO Shut4.set_fraction
ROUTE Open4.value_changed TO Hinge4.set_rotation
ROUTE Shut4.value_changed TO Hinge4.set_rotation
ROUTE LeafOut.fraction_changed TO Open5.set_fraction
ROUTE LeafIn.fraction_changed  TO Shut5.set_fraction
ROUTE Open5.value_changed TO Hinge5.set_rotation
ROUTE Shut5.value_changed TO Hinge5.set_rotation
ROUTE Pulse.fraction_changed TO PulseMGlow.set_fraction
ROUTE PulseMGlow.value_changed TO MGlow.set_emissiveColor
ROUTE Pulse.fraction_changed TO PulseMDome.set_fraction
ROUTE PulseMDome.value_changed TO MDome.set_emissiveColor
ROUTE Pulse.fraction_changed TO PulseMLeafGlow.set_fraction
ROUTE PulseMLeafGlow.value_changed TO MLeafGlow.set_emissiveColor

