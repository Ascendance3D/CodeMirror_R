DEF PulseMGlow ColorInterpolator {
  key [ 0, 0.08, 0.50, 0.92, 1 ]
  keyValue [ 0.030 0.044 0.052, 0.030 0.044 0.052, 0.240 0.352 0.416, 0.030 0.044 0.052, 0.030 0.044 0.052 ] }
DEF PulseMDome ColorInterpolator {
  key [ 0, 0.08, 0.42, 0.92, 1 ]
  keyValue [ 0.034 0.048 0.060, 0.034 0.048 0.060, 0.272 0.384 0.480, 0.034 0.048 0.060, 0.034 0.048 0.060 ] }
