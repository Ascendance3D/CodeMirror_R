DEF OnClock TimeSensor { cycleInterval 0.45 loop FALSE }
DEF OffClock TimeSensor { cycleInterval 0.45 loop FALSE }

DEF LampUp ScalarInterpolator { key [ 0, 1 ] keyValue [ 0, 0.62 ] }
DEF LampDown ScalarInterpolator { key [ 0, 1 ] keyValue [ 0.62, 0 ] }
DEF CoreUp ColorInterpolator { key [ 0, 1 ] keyValue [ 0.24 0.11 0.035, 1 0.66 0.22 ] }
DEF CoreDown ColorInterpolator { key [ 0, 1 ] keyValue [ 1 0.66 0.22, 0.24 0.11 0.035 ] }
DEF GlassUp ColorInterpolator { key [ 0, 1 ] keyValue [ 0.1 0.045 0.012, 0.46 0.22 0.06 ] }
DEF GlassDown ColorInterpolator { key [ 0, 1 ] keyValue [ 0.46 0.22 0.06, 0.1 0.045 0.012 ] }
DEF FlyUp ColorInterpolator { key [ 0, 1 ] keyValue [ 0.2 0.17 0.085, 0.98 0.88 0.44 ] }
DEF FlyDown ColorInterpolator { key [ 0, 1 ] keyValue [ 0.98 0.88 0.44, 0.2 0.17 0.085 ] }

ROUTE SunTouch.touchTime TO OnClock.startTime
ROUTE SunTouch.touchTime TO OffClock.stopTime
ROUTE MoonTouch.touchTime TO OffClock.startTime
ROUTE MoonTouch.touchTime TO OnClock.stopTime

ROUTE OnClock.fraction_changed TO LampUp.set_fraction
ROUTE OnClock.fraction_changed TO CoreUp.set_fraction
ROUTE OnClock.fraction_changed TO GlassUp.set_fraction
ROUTE OnClock.fraction_changed TO FlyUp.set_fraction
ROUTE OffClock.fraction_changed TO LampDown.set_fraction
ROUTE OffClock.fraction_changed TO CoreDown.set_fraction
ROUTE OffClock.fraction_changed TO GlassDown.set_fraction
ROUTE OffClock.fraction_changed TO FlyDown.set_fraction

ROUTE LampUp.value_changed TO Lamp.set_intensity
ROUTE CoreUp.value_changed TO CoreMat.set_emissiveColor
ROUTE GlassUp.value_changed TO GlassMat.set_emissiveColor
ROUTE FlyUp.value_changed TO FlyMat.set_emissiveColor
ROUTE LampDown.value_changed TO Lamp.set_intensity
ROUTE CoreDown.value_changed TO CoreMat.set_emissiveColor
ROUTE GlassDown.value_changed TO GlassMat.set_emissiveColor
ROUTE FlyDown.value_changed TO FlyMat.set_emissiveColor
