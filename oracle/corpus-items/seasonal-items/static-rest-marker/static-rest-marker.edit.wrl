ROUTE FwdTouch.touchTime TO FwdClock.set_startTime
ROUTE RevTouch.touchTime TO RevClock.set_startTime
ROUTE FwdClock.fraction_changed TO Tile1Fwd.set_fraction
ROUTE FwdClock.fraction_changed TO Tile2Fwd.set_fraction
ROUTE FwdClock.fraction_changed TO Tile3Fwd.set_fraction
ROUTE FwdClock.fraction_changed TO FwdGateHold.set_fraction
ROUTE FwdClock.fraction_changed TO RevGateOpen.set_fraction
ROUTE RevClock.fraction_changed TO Tile1Rev.set_fraction
ROUTE RevClock.fraction_changed TO Tile2Rev.set_fraction
ROUTE RevClock.fraction_changed TO Tile3Rev.set_fraction
ROUTE RevClock.fraction_changed TO RevGateHold.set_fraction
ROUTE RevClock.fraction_changed TO FwdGateOpen.set_fraction
ROUTE Tile1Fwd.value_changed TO Tile1.set_rotation
ROUTE Tile2Fwd.value_changed TO Tile2.set_rotation
ROUTE Tile3Fwd.value_changed TO Tile3.set_rotation
ROUTE Tile1Rev.value_changed TO Tile1.set_rotation
ROUTE Tile2Rev.value_changed TO Tile2.set_rotation
ROUTE Tile3Rev.value_changed TO Tile3.set_rotation
ROUTE FwdGateHold.value_changed TO FwdGate.set_translation
ROUTE RevGateOpen.value_changed TO RevGate.set_translation
ROUTE RevGateHold.value_changed TO RevGate.set_translation
ROUTE FwdGateOpen.value_changed TO FwdGate.set_translation
