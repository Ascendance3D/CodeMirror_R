    # Touch gates over the tile bay.  The live one sits 4 mm proud of the
    # face; the other is parked inside the solid slab, unreachable.
    DEF FwdGate Transform {
      children [
        DEF FwdTouch TouchSensor { }
        Shape {
          appearance DEF GateApp Appearance { material Material { transparency 1 } }
          geometry DEF GateBox IndexedFaceSet {
            creaseAngle 0
            coord Coordinate { point [
              -0.45 -0.715 0.184, 0.45 -0.715 0.184, -0.45 -1.125 0.184, 0.45 -1.125 0.184, 0.45 -1.125 0.192,
              -0.45 -1.125 0.192, 0.45 -0.715 0.192, -0.45 -0.715 0.192
            ] }
            coordIndex [
              0 1 2 -1, 3 2 1 -1, 2 3 4 -1, 2 4 5 -1, 3 1 6 -1, 3 6 4 -1, 1 0 7 -1, 1 7 6 -1, 0 2 5 -1, 0 5 7 -1,
              5 6 7 -1, 6 5 4 -1
            ]
          }
        }
      ]
    }
    DEF RevGate Transform {
      translation 0 0 -0.284
      children [
        DEF RevTouch TouchSensor { }
        Shape {
          appearance USE GateApp
          geometry USE GateBox
        }
      ]
    }
  ]
