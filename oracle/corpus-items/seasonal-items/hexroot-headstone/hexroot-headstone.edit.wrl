}

DEF PulseClock TimeSensor { cycleInterval 7.5 loop TRUE startTime 0 stopTime 1 }
DEF RestClock TimeSensor { cycleInterval 0.2 loop FALSE startTime 0 stopTime 1 }
DEF SigilOnePulse ColorInterpolator {
  key [ 0 0.04 0.08 0.12 0.16 0.21 0.26 0.31 0.36 1 ]
  keyValue [ 0.1 0.04 0.006, 0.19 0.094 0.019, 0.55 0.31 0.073, 0.91 0.526 0.127, 1 0.58 0.14, 0.91 0.526 0.127, 0.55 0.31 0.073, 0.19 0.094 0.019, 0.1 0.04 0.006, 0.1 0.04 0.006 ]
}
DEF SigilTwoPulse ColorInterpolator {
  key [ 0 0.2 0.24 0.28 0.32 0.36 0.41 0.46 0.51 0.56 1 ]
  keyValue [ 0.1 0.04 0.006, 0.1 0.04 0.006, 0.19 0.094 0.019, 0.55 0.31 0.073, 0.91 0.526 0.127, 1 0.58 0.14, 0.91 0.526 0.127, 0.55 0.31 0.073, 0.19 0.094 0.019, 0.1 0.04 0.006, 0.1 0.04 0.006 ]
}
DEF SigilThreePulse ColorInterpolator {
  key [ 0 0.4 0.44 0.48 0.52 0.56 0.61 0.66 0.71 0.76 1 ]
  keyValue [ 0.1 0.04 0.006, 0.1 0.04 0.006, 0.19 0.094 0.019, 0.55 0.31 0.073, 0.91 0.526 0.127, 1 0.58 0.14, 0.91 0.526 0.127, 0.55 0.31 0.073, 0.19 0.094 0.019, 0.1 0.04 0.006, 0.1 0.04 0.006 ]
}
DEF RestFraction ScalarInterpolator { key [ 0 1 ] keyValue [ 0 0 ] }
DEF GateDeploy PositionInterpolator { key [ 0 1 ] keyValue [ 0 0 0, 0 0 0 ] }
DEF GatePark PositionInterpolator { key [ 0 1 ] keyValue [ 0 0 -0.11, 0 0 -0.11 ] }

ROUTE StartTouch.touchTime TO PulseClock.set_startTime
ROUTE StartTouch.touchTime TO RestClock.set_stopTime
ROUTE StopTouch.touchTime TO PulseClock.set_stopTime
ROUTE StopTouch.touchTime TO RestClock.set_startTime
ROUTE PulseClock.fraction_changed TO SigilOnePulse.set_fraction
ROUTE PulseClock.fraction_changed TO SigilTwoPulse.set_fraction
ROUTE PulseClock.fraction_changed TO SigilThreePulse.set_fraction
ROUTE PulseClock.fraction_changed TO GateDeploy.set_fraction
ROUTE GateDeploy.value_changed TO StopGate.set_translation
ROUTE RestClock.fraction_changed TO RestFraction.set_fraction
ROUTE RestClock.fraction_changed TO GatePark.set_fraction
ROUTE RestFraction.value_changed TO SigilOnePulse.set_fraction
ROUTE RestFraction.value_changed TO SigilTwoPulse.set_fraction
ROUTE RestFraction.value_changed TO SigilThreePulse.set_fraction
ROUTE GatePark.value_changed TO StopGate.set_translation
ROUTE SigilOnePulse.value_changed TO SigilOneMaterial.set_emissiveColor
ROUTE SigilTwoPulse.value_changed TO SigilTwoMaterial.set_emissiveColor
ROUTE SigilThreePulse.value_changed TO SigilThreeMaterial.set_emissiveColor
