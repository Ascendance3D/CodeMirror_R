        # Stop target: buried inside the slab at rest, in front of the panel
        # while the sigils pulse
        DEF StopGate Transform {
          translation 0 0 -0.11
          children [
            DEF StopTouch TouchSensor { description "Still the hexroot sigils" }
            Shape {
              appearance Appearance { material Material { transparency 1 } }
              geometry IndexedFaceSet {
                creaseAngle 0
                coord Coordinate { point [
                  -0.305 0.445 0.106, -0.305 1.715 0.106, 0.305 1.715 0.106, 0.305 0.445 0.106, 0.305 0.445 0.114,
