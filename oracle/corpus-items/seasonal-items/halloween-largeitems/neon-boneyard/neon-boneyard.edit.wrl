ROUTE StartTouch.touchTime TO DanceClock.set_startTime
ROUTE StartTouch.touchTime TO RestClock.set_stopTime
ROUTE StopTouch.touchTime TO DanceClock.set_stopTime
ROUTE StopTouch.touchTime TO RestClock.set_startTime
ROUTE DanceClock.fraction_changed TO CycleA.set_fraction
ROUTE DanceClock.fraction_changed TO CycleB.set_fraction
ROUTE DanceClock.fraction_changed TO CycleC.set_fraction
ROUTE DanceClock.fraction_changed TO CycleD.set_fraction
ROUTE DanceClock.fraction_changed TO Rock1.set_fraction
ROUTE DanceClock.fraction_changed TO Rock2.set_fraction
ROUTE DanceClock.fraction_changed TO Rock3.set_fraction
ROUTE DanceClock.fraction_changed TO Rock4.set_fraction
ROUTE DanceClock.fraction_changed TO Rock5.set_fraction
ROUTE DanceClock.fraction_changed TO GateDeploy.set_fraction
ROUTE GateDeploy.value_changed TO StopGate.set_translation
ROUTE RestClock.fraction_changed TO RestFraction.set_fraction
ROUTE RestClock.fraction_changed TO GatePark.set_fraction
ROUTE RestFraction.value_changed TO CycleA.set_fraction
ROUTE RestFraction.value_changed TO CycleB.set_fraction
ROUTE RestFraction.value_changed TO CycleC.set_fraction
ROUTE RestFraction.value_changed TO CycleD.set_fraction
ROUTE RestFraction.value_changed TO Rock1.set_fraction
ROUTE RestFraction.value_changed TO Rock2.set_fraction
ROUTE RestFraction.value_changed TO Rock3.set_fraction
ROUTE RestFraction.value_changed TO Rock4.set_fraction
ROUTE RestFraction.value_changed TO Rock5.set_fraction
ROUTE GatePark.value_changed TO StopGate.set_translation
ROUTE CycleA.value_changed TO NeonA.set_emissiveColor
ROUTE CycleB.value_changed TO NeonB.set_emissiveColor
ROUTE CycleC.value_changed TO NeonC.set_emissiveColor
ROUTE CycleD.value_changed TO NeonD.set_emissiveColor
ROUTE Rock1.value_changed TO Dancer1.set_rotation
ROUTE Rock2.value_changed TO Dancer2.set_rotation
ROUTE Rock3.value_changed TO Dancer3.set_rotation
ROUTE Rock4.value_changed TO Dancer4.set_rotation
ROUTE Rock5.value_changed TO Dancer5.set_rotation
