    # Touch gates over the gathering stone's top tier.  The live gate wraps
    # the tier 8-12 mm proud; the parked one sits inside the solid lower tier.
    DEF FwdGate Transform {
      children [
        DEF FwdTouch TouchSensor { }
        Shape {
          appearance DEF GateApp Appearance { material Material { transparency 1 } }
          geometry DEF GateBox IndexedFaceSet {
            creaseAngle 0
            coord Coordinate { point [
              0.381 -1.51 -1.215, -0.368 -1.51 -1.267, 0.535 -1.51 -1.398, -0.575 -1.51 -1.437,
              -0.53 -1.51 -1.994, 0.413 -1.51 -2.167, 0.562 -1.51 -1.999, -0.388 -1.51 -2.17, 0.562 -1.428 -1.999,
              0.535 -1.428 -1.398, 0.413 -1.428 -2.167, -0.388 -1.428 -2.17, -0.53 -1.428 -1.994,
              -0.575 -1.428 -1.437, -0.368 -1.428 -1.267, 0.381 -1.428 -1.215
            ] }
            coordIndex [
              0 1 2 -1, 3 4 1 -1, 5 2 1 -1, 6 2 5 -1, 1 4 7 -1, 1 7 5 -1, 2 6 8 -1, 2 8 9 -1, 6 5 10 -1,
              6 10 8 -1, 5 7 11 -1, 5 11 10 -1, 7 4 12 -1, 7 12 11 -1, 4 3 13 -1, 4 13 12 -1, 3 1 14 -1,
              3 14 13 -1, 1 0 15 -1, 1 15 14 -1, 0 2 9 -1, 0 9 15 -1, 9 14 15 -1, 14 12 13 -1, 14 9 10 -1,
              10 9 8 -1, 11 12 14 -1, 10 11 14 -1
            ]
          }
        }
      ]
    }
    DEF RevGate Transform {
      translation 0 -0.16 0
      children [
        DEF RevTouch TouchSensor { }
        Shape {
          appearance USE GateApp
          geometry USE GateBox
        }
      ]
    }
  ]
}

DEF FwdClock TimeSensor { cycleInterval 2.4 loop FALSE }
DEF RevClock TimeSensor { cycleInterval 2.4 loop FALSE }
DEF Backward ScalarInterpolator { key [ 0 1 ] keyValue [ 1 0 ] }
DEF RiseA PositionInterpolator {
  key [ 0 0.13 0.2175 0.305 0.3925 0.48 0.5675 0.655 0.7425 0.83 1 ]
  keyValue [ 0 0 0, 0 0 0, 0 0.0146 0, 0 0.0531 0, 0 0.1076 0, 0 0.17 0, 0 0.2324 0, 0 0.2869 0, 0 0.3254 0, 0 0.34 0, 0 0.34 0 ]
}
DEF RiseB PositionInterpolator {
  key [ 0 0.08 0.1625 0.245 0.3275 0.41 0.4925 0.575 0.6575 0.74 1 ]
  keyValue [ 0 0 0, 0 0 0, 0 0.0095 0, 0 0.0344 0, 0 0.0696 0, 0 0.11 0, 0 0.1504 0, 0 0.1856 0, 0 0.2105 0, 0 0.22 0, 0 0.22 0 ]
}
DEF RiseC PositionInterpolator {
  key [ 0 0.19 0.275 0.36 0.445 0.53 0.615 0.7 0.785 0.87 1 ]
  keyValue [ 0 0 0, 0 0 0, 0 0.012 0, 0 0.0438 0, 0 0.0886 0, 0 0.14 0, 0 0.1914 0, 0 0.2363 0, 0 0.268 0, 0 0.28 0, 0 0.28 0 ]
}
DEF DriftNear PositionInterpolator {
  key [ 0 0.1 0.1975 0.295 0.3925 0.49 0.5875 0.685 0.7825 0.88 1 ]
  keyValue [ 0 0 0, 0 0 0, -0.0086 0 0.0043, -0.0312 0 0.0156, -0.0633 0 0.0316, -0.1 0 0.05, -0.1367 0 0.0684, -0.1688 0 0.0844, -0.1914 0 0.0957, -0.2 0 0.1, -0.2 0 0.1 ]
}
DEF DriftMiddle PositionInterpolator {
  key [ 0 0.1 0.1975 0.295 0.3925 0.49 0.5875 0.685 0.7825 0.88 1 ]
  keyValue [ 0 0 0, 0 0 0, 0.0077 0 0, 0.0281 0 0, 0.057 0 0, 0.09 0 0, 0.123 0 0, 0.1519 0 0, 0.1723 0 0, 0.18 0 0, 0.18 0 0 ]
}
DEF DriftRear PositionInterpolator {
  key [ 0 0.1 0.1975 0.295 0.3925 0.49 0.5875 0.685 0.7825 0.88 1 ]
  keyValue [ 0 0 0, 0 0 0, 0.0043 0 -0.0026, 0.0156 0 -0.0094, 0.0316 0 -0.019, 0.05 0 -0.03, 0.0684 0 -0.041, 0.0844 0 -0.0506, 0.0957 0 -0.0574, 0.1 0 -0.06, 0.1 0 -0.06 ]
}
DEF FwdGateHold PositionInterpolator { key [ 0 1 ] keyValue [ 0 -0.16 0, 0 -0.16 0 ] }
DEF RevGateOpen PositionInterpolator { key [ 0 0.95 0.96 1 ] keyValue [ 0 -0.16 0, 0 -0.16 0, 0 0 0, 0 0 0 ] }
DEF RevGateHold PositionInterpolator { key [ 0 1 ] keyValue [ 0 -0.16 0, 0 -0.16 0 ] }
DEF FwdGateOpen PositionInterpolator { key [ 0 0.95 0.96 1 ] keyValue [ 0 -0.16 0, 0 -0.16 0, 0 0 0, 0 0 0 ] }

ROUTE FwdTouch.touchTime TO FwdClock.set_startTime
ROUTE RevTouch.touchTime TO RevClock.set_startTime
ROUTE FwdClock.fraction_changed TO RiseA.set_fraction
ROUTE FwdClock.fraction_changed TO RiseB.set_fraction
ROUTE FwdClock.fraction_changed TO RiseC.set_fraction
ROUTE FwdClock.fraction_changed TO DriftNear.set_fraction
ROUTE FwdClock.fraction_changed TO DriftMiddle.set_fraction
ROUTE FwdClock.fraction_changed TO DriftRear.set_fraction
ROUTE RevClock.fraction_changed TO Backward.set_fraction
ROUTE Backward.value_changed TO RiseA.set_fraction
ROUTE Backward.value_changed TO RiseB.set_fraction
ROUTE Backward.value_changed TO RiseC.set_fraction
ROUTE Backward.value_changed TO DriftNear.set_fraction
ROUTE Backward.value_changed TO DriftMiddle.set_fraction
ROUTE Backward.value_changed TO DriftRear.set_fraction
ROUTE RiseA.value_changed TO SpiritA.set_translation
ROUTE RiseB.value_changed TO SpiritB.set_translation
ROUTE RiseC.value_changed TO SpiritC.set_translation
ROUTE DriftNear.value_changed TO MistNear.set_translation
ROUTE DriftMiddle.value_changed TO MistMiddle.set_translation
ROUTE DriftRear.value_changed TO MistRear.set_translation
ROUTE FwdClock.fraction_changed TO FwdGateHold.set_fraction
ROUTE FwdClock.fraction_changed TO RevGateOpen.set_fraction
ROUTE RevClock.fraction_changed TO RevGateHold.set_fraction
ROUTE RevClock.fraction_changed TO FwdGateOpen.set_fraction
ROUTE FwdGateHold.value_changed TO FwdGate.set_translation
ROUTE RevGateOpen.value_changed TO RevGate.set_translation
ROUTE RevGateHold.value_changed TO RevGate.set_translation
ROUTE FwdGateOpen.value_changed TO FwdGate.set_translation
