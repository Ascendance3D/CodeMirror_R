    # Stop gate: covers the seal while the light travels, buried in the slab at rest
    DEF StopGate Transform {
      translation 0 -0.11 0
      children [
        DEF StopTouch TouchSensor { }
        Shape {
          appearance Appearance { material Material { transparency 1 } }
          geometry IndexedFaceSet {
            creaseAngle 0
            coord Coordinate { point [
              -0.52 -1.63 -0.22, 0.52 -1.63 -0.22, -0.52 -1.63 0.82, 0.52 -1.63 0.82, 0.52 -1.55 0.82,
