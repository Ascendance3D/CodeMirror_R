ROUTE FwdTouch.touchTime TO FwdClock.set_startTime
ROUTE RevTouch.touchTime TO RevClock.set_startTime
ROUTE FwdClock.fraction_changed TO Head1Fwd.set_fraction
ROUTE Head1Fwd.value_changed TO Head1.set_rotation
ROUTE FwdClock.fraction_changed TO Head2Fwd.set_fraction
ROUTE Head2Fwd.value_changed TO Head2.set_rotation
ROUTE FwdClock.fraction_changed TO Head3Fwd.set_fraction
ROUTE Head3Fwd.value_changed TO Head3.set_rotation
ROUTE FwdClock.fraction_changed TO Head4Fwd.set_fraction
ROUTE Head4Fwd.value_changed TO Head4.set_rotation
ROUTE FwdClock.fraction_changed TO Head5Fwd.set_fraction
ROUTE Head5Fwd.value_changed TO Head5.set_rotation
ROUTE FwdClock.fraction_changed TO Head6Fwd.set_fraction
ROUTE Head6Fwd.value_changed TO Head6.set_rotation
ROUTE RevClock.fraction_changed TO Head1Rev.set_fraction
ROUTE Head1Rev.value_changed TO Head1.set_rotation
ROUTE RevClock.fraction_changed TO Head2Rev.set_fraction
ROUTE Head2Rev.value_changed TO Head2.set_rotation
ROUTE RevClock.fraction_changed TO Head3Rev.set_fraction
ROUTE Head3Rev.value_changed TO Head3.set_rotation
ROUTE RevClock.fraction_changed TO Head4Rev.set_fraction
ROUTE Head4Rev.value_changed TO Head4.set_rotation
ROUTE RevClock.fraction_changed TO Head5Rev.set_fraction
ROUTE Head5Rev.value_changed TO Head5.set_rotation
ROUTE RevClock.fraction_changed TO Head6Rev.set_fraction
ROUTE Head6Rev.value_changed TO Head6.set_rotation
ROUTE FwdClock.fraction_changed TO FwdGateHold.set_fraction
ROUTE FwdClock.fraction_changed TO RevGateOpen.set_fraction
ROUTE RevClock.fraction_changed TO RevGateHold.set_fraction
ROUTE RevClock.fraction_changed TO FwdGateOpen.set_fraction
ROUTE FwdGateHold.value_changed TO FwdGate.set_translation
ROUTE RevGateOpen.value_changed TO RevGate.set_translation
ROUTE RevGateHold.value_changed TO RevGate.set_translation
ROUTE FwdGateOpen.value_changed TO FwdGate.set_translation
