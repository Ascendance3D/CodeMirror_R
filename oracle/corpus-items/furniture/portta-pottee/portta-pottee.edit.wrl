# Cabin light. OFF at load; the door controls carry it, so it is both
# purposeful and toggleable without a Script node.
DEF CabinLight PointLight {
  on FALSE
  intensity 0.85
  ambientIntensity 0.25
  color 1 0.96 0.88
  location 0 0.524 -0.792
  radius 3.2
  attenuation 1 0.25 0
}

DEF OpenClock  TimeSensor { cycleInterval 1.2 }
DEF CloseClock TimeSensor { cycleInterval 1.2 }
DEF OpenPath  OrientationInterpolator { key [ 0, 1 ] keyValue [ 0 1 0 0, 0 1 0 -1.5708 ] }
DEF ClosePath OrientationInterpolator { key [ 0, 1 ] keyValue [ 0 1 0 -1.5708, 0 1 0 0 ] }

# Scriptless latch: loop TRUE with stopTime > startTime is inactive at load,
# so the light starts off and stays off until the door is opened.
DEF LightLatch TimeSensor { cycleInterval 1 loop TRUE startTime 0 stopTime 1 }

ROUTE DoorTouch.touchTime    TO OpenClock.set_startTime
ROUTE OpenClock.fraction_changed TO OpenPath.set_fraction
ROUTE OpenPath.value_changed TO Hinge.set_rotation
ROUTE CabinTouch.touchTime   TO CloseClock.set_startTime
ROUTE CloseClock.fraction_changed TO ClosePath.set_fraction
ROUTE ClosePath.value_changed TO Hinge.set_rotation
ROUTE DoorTouch.touchTime    TO LightLatch.set_startTime
ROUTE CabinTouch.touchTime   TO LightLatch.set_stopTime
ROUTE LightLatch.isActive    TO CabinLight.set_on
