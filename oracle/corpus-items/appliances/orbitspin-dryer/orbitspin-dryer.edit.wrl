}

ROUTE StartTouch.touchTime TO DrumClock.set_startTime
ROUTE StopTouch.touchTime TO DrumClock.set_stopTime
ROUTE DrumClock.fraction_changed TO DrumRot.set_fraction
ROUTE DrumRot.value_changed TO DrumSpin.set_rotation
ROUTE HandleTouch.touchTime TO DoorOpenClock.set_startTime
ROUTE DoorOpenClock.fraction_changed TO DoorOpenRot.set_fraction
ROUTE DoorOpenRot.value_changed TO DoorHinge.set_rotation
ROUTE LatchTouch.touchTime TO DoorCloseClock.set_startTime
ROUTE DoorCloseClock.fraction_changed TO DoorCloseRot.set_fraction
ROUTE DoorCloseRot.value_changed TO DoorHinge.set_rotation
