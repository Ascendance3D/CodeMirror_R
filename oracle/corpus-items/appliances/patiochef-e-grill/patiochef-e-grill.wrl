        ] }
        Transform { translation 0 0.046 -0.020 children [
          Shape { appearance Appearance { material USE M_Cyan }
            geometry DEF G_KnobMark Box { size 0.008 0.004 0.030 } }
        ] }
        Transform { translation 0 0.026 0 children [
          Shape { appearance Appearance { material DEF M_TouchSensorInvisible Material { ambientIntensity 0 diffuseColor 0 0 0 transparency 1.0 } }
            geometry DEF G_StartHit Box { size 0.12 0.06 0.12 } }
        ] }
      ]
    }
