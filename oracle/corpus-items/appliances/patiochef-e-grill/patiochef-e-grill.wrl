#VRML V2.0 utf8
# PatioChef E Grill
# Original VRML97 outdoor kitchen for the Cybertown Revival Mall Kitchen Store Contest.
# CyberChef product family: charcoal body, brushed silver trim, warm stone counter, cyan accents.
# - One level worktop across the whole unit, with a vented hood on a rear upright.
# - 5 electric burners: two left, two right, one wide griddle burner in the centre.
# - All ten controls sit on the front panel facing the viewer. Every TouchSensor
#   lives in its own grouping node with only its own control geometry, so no
#   unrelated grill surface is clickable.
# - Flames scale in place at their burner (scale 0 = off). No flame geometry ever
#   exists or animates below the Mall floor.
# - Every clock starts at sentinel startTime 4102444800 (2100-01-01 UTC), stopTime 0,
#   so nothing animates until a real touchTime replaces it.
# - Bounds: X 3.80 m, Y 2.09 m, Z 1.02 m. Lowest Y = -1.75, max Z = +0.32.

WorldInfo {
  title "PatioChef E Grill"
  info [
    "Made By: BassMekanik"
    "Uploaded: July, 2026"
    "Limited To: UNLIMITED"
    "Mall Price: 60 CC"
    "Kitchen Store Contest"
  ]
}

