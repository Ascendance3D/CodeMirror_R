ROUTE B3Bob.value_changed TO B3FlameLoop.set_translation

# Burner B4: start cancels the extinguish clock, runs ignition scaling and the
# flicker loop; stop cancels ignition, halts the loop and scales back to zero.
ROUTE B4StartTouch.touchTime TO B4Douse.set_stopTime
ROUTE B4StartTouch.touchTime TO B4Ignite.set_startTime
ROUTE B4StartTouch.touchTime TO B4Loop.set_startTime
ROUTE B4StopTouch.touchTime TO B4Ignite.set_stopTime
ROUTE B4StopTouch.touchTime TO B4Douse.set_startTime
ROUTE B4StopTouch.touchTime TO B4Loop.set_stopTime
ROUTE B4Ignite.fraction_changed TO B4IgniteScale.set_fraction
ROUTE B4IgniteScale.value_changed TO B4FlameState.set_scale
ROUTE B4Douse.fraction_changed TO B4DouseScale.set_fraction
