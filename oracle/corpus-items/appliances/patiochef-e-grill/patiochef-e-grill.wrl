# ---------- Routes ----------

# Burner B1: start cancels the extinguish clock, runs ignition scaling and the
# flicker loop; stop cancels ignition, halts the loop and scales back to zero.
ROUTE B1StartTouch.touchTime TO B1Douse.set_stopTime
ROUTE B1StartTouch.touchTime TO B1Ignite.set_startTime
ROUTE B1StartTouch.touchTime TO B1Loop.set_startTime
ROUTE B1StopTouch.touchTime TO B1Ignite.set_stopTime
ROUTE B1StopTouch.touchTime TO B1Douse.set_startTime
ROUTE B1StopTouch.touchTime TO B1Loop.set_stopTime
ROUTE B1Ignite.fraction_changed TO B1IgniteScale.set_fraction
ROUTE B1IgniteScale.value_changed TO B1FlameState.set_scale
ROUTE B1Douse.fraction_changed TO B1DouseScale.set_fraction
ROUTE B1DouseScale.value_changed TO B1FlameState.set_scale
ROUTE B1Loop.fraction_changed TO B1Bob.set_fraction
ROUTE B1Bob.value_changed TO B1FlameLoop.set_translation

# Burner B2: start cancels the extinguish clock, runs ignition scaling and the
# flicker loop; stop cancels ignition, halts the loop and scales back to zero.
ROUTE B2StartTouch.touchTime TO B2Douse.set_stopTime
ROUTE B2StartTouch.touchTime TO B2Ignite.set_startTime
ROUTE B2StartTouch.touchTime TO B2Loop.set_startTime
ROUTE B2StopTouch.touchTime TO B2Ignite.set_stopTime
ROUTE B2StopTouch.touchTime TO B2Douse.set_startTime
ROUTE B2StopTouch.touchTime TO B2Loop.set_stopTime
ROUTE B2Ignite.fraction_changed TO B2IgniteScale.set_fraction
ROUTE B2IgniteScale.value_changed TO B2FlameState.set_scale
ROUTE B2Douse.fraction_changed TO B2DouseScale.set_fraction
ROUTE B2DouseScale.value_changed TO B2FlameState.set_scale
ROUTE B2Loop.fraction_changed TO B2Bob.set_fraction
ROUTE B2Bob.value_changed TO B2FlameLoop.set_translation

# Burner B3: start cancels the extinguish clock, runs ignition scaling and the
# flicker loop; stop cancels ignition, halts the loop and scales back to zero.
