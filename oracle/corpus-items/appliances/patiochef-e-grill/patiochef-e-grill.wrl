    # worktop, hood or burner click reaches no sensor at all, and a start
    # hitbox never overlaps its stop hitbox.
    # -- burner 1: START knob (upper) --
    DEF B1StartControl Transform {
      translation -1.5 -0.925 0.234
      rotation 1 0 0 1.5708
      children [
        DEF B1StartTouch TouchSensor { description "Start burner 1" }
        Shape { appearance Appearance { material USE M_Dark }
          geometry DEF G_KnobBezel Cylinder { radius 0.062 height 0.012 } }
        Transform { translation 0 0.020 0 children [
          Shape { appearance Appearance { material USE M_Metal }
