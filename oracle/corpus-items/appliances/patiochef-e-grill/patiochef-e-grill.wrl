    # ---------- Flames ----------
    # Each flame is a child of a state Transform parked at scale 0 0 0 and
    # anchored at its own burner. Ignition/extinguish drive set_scale ONLY, so a
    # flame never leaves the burner and nothing is ever hidden under the floor.
    DEF B1FlameState Transform {
      translation -1.35 -0.7 -0.36
      scale 0 0 0
      children [
        DEF B1FlameLoop Transform {
          children [
          DEF G_FlameBody Group {
            children [
              Shape { appearance Appearance { material DEF M_FlameBase Material {
                ambientIntensity 0.10 diffuseColor 0.30 0.85 1.00 emissiveColor 0.20 0.70 0.95
                transparency 0.25 specularColor 0.50 0.85 0.95 shininess 0.50 } }
                geometry Sphere { radius 0.045 } }
              Transform { translation 0 0.080 0 children [
                Shape { appearance Appearance { material DEF M_FlameInner Material {
                  ambientIntensity 0.10 diffuseColor 1.00 0.95 0.70 emissiveColor 1.00 0.85 0.40
                  transparency 0.30 specularColor 0.95 0.90 0.70 shininess 0.40 } }
                  geometry Cone { bottomRadius 0.030 height 0.16 } }
              ] }
              Transform { translation 0 0.090 0.005 children [
                Shape { appearance Appearance { material DEF M_FlameOuter Material {
                  ambientIntensity 0.10 diffuseColor 1.00 0.55 0.20 emissiveColor 0.95 0.40 0.10
                  transparency 0.55 specularColor 0.90 0.50 0.25 shininess 0.30 } }
                  geometry Cone { bottomRadius 0.050 height 0.20 } }
              ] }
              Transform { translation -0.030 0.065 0.020 children [
                Shape { appearance Appearance { material USE M_FlameOuter }
                  geometry Cone { bottomRadius 0.025 height 0.13 } }
              ] }
              Transform { translation 0.030 0.060 0.020 children [
                Shape { appearance Appearance { material USE M_FlameOuter }
                  geometry Cone { bottomRadius 0.022 height 0.11 } }
              ] }
            ]
          }
          ]
        }
      ]
    }
    DEF B2FlameState Transform {
      translation -1.35 -0.7 0.02
      scale 0 0 0
      children [
        DEF B2FlameLoop Transform {
          children [
            USE G_FlameBody
          ]
        }
      ]
    }
    DEF B3FlameState Transform {
      translation 1.35 -0.7 -0.36
      scale 0 0 0
      children [
        DEF B3FlameLoop Transform {
          children [
            USE G_FlameBody
          ]
        }
      ]
    }
    DEF B4FlameState Transform {
      translation 1.35 -0.7 0.02
      scale 0 0 0
      children [
        DEF B4FlameLoop Transform {
          children [
            USE G_FlameBody
          ]
        }
      ]
    }
    DEF B5FlameState Transform {
      translation 0.0 -0.7 -0.19
      scale 0 0 0
      children [
        DEF B5FlameLoop Transform {
          children [
            Transform { translation -0.13 0 0 children [ USE G_FlameBody ] }
            Transform { translation 0.0 0.02 0 children [ USE G_FlameBody ] }
            Transform { translation 0.13 0 0 children [ USE G_FlameBody ] }
          ]
        }
      ]
    }
  ]
}

# ---------- Timing model ----------
# Every clock is parked at a far-future sentinel start (4102444800 = 2100-01-01
# UTC) with stopTime 0, so no TimeSensor is active when the world loads. A real
# touchTime always replaces the sentinel, so the sentinel is never reached.

# ---------- Burner B1 animation ----------
DEF B1Loop TimeSensor {
  cycleInterval 1.40
  loop TRUE
  startTime 4102444800
  stopTime 0
}
DEF B1Ignite TimeSensor {
  cycleInterval 0.45
  loop FALSE
  startTime 4102444800
  stopTime 0
}
DEF B1Douse TimeSensor {
  cycleInterval 0.35
  loop FALSE
  startTime 4102444800
  stopTime 0
}
DEF B1Bob PositionInterpolator {
  key [0 0.30 0.55 0.80 1]
  keyValue [0 0.000 0, 0.008 0.022 0, -0.006 0.012 0, 0.005 0.018 0, 0 0.000 0]
}
DEF B1IgniteScale PositionInterpolator {
  key [0 0.75 1]
  keyValue [0 0 0, 1 1.12 1, 1 1 1]
}
DEF B1DouseScale PositionInterpolator {
  key [0 1]
  keyValue [1 1 1, 0 0 0]
}

# ---------- Burner B2 animation ----------
DEF B2Loop TimeSensor {
  cycleInterval 1.40
  loop TRUE
  startTime 4102444800
  stopTime 0
}
DEF B2Ignite TimeSensor {
  cycleInterval 0.45
  loop FALSE
  startTime 4102444800
  stopTime 0
}
DEF B2Douse TimeSensor {
  cycleInterval 0.35
  loop FALSE
  startTime 4102444800
  stopTime 0
}
DEF B2Bob PositionInterpolator {
  key [0 0.30 0.55 0.80 1]
  keyValue [0 0.000 0, 0.008 0.022 0, -0.006 0.012 0, 0.005 0.018 0, 0 0.000 0]
}
DEF B2IgniteScale PositionInterpolator {
  key [0 0.75 1]
  keyValue [0 0 0, 1 1.12 1, 1 1 1]
}
DEF B2DouseScale PositionInterpolator {
  key [0 1]
  keyValue [1 1 1, 0 0 0]
}

