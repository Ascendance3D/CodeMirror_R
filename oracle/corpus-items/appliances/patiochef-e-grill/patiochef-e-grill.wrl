ROUTE B3StopTouch.touchTime TO B3Loop.set_stopTime
ROUTE B3Ignite.fraction_changed TO B3IgniteScale.set_fraction
ROUTE B3IgniteScale.value_changed TO B3FlameState.set_scale
ROUTE B3Douse.fraction_changed TO B3DouseScale.set_fraction
ROUTE B3DouseScale.value_changed TO B3FlameState.set_scale
