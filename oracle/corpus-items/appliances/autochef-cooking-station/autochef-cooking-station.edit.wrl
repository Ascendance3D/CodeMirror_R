            geometry Box { size 1.78 0.012 0.012 } }
        ] }
        # -- EXTEND control: the centre pull tab only. The rest of the
        #    1.86 m tray lip is NOT a click target.
        DEF TrayTabControl Transform {
          translation 0 0 0.078
          children [
            DEF TrayOutTouch TouchSensor { description "Slide out the prep tray" }
            Transform { children [
              Shape { appearance Appearance { material USE M_Metal }
                geometry Box { size 0.34 0.055 0.045 } }
            ] }
            Transform { translation 0 0 0.018 children [
              Shape { appearance Appearance { material USE M_Cyan }
                geometry Box { size 0.22 0.026 0.012 } }
            ] }
            Transform { children [
              Shape { appearance Appearance { material USE M_Hit }
                geometry Box { size 0.40 0.09 0.09 } }
            ] }
          ]
        }
      ]
    }

    # ---------- Control panel face ----------
    Transform { translation 0 -0.3 0.035 children [
      Shape { appearance Appearance { material DEF M_Panel Material { ambientIntensity 0.22 diffuseColor 0.07 0.09 0.14 specularColor 0.32 0.36 0.44 shininess 0.50 } }
        geometry Box { size 1.9 0.34 0.03 } }
    ] }
    Transform { translation 0 -0.475 0.032 children [
      Shape { appearance Appearance { material USE M_Metal }
        geometry Box { size 1.9 0.016 0.032 } }
    ] }
    Transform { translation 0 -0.128 0.032 children [
      Shape { appearance Appearance { material USE M_Metal }
        geometry Box { size 1.9 0.016 0.032 } }
    ] }
    Transform { translation -0.54 -0.3 0.052 children [
      Shape { appearance Appearance { material USE M_Metal }
        geometry Box { size 0.72 0.24 0.02 } }
    ] }
    Transform { translation -0.54 -0.3 0.063 children [
      Shape { appearance Appearance { material DEF M_Screen Material { ambientIntensity 0.08 diffuseColor 0.010 0.030 0.040 specularColor 0.20 0.30 0.34 shininess 0.40 } }
        geometry Box { size 0.66 0.19 0.012 } }
    ] }
    Transform { translation -0.54 -0.355 0.07 children [
      Shape { appearance Appearance { material USE M_Dark }
        geometry Box { size 0.57 0.05 0.01 } }
    ] }
    # Progress fill grows rightward from the LEFT end of the track: the bar
    # is offset +0.27 inside a Transform whose origin is the track's left end,
    # so scaling X from 0 to 1 fills the track.
    DEF ProgressFill Transform {
      translation -0.82 -0.355 0.0745
      scale 0 1 1
      children [
        Transform { translation 0.27 0 0 children [
          Shape { appearance Appearance { material USE M_Cyan }
            geometry Box { size 0.54 0.036 0.008 } }
        ] }
      ]
    }
    Transform { translation -0.61 -0.252 0.07 children [
      Shape { appearance Appearance { material DEF M_StatusPlate Material { ambientIntensity 0.05 diffuseColor 0.00 0.18 0.22 emissiveColor 0.00 0.55 0.62 specularColor 0.20 0.45 0.50 shininess 0.45 } }
        geometry Box { size 0.3 0.055 0.008 } }
    ] }
    Transform { translation -0.42 -0.252 0.072 rotation 1 0 0 1.5708 children [
      Shape { appearance Appearance { material DEF M_Dot1 Material { ambientIntensity 0.05 diffuseColor 0.00 0.14 0.18 emissiveColor 0.00 0.10 0.13 specularColor 0.20 0.40 0.45 shininess 0.40 } }
        geometry Cylinder { radius 0.022 height 0.008 } }
    ] }
    Transform { translation -0.35 -0.252 0.072 rotation 1 0 0 1.5708 children [
      Shape { appearance Appearance { material DEF M_Dot2 Material { ambientIntensity 0.05 diffuseColor 0.00 0.14 0.18 emissiveColor 0.00 0.10 0.13 specularColor 0.20 0.40 0.45 shininess 0.40 } }
        geometry Cylinder { radius 0.022 height 0.008 } }
    ] }
    Transform { translation -0.28 -0.252 0.072 rotation 1 0 0 1.5708 children [
      Shape { appearance Appearance { material DEF M_Dot3 Material { ambientIntensity 0.05 diffuseColor 0.00 0.14 0.18 emissiveColor 0.00 0.10 0.13 specularColor 0.20 0.40 0.45 shininess 0.40 } }
        geometry Cylinder { radius 0.022 height 0.008 } }
    ] }
    Transform { translation -0.862 -0.252 0.07 children [
      Shape { appearance Appearance { material USE M_Rack }
        geometry DEF G_Tick Box { size 0.024 0.006 0.008 } }
    ] }
    Transform { translation -0.822 -0.252 0.07 children [
      Shape { appearance Appearance { material USE M_Rack }
        geometry USE G_Tick }
    ] }
    Transform { translation -0.782 -0.252 0.07 children [
      Shape { appearance Appearance { material USE M_Rack }
        geometry USE G_Tick }
    ] }

    # ---------- Panel controls ----------
    # Each is its own grouping node: TouchSensor + its own visible button + its
    # own local hitbox. Hitboxes never overlap (0.20 m horizontal and 0.08 m
    # vertical dead bands between them) and the panel face between them belongs
    # to no sensor at all.
    DEF OvenCloseControl Transform {
      translation 0.06 -0.21 0.056
      rotation 1 0 0 1.5708
      children [
        DEF OvenCloseTouch TouchSensor { description "Close the main oven" }
        Shape { appearance Appearance { material USE M_Dark }
          geometry DEF G_BtnBezel Cylinder { radius 0.046 height 0.010 } }
        Transform { translation 0 0.010 0 children [
          Shape { appearance Appearance { material USE M_Cyan }
            geometry DEF G_BtnCap Cylinder { radius 0.034 height 0.016 } }
        ] }
        Transform { translation 0 0.020 0 children [
          Shape { appearance Appearance { material USE M_Panel }
            geometry Box { size 0.044 0.004 0.010 } }
        ] }
        Transform { translation 0 0.012 0 children [
          Shape { appearance Appearance { material USE M_Hit }
            geometry DEF G_BtnHit Box { size 0.10 0.05 0.10 } }
        ] }
      ]
    }
    DEF ChamberCloseControl Transform {
      translation 0.36 -0.21 0.056
      rotation 1 0 0 1.5708
      children [
        DEF ChamberCloseTouch TouchSensor { description "Close the upper chamber" }
        Shape { appearance Appearance { material USE M_Dark }
          geometry USE G_BtnBezel }
        Transform { translation 0 0.010 0 children [
          Shape { appearance Appearance { material USE M_Cyan }
            geometry USE G_BtnCap }
        ] }
        Transform { translation 0 0.020 0 children [
          Shape { appearance Appearance { material USE M_Panel }
            geometry Box { size 0.010 0.004 0.044 } }
        ] }
        Transform { translation 0 0.012 0 children [
          Shape { appearance Appearance { material USE M_Hit }
            geometry USE G_BtnHit }
        ] }
      ]
    }
    DEF DrawerCloseControl Transform {
      translation 0.06 -0.39 0.056
      rotation 1 0 0 1.5708
      children [
        DEF DrawerCloseTouch TouchSensor { description "Close the warming drawer" }
        Shape { appearance Appearance { material USE M_Dark }
          geometry USE G_BtnBezel }
        Transform { translation 0 0.010 0 children [
          Shape { appearance Appearance { material USE M_Cyan }
            geometry USE G_BtnCap }
        ] }
        Transform { translation 0 0.020 0 children [
          Shape { appearance Appearance { material USE M_Panel }
            geometry Box { size 0.038 0.004 0.018 } }
        ] }
        Transform { translation 0 0.012 0 children [
          Shape { appearance Appearance { material USE M_Hit }
            geometry USE G_BtnHit }
        ] }
      ]
    }
    DEF TrayInControl Transform {
      translation 0.36 -0.39 0.056
      rotation 1 0 0 1.5708
      children [
        DEF TrayInTouch TouchSensor { description "Retract the prep tray" }
        Shape { appearance Appearance { material USE M_Dark }
          geometry USE G_BtnBezel }
        Transform { translation 0 0.010 0 children [
          Shape { appearance Appearance { material USE M_Cyan }
            geometry USE G_BtnCap }
        ] }
        Transform { translation 0 0.020 0 children [
          Shape { appearance Appearance { material USE M_Panel }
            geometry Box { size 0.018 0.004 0.038 } }
        ] }
        Transform { translation 0 0.012 0 children [
          Shape { appearance Appearance { material USE M_Hit }
            geometry USE G_BtnHit }
        ] }
      ]
    }
    DEF CookStopControl Transform {
      translation 0.74 -0.43 0.056
      rotation 1 0 0 1.5708
      children [
        DEF CookStopTouch TouchSensor { description "Stop the cook cycle" }
        Shape { appearance Appearance { material USE M_Dark }
          geometry USE G_BtnBezel }
        Transform { translation 0 0.010 0 children [
          Shape { appearance Appearance { material USE M_Cyan }
            geometry USE G_BtnCap }
        ] }
        Transform { translation 0 0.020 0 children [
          Shape { appearance Appearance { material USE M_Panel }
            geometry Box { size 0.026 0.004 0.026 } }
        ] }
        Transform { translation 0 0.012 0 children [
          Shape { appearance Appearance { material USE M_Hit }
            geometry USE G_BtnHit }
        ] }
      ]
    }
    # -- COOK START: a chunky knob, well clear of the stop button's hitbox
    DEF CookStartControl Transform {
      translation 0.74 -0.25 0.056
      rotation 1 0 0 1.5708
      children [
        DEF CookStartTouch TouchSensor { description "Start the cook cycle" }
        Shape { appearance Appearance { material USE M_Dark }
          geometry Cylinder { radius 0.072 height 0.012 } }
        Transform { translation 0 0.018 0 children [
          Shape { appearance Appearance { material USE M_Metal }
            geometry Cylinder { radius 0.062 height 0.044 } }
        ] }
        Transform { translation 0 0.044 0 children [
          Shape { appearance Appearance { material USE M_Dark }
            geometry Cylinder { radius 0.048 height 0.010 } }
        ] }
        Transform { translation 0 0.050 -0.026 children [
          Shape { appearance Appearance { material DEF M_Amber Material { ambientIntensity 0.14 diffuseColor 0.80 0.45 0.10 emissiveColor 0.55 0.26 0.03 specularColor 0.60 0.45 0.25 shininess 0.50 } }
            geometry Box { size 0.010 0.006 0.032 } }
        ] }
        Transform { translation 0 0.030 0 children [
          Shape { appearance Appearance { material USE M_Hit }
            geometry Box { size 0.15 0.07 0.15 } }
        ] }
      ]
    }
  ]
}

# ---------- Timing model ----------
# Every clock is parked at a far-future sentinel start (4102444800 = 2100-01-01 UTC)
# with stopTime 0, so no TimeSensor is active when the world loads and nothing
# moves during an untouched idle. A real touchTime always replaces the
# sentinel, so the sentinel itself is never reached.
DEF OvenOpen TimeSensor {
  cycleInterval 1
  loop FALSE
  startTime 4102444800
  stopTime 0
}
DEF OvenClose TimeSensor {
  cycleInterval 0.9
  loop FALSE
  startTime 4102444800
  stopTime 0
}
DEF ChamberOpen TimeSensor {
  cycleInterval 0.85
  loop FALSE
  startTime 4102444800
  stopTime 0
}
DEF ChamberClose TimeSensor {
  cycleInterval 0.8
  loop FALSE
  startTime 4102444800
  stopTime 0
}
DEF DrawerOut TimeSensor {
  cycleInterval 0.75
  loop FALSE
  startTime 4102444800
  stopTime 0
}
DEF DrawerIn TimeSensor {
  cycleInterval 0.7
  loop FALSE
  startTime 4102444800
  stopTime 0
}
DEF TrayOut TimeSensor {
  cycleInterval 0.8
  loop FALSE
  startTime 4102444800
  stopTime 0
}
DEF TrayIn TimeSensor {
  cycleInterval 0.75
  loop FALSE
  startTime 4102444800
  stopTime 0
}
DEF CookCycle TimeSensor {
  cycleInterval 12
  loop FALSE
  startTime 4102444800
  stopTime 0
}
DEF CookReset TimeSensor {
  cycleInterval 0.6
  loop FALSE
  startTime 4102444800
  stopTime 0
}

# ---------- Motion interpolators ----------
DEF OvenOpenRot OrientationInterpolator {
  key [0 0.3 0.7 1]
  keyValue [1 0 0 0, 1 0 0 0.3456, 1 0 0 1.2881, 1 0 0 1.5708]
}
DEF OvenCloseRot OrientationInterpolator {
  key [0 0.3 0.7 1]
  keyValue [1 0 0 1.5708, 1 0 0 1.2252, 1 0 0 0.2827, 1 0 0 0]
}
DEF ChamberOpenRot OrientationInterpolator {
  key [0 0.3 0.7 1]
  keyValue [1 0 0 0, 1 0 0 -0.4224, 1 0 0 -1.5744, 1 0 0 -1.92]
}
DEF ChamberCloseRot OrientationInterpolator {
  key [0 0.3 0.7 1]
  keyValue [1 0 0 -1.92, 1 0 0 -1.4976, 1 0 0 -0.3456, 1 0 0 0]
}
DEF DrawerOutPos PositionInterpolator {
  key [0 0.3 0.7 1]
  keyValue [0 -1.435 0, 0 -1.435 0.088, 0 -1.435 0.328, 0 -1.435 0.4]
}
DEF DrawerInPos PositionInterpolator {
  key [0 0.3 0.7 1]
  keyValue [0 -1.435 0.4, 0 -1.435 0.312, 0 -1.435 0.072, 0 -1.435 0]
}
DEF TrayOutPos PositionInterpolator {
  key [0 0.3 0.7 1]
  keyValue [0 -0.56 0, 0 -0.56 0.0968, 0 -0.56 0.3608, 0 -0.56 0.44]
}
DEF TrayInPos PositionInterpolator {
  key [0 0.3 0.7 1]
  keyValue [0 -0.56 0.44, 0 -0.56 0.3432, 0 -0.56 0.0792, 0 -0.56 0]
}

# ---------- Cook-cycle interpolators (status panel + chamber glow) ----------
# The cycle both starts AND ends at the idle values, so a cycle that is allowed
# to run to completion leaves the panel and the glows exactly as it found them.
DEF CookProgress PositionInterpolator {
  key [0 0.97 1]
  keyValue [0 1 1, 1 1 1, 0 1 1]
}
DEF HeatColor ColorInterpolator {
  key [0 0.06 0.16 0.24 0.32 0.40 0.48 0.56 0.64 0.72 0.80 0.92 1]
  keyValue [0.05 0.01 0, 0.55 0.14 0.02, 1 0.42 0.08, 0.55 0.14 0.02, 1 0.42 0.08, 0.55 0.14 0.02, 1 0.42 0.08, 0.55 0.14 0.02, 1 0.42 0.08, 0.55 0.14 0.02, 1 0.42 0.08, 0.55 0.14 0.02, 0.05 0.01 0]
}
DEF ChamberColor ColorInterpolator {
  key [0 0.08 0.20 0.30 0.40 0.50 0.60 0.70 0.80 0.90 1]
  keyValue [0 0.06 0.09, 0.05 0.45 0.55, 0.2 0.85 1, 0.05 0.45 0.55, 0.2 0.85 1, 0.05 0.45 0.55, 0.2 0.85 1, 0.05 0.45 0.55, 0.2 0.85 1, 0.05 0.45 0.55, 0 0.06 0.09]
}
DEF PanelHue ColorInterpolator {
  key [0 0.04 0.93 1]
  keyValue [0 0.55 0.62, 1 0.55 0.1, 1 0.55 0.1, 0 0.55 0.62]
}
DEF Dot1Color ColorInterpolator {
  key [0 0.02 0.98 1]
  keyValue [0 0.1 0.13, 0 0.85 0.95, 0 0.85 0.95, 0 0.1 0.13]
}
DEF Dot2Color ColorInterpolator {
  key [0 0.30 0.34 0.98 1]
  keyValue [0 0.1 0.13, 0 0.1 0.13, 0 0.85 0.95, 0 0.85 0.95, 0 0.1 0.13]
}
DEF Dot3Color ColorInterpolator {
  key [0 0.62 0.66 0.98 1]
  keyValue [0 0.1 0.13, 0 0.1 0.13, 0 0.85 0.95, 0 0.85 0.95, 0 0.1 0.13]
}

# ---------- Reset interpolators (run only when the stop control is used) ----------
# Stopping a TimeSensor mid-cycle just freezes its interpolators, so the stop
# control runs a short second pass that drives every animated value back to its
# idle state.
DEF ResetProgress PositionInterpolator {
  key [0 1]
  keyValue [0 1 1, 0 1 1]
}
DEF ResetHeat ColorInterpolator {
  key [0 1]
  keyValue [0.55 0.14 0.02, 0.05 0.01 0]
}
DEF ResetChamber ColorInterpolator {
  key [0 1]
  keyValue [0.05 0.45 0.55, 0 0.06 0.09]
}
DEF ResetPanel ColorInterpolator {
  key [0 1]
  keyValue [0 0.55 0.62, 0 0.55 0.62]
}
DEF ResetDot ColorInterpolator {
  key [0 1]
  keyValue [0 0.1 0.13, 0 0.1 0.13]
}

# ---------- Routes ----------

# OvenDoorPivot: opening cancels the closing clock and vice versa, so the two can never
# drive the same field at the same time.
ROUTE OvenOpenTouch.touchTime TO OvenClose.set_stopTime
ROUTE OvenOpenTouch.touchTime TO OvenOpen.set_startTime
ROUTE OvenCloseTouch.touchTime TO OvenOpen.set_stopTime
ROUTE OvenCloseTouch.touchTime TO OvenClose.set_startTime
ROUTE OvenOpen.fraction_changed TO OvenOpenRot.set_fraction
ROUTE OvenOpenRot.value_changed TO OvenDoorPivot.set_rotation
ROUTE OvenClose.fraction_changed TO OvenCloseRot.set_fraction
ROUTE OvenCloseRot.value_changed TO OvenDoorPivot.set_rotation

# ChamberDoorPivot: opening cancels the closing clock and vice versa, so the two can never
# drive the same field at the same time.
ROUTE ChamberOpenTouch.touchTime TO ChamberClose.set_stopTime
ROUTE ChamberOpenTouch.touchTime TO ChamberOpen.set_startTime
ROUTE ChamberCloseTouch.touchTime TO ChamberOpen.set_stopTime
ROUTE ChamberCloseTouch.touchTime TO ChamberClose.set_startTime
ROUTE ChamberOpen.fraction_changed TO ChamberOpenRot.set_fraction
ROUTE ChamberOpenRot.value_changed TO ChamberDoorPivot.set_rotation
ROUTE ChamberClose.fraction_changed TO ChamberCloseRot.set_fraction
ROUTE ChamberCloseRot.value_changed TO ChamberDoorPivot.set_rotation

# DrawerSlide: opening cancels the closing clock and vice versa, so the two can never
# drive the same field at the same time.
ROUTE DrawerOpenTouch.touchTime TO DrawerIn.set_stopTime
ROUTE DrawerOpenTouch.touchTime TO DrawerOut.set_startTime
ROUTE DrawerCloseTouch.touchTime TO DrawerOut.set_stopTime
ROUTE DrawerCloseTouch.touchTime TO DrawerIn.set_startTime
ROUTE DrawerOut.fraction_changed TO DrawerOutPos.set_fraction
ROUTE DrawerOutPos.value_changed TO DrawerSlide.set_translation
ROUTE DrawerIn.fraction_changed TO DrawerInPos.set_fraction
ROUTE DrawerInPos.value_changed TO DrawerSlide.set_translation

# TraySlide: opening cancels the closing clock and vice versa, so the two can never
# drive the same field at the same time.
ROUTE TrayOutTouch.touchTime TO TrayIn.set_stopTime
ROUTE TrayOutTouch.touchTime TO TrayOut.set_startTime
ROUTE TrayInTouch.touchTime TO TrayOut.set_stopTime
ROUTE TrayInTouch.touchTime TO TrayIn.set_startTime
ROUTE TrayOut.fraction_changed TO TrayOutPos.set_fraction
ROUTE TrayOutPos.value_changed TO TraySlide.set_translation
ROUTE TrayIn.fraction_changed TO TrayInPos.set_fraction
ROUTE TrayInPos.value_changed TO TraySlide.set_translation

# Cook cycle: start cancels the reset pass; stop cancels the cycle and runs the
# reset pass so the panel and both chamber glows return to their idle values.
ROUTE CookStartTouch.touchTime TO CookReset.set_stopTime
ROUTE CookStartTouch.touchTime TO CookCycle.set_startTime
ROUTE CookStopTouch.touchTime TO CookCycle.set_stopTime
ROUTE CookStopTouch.touchTime TO CookReset.set_startTime

ROUTE CookCycle.fraction_changed TO CookProgress.set_fraction
ROUTE CookCycle.fraction_changed TO HeatColor.set_fraction
ROUTE CookCycle.fraction_changed TO ChamberColor.set_fraction
ROUTE CookCycle.fraction_changed TO PanelHue.set_fraction
ROUTE CookCycle.fraction_changed TO Dot1Color.set_fraction
ROUTE CookCycle.fraction_changed TO Dot2Color.set_fraction
ROUTE CookCycle.fraction_changed TO Dot3Color.set_fraction
ROUTE CookProgress.value_changed TO ProgressFill.set_scale
ROUTE HeatColor.value_changed TO M_HeatBar.set_emissiveColor
ROUTE ChamberColor.value_changed TO M_ChamberGlow.set_emissiveColor
ROUTE PanelHue.value_changed TO M_StatusPlate.set_emissiveColor
ROUTE Dot1Color.value_changed TO M_Dot1.set_emissiveColor
ROUTE Dot2Color.value_changed TO M_Dot2.set_emissiveColor
ROUTE Dot3Color.value_changed TO M_Dot3.set_emissiveColor

ROUTE CookReset.fraction_changed TO ResetProgress.set_fraction
ROUTE CookReset.fraction_changed TO ResetHeat.set_fraction
ROUTE CookReset.fraction_changed TO ResetChamber.set_fraction
ROUTE CookReset.fraction_changed TO ResetPanel.set_fraction
ROUTE CookReset.fraction_changed TO ResetDot.set_fraction
ROUTE ResetProgress.value_changed TO ProgressFill.set_scale
ROUTE ResetHeat.value_changed TO M_HeatBar.set_emissiveColor
ROUTE ResetChamber.value_changed TO M_ChamberGlow.set_emissiveColor
ROUTE ResetPanel.value_changed TO M_StatusPlate.set_emissiveColor
ROUTE ResetDot.value_changed TO M_Dot1.set_emissiveColor
ROUTE ResetDot.value_changed TO M_Dot2.set_emissiveColor
ROUTE ResetDot.value_changed TO M_Dot3.set_emissiveColor
