DEF DoorCycle TimeSensor {
  cycleInterval 6.00
  loop FALSE
  startTime -1
  stopTime 0
}
DEF DoorMotion OrientationInterpolator {
  key [ 0 0.16 0.84 1 ]
  keyValue [
    0 1 0 0
    0 1 0 -1.65
    0 1 0 -1.65
    0 1 0 0
  ]
}
DEF CloseCycle TimeSensor {
  cycleInterval 0.90
  loop FALSE
  startTime -1
  stopTime 0
}
DEF CloseMotion OrientationInterpolator {
  key [ 0 1 ]
  keyValue [
    0 1 0 -1.65
    0 1 0 0
  ]
}
ROUTE LeftDoorTouch.touchTime TO DoorCycle.set_startTime
ROUTE DoorCycle.fraction_changed TO DoorMotion.set_fraction
ROUTE DoorMotion.value_changed TO LeftDoorPivot.set_rotation
ROUTE DoorCycle.isActive TO InteriorLight.set_on
ROUTE CloseDoorTouch.touchTime TO DoorCycle.set_stopTime
ROUTE CloseDoorTouch.touchTime TO CloseCycle.set_startTime
ROUTE CloseCycle.fraction_changed TO CloseMotion.set_fraction
ROUTE CloseMotion.value_changed TO LeftDoorPivot.set_rotation
