DEF PartyClock TimeSensor { cycleInterval 2.2 loop FALSE }
DEF ResetClock TimeSensor { cycleInterval 1.4 loop FALSE }

DEF RibParty OrientationInterpolator { key [ 0, 1 ]
  keyValue [ 0 1 0 0, 0 1 0 4.1888 ] }
DEF InParty OrientationInterpolator { key [ 0, 1 ]
  keyValue [ 0 1 0 0, 0 1 0 2.618 ] }
DEF OutParty OrientationInterpolator { key [ 0, 1 ]
  keyValue [ 0 1 0 0, 0 1 0 -2.3562 ] }
DEF RibReset OrientationInterpolator { key [ 0, 1 ]
  keyValue [ 0 1 0 4.1888, 0 1 0 0 ] }
DEF InReset OrientationInterpolator { key [ 0, 1 ]
  keyValue [ 0 1 0 2.618, 0 1 0 0 ] }
DEF OutReset OrientationInterpolator { key [ 0, 1 ]
  keyValue [ 0 1 0 -2.3562, 0 1 0 0 ] }
DEF OrbBright ColorInterpolator { key [ 0, 1 ] keyValue [ 0.05 0.16 0.18, 0.34 0.84 0.9 ] }
DEF OrbDim ColorInterpolator { key [ 0, 1 ] keyValue [ 0.34 0.84 0.9, 0.05 0.16 0.18 ] }

ROUTE PartyTouch.touchTime TO PartyClock.startTime
ROUTE PartyTouch.touchTime TO ResetClock.stopTime
ROUTE ResetTouch.touchTime TO ResetClock.startTime
ROUTE ResetTouch.touchTime TO PartyClock.stopTime

ROUTE PartyClock.fraction_changed TO RibParty.set_fraction
ROUTE PartyClock.fraction_changed TO InParty.set_fraction
ROUTE PartyClock.fraction_changed TO OutParty.set_fraction
ROUTE PartyClock.fraction_changed TO OrbBright.set_fraction
ROUTE ResetClock.fraction_changed TO RibReset.set_fraction
ROUTE ResetClock.fraction_changed TO InReset.set_fraction
ROUTE ResetClock.fraction_changed TO OutReset.set_fraction
ROUTE ResetClock.fraction_changed TO OrbDim.set_fraction

ROUTE RibParty.value_changed TO RibbonRotor.set_rotation
ROUTE RibReset.value_changed TO RibbonRotor.set_rotation
ROUTE InParty.value_changed TO BubbleClusterInner.set_rotation
ROUTE InReset.value_changed TO BubbleClusterInner.set_rotation
ROUTE OutParty.value_changed TO BubbleClusterOuter.set_rotation
ROUTE OutReset.value_changed TO BubbleClusterOuter.set_rotation
ROUTE OrbBright.value_changed TO OrbMat.set_emissiveColor
ROUTE OrbDim.value_changed TO OrbMat.set_emissiveColor
