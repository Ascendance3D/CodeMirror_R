WorldInfo {
  title "Bass Civic CT Deep Purple Fern"
  info [
    "Made By: BassMekanik"
    "Uploaded: August, 2026"
    "Category: Vehicles"
    "Limited To: 1/20"
    "Mall Price: 95 CC"
    "Deep purple fern with an iridescent sheen over the 1980s Cybertown coupe."
    "Restored from the creator's own 2003-2004 Cybertown Civic files."
    "Original design. No real manufacturer, model or emblem is represented."
  ]
}

