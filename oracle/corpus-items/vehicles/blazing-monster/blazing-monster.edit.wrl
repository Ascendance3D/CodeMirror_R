#VRML V2.0 utf8

WorldInfo {
  title "Blazing Monster"
  info [
    "Made By: BassMekanik"
    "Uploaded: July, 2026"
    "Limited To: UNLIMITED"
    "Mall Price: 75 CC"
  ]
}

