DEF ECLIPSE_CLOCK TimeSensor { cycleInterval 16 loop FALSE startTime 0 stopTime 0 }
DEF RETURN_CLOCK TimeSensor { cycleInterval 2.5 loop FALSE startTime 0 stopTime 0 }
DEF ECLIPSE_LOGIC Script {
  eventIn SFTime touch
  eventIn SFFloat fraction
  eventIn SFBool clockActive
  eventIn SFFloat returnFraction
  eventIn SFBool returnActive
  eventOut SFTime startClock
  eventOut SFTime stopClock
  eventOut SFTime startReturn
  eventOut SFFloat pose
  field SFInt32 mode 0
  field SFFloat last 0
  field SFFloat fromPose 0
  field SFFloat toPose 0
  url [ "ecmascript:
function touch(v, t) {
  if (mode == 0) { mode = 1; last = 0; startClock = v; }
  else if (mode == 1) { mode = 2; fromPose = last; toPose = last < 0.47 ? 0 : 1; stopClock = v; startReturn = v; }
}
function fraction(f, t) { if (mode == 1) { last = f; pose = f; } }
function clockActive(a, t) { if (!a && mode == 1) { mode = 0; pose = 0; } }
function returnFraction(g, t) { if (mode == 2) pose = fromPose + (toPose - fromPose) * g; }
function returnActive(a, t) { if (!a && mode == 2) { mode = 0; pose = 0; } }"
        "castlescript:
function touch(v, t)
  if(mode = 0,
     mode := 1; last := 0.0; startClock := v,
     when(mode = 1,
          mode := 2; fromPose := last; toPose := if(last < 0.47, 0.0, 1.0); stopClock := v; startReturn := v))
function fraction(f, t)
  when(mode = 1, last := f; pose := f)
function clockActive(a, t)
  when(and(not(a), mode = 1), mode := 0; pose := 0.0)
function returnFraction(g, t)
  when(mode = 2, pose := fromPose + (toPose - fromPose) * g)
function returnActive(a, t)
  when(and(not(a), mode = 2), mode := 0; pose := 0.0)" ]
}
