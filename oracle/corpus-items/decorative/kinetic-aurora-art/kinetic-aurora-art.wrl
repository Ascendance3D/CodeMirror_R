            material Material { diffuseColor 0 0 0 transparency 1 }
          }
          geometry Box { size 0.070 0.038 0.018 }
        }
      ]
    }
    DEF LoopClock TimeSensor {
      cycleInterval 18
      loop TRUE
      startTime 0
      stopTime 1
    }
    DEF DriftOuter OrientationInterpolator {
      key [ 0 0.125 0.25 0.375 0.5 0.625 0.75 0.875 1 ]
      keyValue [ 0 0 1 0 0 0 1 -0.0273 0 0 1 -0.0873 0 0 1 -0.1473 0 0 1 -0.1745 0 0 1 -0.1473 0 0 1 -0.0873 0 0 1 -0.0273 0 0 1 0 ]
    }
    DEF DriftTeal OrientationInterpolator {
      key [ 0 0.125 0.25 0.375 0.5 0.625 0.75 0.875 1 ]
      keyValue [ 0 0 1 0 0 0 1 0.0355 0 0 1 0.1134 0 0 1 0.1914 0 0 1 0.2269 0 0 1 0.1914 0 0 1 0.1134 0 0 1 0.0355 0 0 1 0 ]
    }
    DEF DriftBlue OrientationInterpolator {
      key [ 0 0.125 0.25 0.375 0.5 0.625 0.75 0.875 1 ]
      keyValue [ 0 0 1 0 0 0 1 -0.0409 0 0 1 -0.1309 0 0 1 -0.2209 0 0 1 -0.2618 0 0 1 -0.2209 0 0 1 -0.1309 0 0 1 -0.0409 0 0 1 0 ]
    }
    DEF DriftViolet OrientationInterpolator {
      key [ 0 0.125 0.25 0.375 0.5 0.625 0.75 0.875 1 ]
      keyValue [ 0 0 1 0 0 0 1 0.0273 0 0 1 0.0873 0 0 1 0.1473 0 0 1 0.1745 0 0 1 0.1473 0 0 1 0.0873 0 0 1 0.0273 0 0 1 0 ]
    }
  ]
}

ROUTE OnTouch.touchTime TO LoopClock.set_startTime
ROUTE OffTouch.touchTime TO LoopClock.set_stopTime
ROUTE LoopClock.fraction_changed TO DriftOuter.set_fraction
ROUTE DriftOuter.value_changed TO ArcOuter.set_rotation
ROUTE LoopClock.fraction_changed TO DriftTeal.set_fraction
ROUTE DriftTeal.value_changed TO ArcTeal.set_rotation
ROUTE LoopClock.fraction_changed TO DriftBlue.set_fraction
ROUTE DriftBlue.value_changed TO ArcBlue.set_rotation
ROUTE LoopClock.fraction_changed TO DriftViolet.set_fraction
ROUTE DriftViolet.value_changed TO ArcViolet.set_rotation
