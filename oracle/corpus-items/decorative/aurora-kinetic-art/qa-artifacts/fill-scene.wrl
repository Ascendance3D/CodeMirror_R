ROUTE ShiftTouch.touchTime TO ShiftClock.set_startTime
ROUTE ShiftTouch.touchTime TO HomeClock.set_stopTime
ROUTE HomeTouch.touchTime TO HomeClock.set_startTime
ROUTE HomeTouch.touchTime TO ShiftClock.set_stopTime

ROUTE ShiftClock.fraction_changed TO Arc1_OuterShift.set_fraction
ROUTE Arc1_OuterShift.value_changed TO Arc1_Outer.set_rotation
ROUTE HomeClock.fraction_changed TO Arc1_OuterHome.set_fraction
ROUTE Arc1_OuterHome.value_changed TO Arc1_Outer.set_rotation
ROUTE ShiftClock.fraction_changed TO Arc2_TealShift.set_fraction
