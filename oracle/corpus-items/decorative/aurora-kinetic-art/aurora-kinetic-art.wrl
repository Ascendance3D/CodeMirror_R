          translation 0.1000 0.0550 0.0420
          children Shape {
            appearance USE ApHit
            geometry Box { size 0.024 0.024 0.010 }
          }
        }
      ]
    }
    DEF ShiftClock TimeSensor {
      cycleInterval 1.7
      loop FALSE
      startTime 4102444800
      stopTime 0
    }
    DEF HomeClock TimeSensor {
      cycleInterval 1.3
      loop FALSE
      startTime 4102444800
      stopTime 0
    }
    DEF Arc1_OuterShift OrientationInterpolator {
      key [ 0, 1 ]
      keyValue [ 0 0 1 0, 0 0 1 0.20944 ]
