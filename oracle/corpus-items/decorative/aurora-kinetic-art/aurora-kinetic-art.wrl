            geometry Box { size 0.050 0.016 0.010 }
          }
        }
      ]
    }
    Group {
      children [
        DEF HomeTouch TouchSensor { description "HOME" }
        Transform {
          translation 0.1000 0.0550 0.0420
          rotation 1 0 0 1.5708
          children Shape {
