# ============================ CLOCKS ============================
# Off at load: startTime 4102444800 is 2100-01-01, so a loop TRUE clock
# is idle until a control sets startTime. startTime 1 would be 1970.
DEF SpinClock TimeSensor { cycleInterval 1 loop TRUE startTime 4102444800 }

# Deployment and fold each need TWO nodes. A loop FALSE clock ends at
# fraction 1.0 and HOLDS the pose, but emits no end event. A loop TRUE
# clock routed to its own stopTime runs exactly one cycle and DOES emit
# an end event (its first cycleTime equals startTime, and stopTime <=
# startTime is ignored) -- but at its wrap it emits fraction 0 and would
# snap every interpolator back to key 0. So: one of each.
DEF SeqClock    TimeSensor { cycleInterval 6 loop FALSE }
DEF DeployGuard TimeSensor { cycleInterval 6 loop TRUE startTime 4102444800 }
ROUTE DeployGuard.cycleTime TO DeployGuard.set_stopTime
DEF FoldSeq   TimeSensor { cycleInterval 2 loop FALSE }
DEF FoldGuard TimeSensor { cycleInterval 2 loop TRUE startTime 4102444800 }
ROUTE FoldGuard.cycleTime TO FoldGuard.set_stopTime

# Beat aligner. Armed only after STOP, it fires on the next SpinClock
# cycleTime, so the spin is always stopped at fraction 0 == R(0). That is
# what makes restart snap-free: START also begins at fraction 0.
DEF StopLatch TimeSensor { cycleInterval 1 loop TRUE startTime 4102444800 }
DEF StopRelay TimeSensor { cycleInterval 0.001 loop FALSE enabled FALSE }
ROUTE StopLatch.isActive  TO StopRelay.set_enabled
ROUTE SpinClock.cycleTime TO StopRelay.set_startTime

# START is applied through a relay so SpinClock restarts in a strictly
# LATER event cascade than the StopLatch disarm. Routed direct, SpinClock
# emits cycleTime into a still-armed StopRelay and re-fires the fold on
# the very frame the user restarts. Measured, then fixed.
DEF StartRelay TimeSensor { cycleInterval 0.001 loop FALSE }

# A window latch can only CLOSE if its stopTime is strictly later than a
# startTime that arrived on the same beat; these supply that offset.
DEF StartNudge TimeSensor { cycleInterval 0.02 loop TRUE startTime 4102444800 }
ROUTE StartNudge.cycleTime TO StartNudge.set_stopTime
DEF FoldNudge TimeSensor { cycleInterval 0.02 loop TRUE startTime 4102444800 }
ROUTE FoldNudge.cycleTime TO FoldNudge.set_stopTime

# StopFree: TRUE at load, FALSE for the whole deployment, TRUE once
# deployed. This is what makes a mid-bloom STOP impossible -- the crown
# can never be caught half-open, so the fold always starts from a known
# fully-open pose and there is no jump.
DEF StopFree TimeSensor { cycleInterval 1 loop TRUE startTime 0 stopTime 0 }
ROUTE DeployGuard.cycleTime TO StopFree.set_startTime
ROUTE StartNudge.cycleTime  TO StopFree.set_stopTime
ROUTE StopTouch.touchTime   TO StopFree.set_stopTime
ROUTE StopFree.isActive     TO StopTouch.set_enabled

# StartFree: FALSE while folding, TRUE once the fold has finished, so a
# restart cannot be issued into a half-closed crown.
DEF StartFree TimeSensor { cycleInterval 1 loop TRUE startTime 4102444800 }
ROUTE FoldGuard.cycleTime  TO StartFree.set_startTime
ROUTE FoldNudge.cycleTime  TO StartFree.set_stopTime
ROUTE StartTouch.touchTime TO StartFree.set_stopTime
ROUTE StartFree.isActive   TO StartTouch.set_enabled

# ======================== INTERPOLATORS =========================
# Quarter-turn keys, never one 0 -> 2pi key: a slerp takes the short way
# round, so a single full-turn key would slerp to nowhere.
DEF SpinTurn OrientationInterpolator {
  key [ 0, 0.25, 0.5, 0.75, 1 ]
  keyValue [ 0 1 0 0, 0 1 0 1.5708, 0 1 0 3.14159, 0 1 0 4.71239, 0 1 0 6.28319 ]
}
# Halo counter-rotates exactly -120 deg per body turn. Ring + 3 spokes +
# 3 beads is EXACTLY 3-fold, so the wrap and the reset are invisible.
DEF HaloTurn OrientationInterpolator {
  key [ 0, 0.33333, 0.66667, 1 ]
  keyValue [ 0 1 0 0, 0 1 0 -0.69813, 0 1 0 -1.39626, 0 1 0 -2.0944 ]
}
