DEF BandMDn ColorInterpolator {
  key [ 0, 0.55, 1 ]
  keyValue [ 0.72 0.1 0.42, 0.05 0.01 0.03, 0.05 0.01 0.03 ]
}
DEF BandLUp ColorInterpolator {
  key [ 0, 0.12, 0.44, 1 ]
  keyValue [ 0.03 0.05 0.01, 0.03 0.05 0.01, 0.44 0.7 0.14, 0.44 0.7 0.14 ]
}
DEF BandLDn ColorInterpolator {
  key [ 0, 0.55, 1 ]
  keyValue [ 0.44 0.7 0.14, 0.03 0.05 0.01, 0.03 0.05 0.01 ]
}

# ============================ ROUTES ============================
# Disarm BEFORE the restart -- order matters, see StartRelay above.
ROUTE StartTouch.touchTime TO StopLatch.set_stopTime
ROUTE StartTouch.touchTime TO FoldSeq.set_stopTime
ROUTE StartTouch.touchTime TO FoldGuard.set_stopTime
ROUTE StartTouch.touchTime TO StartNudge.set_startTime
ROUTE StartTouch.touchTime TO StartRelay.set_startTime
ROUTE StartRelay.cycleTime TO SpinClock.set_startTime
ROUTE StartRelay.cycleTime TO SeqClock.set_startTime
ROUTE StartRelay.cycleTime TO DeployGuard.set_startTime

ROUTE StopTouch.touchTime  TO StopLatch.set_startTime
ROUTE StopRelay.cycleTime  TO SpinClock.set_stopTime
ROUTE StopRelay.cycleTime  TO SeqClock.set_stopTime
ROUTE StopRelay.cycleTime  TO DeployGuard.set_stopTime
ROUTE StopRelay.cycleTime  TO FoldSeq.set_startTime
ROUTE StopRelay.cycleTime  TO FoldGuard.set_startTime
ROUTE StopRelay.cycleTime  TO FoldNudge.set_startTime

ROUTE SpinClock.fraction_changed TO SpinTurn.set_fraction
ROUTE SpinTurn.value_changed     TO SpinRoot.set_rotation
ROUTE SpinClock.fraction_changed TO HaloTurn.set_fraction
ROUTE HaloTurn.value_changed     TO HaloRoot.set_rotation

ROUTE SeqClock.fraction_changed TO RampTurn.set_fraction
ROUTE RampTurn.value_changed TO RampRoot.set_rotation
ROUTE SeqClock.fraction_changed TO WobbleSet.set_fraction
ROUTE WobbleSet.value_changed TO WobbleRoot.set_rotation
ROUTE SeqClock.fraction_changed TO PlungeDown.set_fraction
ROUTE PlungeDown.value_changed TO PlungerT.set_translation
ROUTE SeqClock.fraction_changed TO BloomOpen.set_fraction
ROUTE BloomOpen.value_changed TO Fin1.set_rotation
ROUTE BloomOpen.value_changed TO Fin2.set_rotation
ROUTE BloomOpen.value_changed TO Fin3.set_rotation
ROUTE SeqClock.fraction_changed TO CoreUp.set_fraction
ROUTE CoreUp.value_changed       TO CoreMat.set_emissiveColor
ROUTE SeqClock.fraction_changed TO InnerUp.set_fraction
ROUTE InnerUp.value_changed      TO InnerMat.set_emissiveColor
ROUTE SeqClock.fraction_changed TO BandCUp.set_fraction
ROUTE BandCUp.value_changed TO BandCMat.set_emissiveColor
ROUTE SeqClock.fraction_changed TO BandMUp.set_fraction
ROUTE BandMUp.value_changed TO BandMMat.set_emissiveColor
ROUTE SeqClock.fraction_changed TO BandLUp.set_fraction
ROUTE BandLUp.value_changed TO BandLMat.set_emissiveColor

ROUTE FoldSeq.fraction_changed TO CoastTurn.set_fraction
ROUTE CoastTurn.value_changed  TO CoastRoot.set_rotation
ROUTE FoldSeq.fraction_changed TO BloomShut.set_fraction
ROUTE BloomShut.value_changed TO Fin1.set_rotation
ROUTE BloomShut.value_changed TO Fin2.set_rotation
ROUTE BloomShut.value_changed TO Fin3.set_rotation
ROUTE FoldSeq.fraction_changed TO PlungeUp.set_fraction
ROUTE PlungeUp.value_changed   TO PlungerT.set_translation
ROUTE FoldSeq.fraction_changed TO CoreDown.set_fraction
ROUTE CoreDown.value_changed   TO CoreMat.set_emissiveColor
ROUTE FoldSeq.fraction_changed TO InnerDown.set_fraction
ROUTE InnerDown.value_changed  TO InnerMat.set_emissiveColor
ROUTE FoldSeq.fraction_changed TO BandCDn.set_fraction
ROUTE BandCDn.value_changed TO BandCMat.set_emissiveColor
ROUTE FoldSeq.fraction_changed TO BandMDn.set_fraction
ROUTE BandMDn.value_changed TO BandMMat.set_emissiveColor
ROUTE FoldSeq.fraction_changed TO BandLDn.set_fraction
ROUTE BandLDn.value_changed TO BandLMat.set_emissiveColor
