#VRML V2.0 utf8

WorldInfo {
  title "Glen Waterwheel Mill"
  info [
    "Made By: BassMekanik"
    "Uploaded: August, 2026"
    "Store: Toy Store"
    "Limited To: UNLIMITED"
    "Mall Price: 50 CC"
    "Collection: Glen Outdoor Playset - No. 1 of 5"
    "A little glen on a turned plinth: waterwheel, mill race, rowing boat and two trees."
    "Touch RUN on the plinth to turn the wheel, HALT to stop it."
    "Toy Store Contest"
  ]
}

