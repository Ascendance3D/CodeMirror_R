ROUTE RoofTouch.touchTime TO DeployScript.touch
ROUTE RoofTouch.touchTime TO SwitchPulse.set_startTime
ROUTE Clock.fraction_changed TO DeployScript.tick
ROUTE DeployScript.clockRun_changed TO Clock.set_enabled
ROUTE DeployScript.progress_changed TO CabRiseInterp.set_fraction
ROUTE CabRiseInterp.value_changed TO CabMove.set_translation
ROUTE DeployScript.progress_changed TO LeftPodSwingInterp.set_fraction
ROUTE LeftPodSwingInterp.value_changed TO LeftPodSwing.set_rotation
ROUTE DeployScript.progress_changed TO RightPodSwingInterp.set_fraction
ROUTE RightPodSwingInterp.value_changed TO RightPodSwing.set_rotation
ROUTE DeployScript.progress_changed TO LegInterp.set_fraction
ROUTE LegInterp.value_changed TO LeftLegHinge.set_rotation
ROUTE LegInterp.value_changed TO RightLegHinge.set_rotation
ROUTE DeployScript.progress_changed TO MastInterp.set_fraction
ROUTE MastInterp.value_changed TO MastHinge.set_rotation
ROUTE DeployScript.progress_changed TO DishUnfoldInterp.set_fraction
ROUTE DishUnfoldInterp.value_changed TO DishFoldPivot.set_rotation
ROUTE DeployScript.scanRotation_changed TO DishSpin.set_rotation
ROUTE DeployScript.progress_changed TO IndCyanInterp.set_fraction
ROUTE IndCyanInterp.value_changed TO APP_IND_CYANMat.set_emissiveColor
ROUTE DeployScript.progress_changed TO IndAmberInterp.set_fraction
ROUTE IndAmberInterp.value_changed TO APP_IND_AMBERMat.set_emissiveColor
ROUTE DeployScript.progress_changed TO IndGreenInterp.set_fraction
ROUTE IndGreenInterp.value_changed TO APP_IND_GREENMat.set_emissiveColor
ROUTE SwitchPulse.fraction_changed TO SwitchDepressInterp.set_fraction
ROUTE SwitchDepressInterp.value_changed TO SwitchCapMove.set_translation
ROUTE SwitchPulse.fraction_changed TO SwitchGlowInterp.set_fraction
ROUTE SwitchGlowInterp.value_changed TO APP_SWITCHCAPMat.set_emissiveColor
