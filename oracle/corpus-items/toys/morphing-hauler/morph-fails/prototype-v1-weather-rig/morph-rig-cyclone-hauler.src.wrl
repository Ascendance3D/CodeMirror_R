  DEF DeployScript Script {
    eventIn SFTime touch
    eventIn SFFloat tick
    eventOut SFFloat progress_changed
    eventOut SFRotation scanRotation_changed
    eventOut SFBool clockRun_changed
    field SFBool target FALSE
    field SFFloat progress 0
    field SFTime lastTime -1
    field SFBool clockOn FALSE
    field SFFloat scanAngle 0
    url [ "javascript:function touch(v) {target = !target;if (!clockOn) { lastTime = -1.0; clockOn = true; clockRun_changed = true; } }function tick(v, ts) {if (lastTime < 0.0) { lastTime = ts; return; }var dt = ts - lastTime;lastTime = ts;var dir = 0.22222222;if (!target) dir = -0.22222222;progress = progress + dir*dt;if (progress > 1.0) progress = 1.0;if (progress < 0.0) progress = 0.0;progress_changed = progress;var scanning = false;if (target) { if (progress >= 1.0) scanning = true; }if (scanning) {scanAngle = scanAngle + 1.04719755*dt;if (scanAngle > 6.28318531) scanAngle = scanAngle - 6.28318531;} else { scanAngle = 0.0; }scanRotation_changed = new SFRotation(0, 1, 0, scanAngle);if (progress <= 0.0 && !target && clockOn) { clockOn = false; clockRun_changed = false; } }" ]
  }
