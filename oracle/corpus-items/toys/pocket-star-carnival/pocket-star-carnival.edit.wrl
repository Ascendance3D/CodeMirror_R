DEF LidOpenClock TimeSensor { cycleInterval 1.5 loop FALSE }
DEF LidShutClock TimeSensor { cycleInterval 1.5 loop FALSE }
DEF LidOpenPath OrientationInterpolator {
  key [ 0, 0.5, 1 ]
  keyValue [ 1 0 0 0, 1 0 0 -0.9425, 1 0 0 -1.885 ]
}
DEF LidShutPath OrientationInterpolator {
  key [ 0, 0.5, 1 ]
  keyValue [ 1 0 0 -1.885, 1 0 0 -0.9425, 1 0 0 0 ]
}

ROUTE OpenTouch.touchTime TO LidOpenClock.set_startTime
ROUTE OpenTouch.touchTime TO LidShutClock.set_stopTime
ROUTE CloseTouch.touchTime TO LidShutClock.set_startTime
ROUTE CloseTouch.touchTime TO LidOpenClock.set_stopTime
ROUTE LidOpenClock.fraction_changed TO LidOpenPath.set_fraction
ROUTE LidShutClock.fraction_changed TO LidShutPath.set_fraction
ROUTE LidOpenPath.value_changed TO LidTilt.set_rotation
ROUTE LidShutPath.value_changed TO LidTilt.set_rotation
