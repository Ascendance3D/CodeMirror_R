# ------------------------------------------------ behaviour graph
# Nothing runs at load: every TimeSensor has loop FALSE and a startTime
# in the year 2100. One TouchSensor per zone, toggled by that zone's
# Script, so the same control opens and then closes the feature.
DEF OvenOpen TimeSensor { cycleInterval 1.300 loop FALSE startTime 4102444800 stopTime 0 }
DEF OvenClose TimeSensor { cycleInterval 1.300 loop FALSE startTime 4102444800 stopTime 0 }
DEF ConsoleOpen TimeSensor { cycleInterval 1.500 loop FALSE startTime 4102444800 stopTime 0 }
DEF ConsoleClose TimeSensor { cycleInterval 1.500 loop FALSE startTime 4102444800 stopTime 0 }
DEF DrawerOpen TimeSensor { cycleInterval 1.200 loop FALSE startTime 4102444800 stopTime 0 }
DEF DrawerClose TimeSensor { cycleInterval 1.200 loop FALSE startTime 4102444800 stopTime 0 }

DEF OvenToggle Script {
  eventIn  SFTime toggle
  eventOut SFTime openStart
  eventOut SFTime closeStart
  field    SFBool isOpen FALSE
  url [ "javascript: function toggle(t) { if (isOpen) { closeStart = t; isOpen = false; } else { openStart = t; isOpen = true; } }" ]
}
DEF ConsoleToggle Script {
  eventIn  SFTime toggle
  eventOut SFTime openStart
  eventOut SFTime closeStart
  field    SFBool isOpen FALSE
  url [ "javascript: function toggle(t) { if (isOpen) { closeStart = t; isOpen = false; } else { openStart = t; isOpen = true; } }" ]
}
DEF DrawerToggle Script {
  eventIn  SFTime toggle
  eventOut SFTime openStart
  eventOut SFTime closeStart
  field    SFBool isOpen FALSE
  url [ "javascript: function toggle(t) { if (isOpen) { closeStart = t; isOpen = false; } else { openStart = t; isOpen = true; } }" ]
}

