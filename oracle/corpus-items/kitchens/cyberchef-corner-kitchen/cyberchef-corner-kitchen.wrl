#VRML V2.0 utf8
WorldInfo {
  title "CyberChef Corner Kitchen"
  info [
    "Made By: Ryan (BassMekanik)"
    "Uploaded: July, 2026"
    "Limited To: 1/75"
    "Mall Price: 100 CC"
    "Kitchen Store Contest July 2026"
  ]
}

# CyberChef Corner Kitchen
# L-shaped corner kitchen unit for the Cybertown Revival Mall.
# Back leg (along X) carries the sink + faucet; right leg (along Z) carries
# the four-burner induction cooktop with an oven below. Pure-material build,
# all VRML97 primitives (Box/Cylinder) so shells are closed and correctly
# wound by construction. Lowest point Y = -1.75, centered on X = 0, max Z < 1.

DEF CyberChefCornerKitchen Transform {
  translation -0.005 0 0
  children [

    # ---------- Base cabinet bodies (charcoal-navy) ----------
    # Back leg base
    Transform { translation 0 -1.225 -0.25 children [
      Shape {
        appearance Appearance { material DEF M_Body Material {
          ambientIntensity 0.25 diffuseColor 0.15 0.16 0.20
          specularColor 0.15 0.15 0.18 shininess 0.25 } }
        geometry Box { size 2.60 1.05 0.70 }
      } ] }
    # Right leg base
    Transform { translation 0.95 -1.225 0.50 children [
      Shape { appearance Appearance { material USE M_Body }
        geometry Box { size 0.70 1.05 0.80 } } ] }

    # Toe-kick plates (dark)
    Transform { translation 0 -1.69 0.10 children [
      Shape {
        appearance Appearance { material DEF M_Dark Material {
          ambientIntensity 0.2 diffuseColor 0.05 0.06 0.08
          specularColor 0.5 0.5 0.55 shininess 0.55 } }
        geometry Box { size 2.50 0.12 0.02 }
      } ] }
    Transform { translation 0.95 -1.69 0.895 children [
      Shape { appearance Appearance { material USE M_Dark }
        geometry Box { size 0.60 0.12 0.02 } } ] }
    # Range leg -X toe kick (under the oven, mirrors the +Z kick)
    Transform { translation 0.585 -1.69 0.50 children [
      Shape { appearance Appearance { material USE M_Dark }
        geometry Box { size 0.02 0.12 0.70 } } ] }

    # ---------- Countertop (warm surface) around sink opening ----------
    # Left of sink
    Transform { translation -1.07 -0.66 -0.24 children [
      Shape {
        appearance Appearance { material DEF M_Counter Material {
          ambientIntensity 0.3 diffuseColor 0.78 0.70 0.55
          specularColor 0.30 0.30 0.30 shininess 0.35 } }
        geometry Box { size 0.54 0.08 0.76 }
      } ] }
    # Right of sink (spans to corner)
    Transform { translation 0.52 -0.66 -0.24 children [
      Shape { appearance Appearance { material USE M_Counter }
        geometry Box { size 1.64 0.08 0.76 } } ] }
    # Back of sink
    Transform { translation -0.55 -0.66 -0.52 children [
      Shape { appearance Appearance { material USE M_Counter }
        geometry Box { size 0.50 0.08 0.20 } } ] }
    # Front of sink
    Transform { translation -0.55 -0.66 0.03 children [
      Shape { appearance Appearance { material USE M_Counter }
        geometry Box { size 0.50 0.08 0.22 } } ] }
    # Right leg counter
    Transform { translation 0.95 -0.66 0.50 children [
      Shape { appearance Appearance { material USE M_Counter }
        geometry Box { size 0.76 0.08 0.84 } } ] }

    # ---------- Sink basin (recessed dark) ----------
    Transform { translation -0.55 -0.74 -0.25 children [
      Shape { appearance Appearance { material USE M_Dark }
        geometry Box { size 0.50 0.16 0.34 } } ] }

    # ---------- Backsplash (glass mosaic tile), full-height feature wall ----------
    # White diffuse so the tile keeps its own colours; TextureTransform repeats
    # the square mosaic so tiles stay ~0.31 m square across every panel.
    # Back-leg wall: one full-height panel
    Transform { translation 0 0.115 -0.58 children [
      Shape {
        appearance Appearance {
          material DEF M_White Material {
            ambientIntensity 0.35 diffuseColor 1 1 1
            specularColor 0.25 0.25 0.28 shininess 0.35 }
          texture DEF T_Splash ImageTexture { url [ "backsplash.jpg" ] }
          textureTransform TextureTransform { scale 8.4 4.7 }
        }
        geometry Box { size 2.60 1.47 0.04 }
      } ] }
    # Right-return wall: four tile panels around the pass-through window
    # (window opening Z 0.20..0.85, Y 0.00..0.55). Back panel:
    Transform { translation 1.30 0.115 -0.20 children [
      Shape { appearance Appearance { material USE M_White
        texture USE T_Splash textureTransform TextureTransform { scale 2.6 4.7 } }
        geometry Box { size 0.04 1.47 0.80 } } ] }
    # Front sliver
    Transform { translation 1.30 0.115 0.875 children [
      Shape { appearance Appearance { material USE M_White
        texture USE T_Splash textureTransform TextureTransform { scale 0.2 4.7 } }
        geometry Box { size 0.04 1.47 0.05 } } ] }
    # Below window
    Transform { translation 1.30 -0.31 0.525 children [
      Shape { appearance Appearance { material USE M_White
        texture USE T_Splash textureTransform TextureTransform { scale 2.1 2.0 } }
        geometry Box { size 0.04 0.62 0.65 } } ] }
    # Above window
    Transform { translation 1.30 0.70 0.525 children [
      Shape { appearance Appearance { material USE M_White
        texture USE T_Splash textureTransform TextureTransform { scale 2.1 1.0 } }
        geometry Box { size 0.04 0.30 0.65 } } ] }
    # Cyan accent line at the counter / backsplash junction
    Transform { translation 0 -0.575 -0.56 children [
      Shape {
        appearance Appearance { material DEF M_Cyan Material {
          ambientIntensity 0.1 diffuseColor 0.0 0.55 0.55
          emissiveColor 0.0 0.55 0.55 specularColor 0.2 0.2 0.2
          shininess 0.4 } }
        geometry Box { size 2.56 0.02 0.02 }
      } ] }

    # ---------- Faucet (brushed metal) ----------
    Transform { translation -0.55 -0.47 -0.40 children [
      Shape {
        appearance Appearance { material DEF M_Metal Material {
          ambientIntensity 0.3 diffuseColor 0.66 0.68 0.72
          specularColor 0.9 0.9 0.9 shininess 0.65 } }
        geometry Cylinder { radius 0.025 height 0.30 }
      } ] }
    Transform { translation -0.55 -0.33 -0.30 rotation 1 0 0 1.5708 children [
      Shape { appearance Appearance { material USE M_Metal }
        geometry Cylinder { radius 0.02 height 0.22 } } ] }
    Transform { translation -0.55 -0.37 -0.20 children [
      Shape { appearance Appearance { material USE M_Metal }
        geometry Cylinder { radius 0.016 height 0.07 } } ] }
    Transform { translation -0.70 -0.60 -0.42 children [
      Shape { appearance Appearance { material USE M_Metal }
        geometry Cylinder { radius 0.02 height 0.05 } } ] }
    Transform { translation -0.40 -0.60 -0.42 children [
      Shape { appearance Appearance { material USE M_Metal }
        geometry Cylinder { radius 0.02 height 0.05 } } ] }

    # ---------- Cooktop + four induction burners ----------
    Transform { translation 0.95 -0.605 0.50 children [
      Shape { appearance Appearance { material USE M_Dark }
        geometry Box { size 0.62 0.03 0.62 } } ] }

    Transform { translation 0.82 -0.582 0.37 children [
      DEF Burner Transform { children [
        Shape { appearance Appearance { material USE M_Dark }
          geometry Cylinder { radius 0.11 height 0.014 } }
        Transform { translation 0 0.009 0 children [
          Shape { appearance Appearance { material USE M_Cyan }
            geometry Cylinder { radius 0.072 height 0.016 } } ] }
      ] }
    ] }
    Transform { translation 1.08 -0.582 0.37 children [ USE Burner ] }
    Transform { translation 0.82 -0.582 0.63 children [ USE Burner ] }
    Transform { translation 1.08 -0.582 0.63 children [ USE Burner ] }

    # ---------- Range control knobs (cyan) on the -X face, above the oven ----------
    Transform { translation 0.565 -0.66 0.35 rotation 0 0 1 1.5708 children [
      Shape { appearance Appearance { material USE M_Cyan }
        geometry Cylinder { radius 0.022 height 0.05 } } ] }
    Transform { translation 0.565 -0.66 0.50 rotation 0 0 1 1.5708 children [
      Shape { appearance Appearance { material USE M_Cyan }
        geometry Cylinder { radius 0.022 height 0.05 } } ] }
    Transform { translation 0.565 -0.66 0.65 rotation 0 0 1 1.5708 children [
      Shape { appearance Appearance { material USE M_Cyan }
        geometry Cylinder { radius 0.022 height 0.05 } } ] }

    # ---------- Oven (below cooktop, door now faces -X toward the sink) ----------
    Transform { translation 0.585 -1.10 0.50 children [
      Shape { appearance Appearance { material USE M_Dark }
        geometry Box { size 0.03 0.66 0.62 } } ] }
    # Oven handle (horizontal, running along Z on the -X face)
    Transform { translation 0.565 -0.82 0.50 rotation 1 0 0 1.5708 children [
      Shape { appearance Appearance { material USE M_Metal }
        geometry Cylinder { radius 0.016 height 0.50 } } ] }
    # Oven display strip
    Transform { translation 0.57 -0.80 0.50 children [
      Shape { appearance Appearance { material USE M_Cyan }
        geometry Box { size 0.01 0.03 0.34 } } ] }

    # ---------- Base cabinet doors + drawer fronts (navy) ----------
    # Door under sink
    Transform { translation -0.55 -1.10 0.115 children [
      Shape {
        appearance Appearance { material DEF M_Cabinet Material {
          ambientIntensity 0.25 diffuseColor 0.16 0.19 0.30
          specularColor 0.30 0.30 0.35 shininess 0.4 } }
        geometry Box { size 0.52 0.66 0.03 }
      } ] }
    # Left door
    Transform { translation -1.05 -1.10 0.115 children [
      Shape { appearance Appearance { material USE M_Cabinet }
        geometry Box { size 0.44 0.66 0.03 } } ] }
    # Two drawer fronts (between sink and range)
    Transform { translation 0.15 -0.83 0.115 children [
      Shape { appearance Appearance { material USE M_Cabinet }
        geometry Box { size 0.52 0.18 0.03 } } ] }
    Transform { translation 0.15 -1.20 0.115 children [
      Shape { appearance Appearance { material USE M_Cabinet }
        geometry Box { size 0.52 0.44 0.03 } } ] }

    # Base handles (metal)
    # Under-sink door handle: vertical, inner edge, matching the left door handle
    Transform { translation -0.77 -1.10 0.135 children [
      Shape { appearance Appearance { material USE M_Metal }
        geometry Box { size 0.03 0.16 0.02 } } ] }
    Transform { translation -0.86 -1.10 0.135 children [
      Shape { appearance Appearance { material USE M_Metal }
        geometry Box { size 0.03 0.16 0.02 } } ] }
    Transform { translation 0.15 -0.83 0.135 children [
      Shape { appearance Appearance { material USE M_Metal }
        geometry Box { size 0.22 0.03 0.02 } } ] }
    Transform { translation 0.15 -1.12 0.135 children [
      Shape { appearance Appearance { material USE M_Metal }
        geometry Box { size 0.22 0.03 0.02 } } ] }

    # ---------- Modest upper cabinet (over sink) ----------
    Transform { translation -0.40 0.16 -0.44 children [
      Shape { appearance Appearance { material USE M_Body }
        geometry Box { size 1.40 0.52 0.32 } } ] }
    Transform { translation -0.73 0.16 -0.275 children [
      Shape { appearance Appearance { material USE M_Cabinet }
        geometry Box { size 0.66 0.46 0.02 } } ] }
    Transform { translation -0.07 0.16 -0.275 children [
      Shape { appearance Appearance { material USE M_Cabinet }
        geometry Box { size 0.66 0.46 0.02 } } ] }
    Transform { translation -0.44 0.16 -0.26 children [
      Shape { appearance Appearance { material USE M_Metal }
        geometry Box { size 0.02 0.14 0.02 } } ] }
    Transform { translation -0.36 0.16 -0.26 children [
      Shape { appearance Appearance { material USE M_Metal }
        geometry Box { size 0.02 0.14 0.02 } } ] }
    # Under-cabinet cyan task light
    Transform { translation -0.40 -0.11 -0.42 children [
      Shape { appearance Appearance { material USE M_Cyan }
        geometry Box { size 1.30 0.02 0.04 } } ] }

    # ---------- Back wall panel (L-plane); pass-through cut into the -X (right) wall ----------
    # Back-leg wall: solid full panel
    Transform { translation 0 0.115 -0.635 children [
      Shape {
        appearance Appearance { material DEF M_Wall Material {
          ambientIntensity 0.3 diffuseColor 0.19 0.20 0.24
          specularColor 0.1 0.1 0.12 shininess 0.15 } }
        geometry Box { size 2.68 1.47 0.03 }
      } ] }
    # Right (-X facing) return wall, four segments framing the pass-through
    # opening (Z 0.20..0.85, Y 0.00..0.55). Back of opening:
    Transform { translation 1.335 0.115 -0.21 children [
      Shape { appearance Appearance { material USE M_Wall }
        geometry Box { size 0.03 1.47 0.82 } } ] }
    # Front sliver
    Transform { translation 1.335 0.115 0.875 children [
      Shape { appearance Appearance { material USE M_Wall }
        geometry Box { size 0.03 1.47 0.05 } } ] }
    # Below opening
    Transform { translation 1.335 -0.31 0.525 children [
      Shape { appearance Appearance { material USE M_Wall }
        geometry Box { size 0.03 0.62 0.65 } } ] }
    # Above opening
    Transform { translation 1.335 0.70 0.525 children [
      Shape { appearance Appearance { material USE M_Wall }
        geometry Box { size 0.03 0.30 0.65 } } ] }
    # Pass-through glass pane (tinted, semi-transparent)
    Transform { translation 1.335 0.275 0.525 children [
      Shape {
        appearance Appearance { material DEF M_Glass Material {
          ambientIntensity 0.2 diffuseColor 0.30 0.48 0.52
          specularColor 0.8 0.9 0.9 shininess 0.5 transparency 0.62 } }
        geometry Box { size 0.008 0.55 0.65 }
      } ] }
    # Window frame (brushed metal): sill, head, two jambs, proud of the tile
    Transform { translation 1.285 -0.01 0.525 children [
      Shape { appearance Appearance { material USE M_Metal }
        geometry Box { size 0.06 0.05 0.69 } } ] }
    Transform { translation 1.285 0.57 0.525 children [
      Shape { appearance Appearance { material USE M_Metal }
        geometry Box { size 0.05 0.04 0.69 } } ] }
    Transform { translation 1.285 0.275 0.20 children [
      Shape { appearance Appearance { material USE M_Metal }
        geometry Box { size 0.05 0.57 0.04 } } ] }
    Transform { translation 1.285 0.275 0.85 children [
      Shape { appearance Appearance { material USE M_Metal }
        geometry Box { size 0.05 0.57 0.04 } } ] }
    # Cyan sill accent under the pass-through
    Transform { translation 1.29 0.03 0.525 children [
      Shape { appearance Appearance { material USE M_Cyan }
        geometry Box { size 0.02 0.015 0.65 } } ] }

  ]
}
